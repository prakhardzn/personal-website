---
import InternalPageLayout from
  "../layouts/InternalPageLayout.astro";

import {
  weeklyPosts,
} from "../data/weeklyposts";

import "../styles/weekly.css";
---

<InternalPageLayout
  title="Weekly | Prakhar"
  description="Weekly discoveries, films, ideas and transmissions from Prakhar."
  message="No aliens were harmed while building this page."
  pageClass="weekly-page"
>
  <Fragment slot="sidebar">
    <div class="weekly-sidebar-stack">

      <section class="weekly-title-panel">
        <h1>Heys Weekly</h1>
      </section>

      <section
        class="ui-panel weekly-anchor-panel"
        aria-label="Weekly anchor artwork"
      >
        <div class="weekly-anchor-placeholder">
          Weekly anchor artwork will appear here
        </div>
      </section>

      <section class="ui-panel weekly-schedule-panel">
        Fresh blogs every Friday
      </section>

    </div>
  </Fragment>

  <Fragment slot="content">
    <section class="ui-panel weekly-feed-shell">
      <div class="weekly-feed">

        {
          weeklyPosts.map((post) => (
            <a
              class={`weekly-card weekly-card--${post.variant}`}
              href={`/weekly/${post.slug}`}
              aria-label={`Read ${post.title}`}
            >
              <h2 class="weekly-card__title">
                {post.title}
              </h2>

              <span class="weekly-card__action">
                Read now
              </span>
            </a>
          ))
        }

      </div>
    </section>
  </Fragment>
</InternalPageLayout>
