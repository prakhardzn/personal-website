---
import type {
  MarkdownInstance,
} from "astro";

import InternalPageLayout from
  "../layouts/InternalPageLayout.astro";

import "../styles/weekly.css";


type WeeklyPostFrontmatter = {
  number: string;
  slug: string;
  title: string;
  summary: string;
  category: string;
  date: string;
  readTime: string;
  status: string;
  statusTone?: string;
  variant?: string;
};


const weeklyMarkdownModules =
  import.meta.glob<
    MarkdownInstance<WeeklyPostFrontmatter>
  >(
    "../content/weekly/*.md",
    {
      eager: true,
    }
  );


const posts =
  Object.values(
    weeklyMarkdownModules
  )
    .map(
      (entry) =>
        entry.frontmatter
    )
    .sort(
      (
        first,
        second
      ) =>
        first.number.localeCompare(
          second.number
        )
    );


const baseUrl =
  import.meta.env.BASE_URL;


const buildSiteUrl = (
  path: string
): string => {
  return `${baseUrl}${path.replace(
    /^\/+/,
    ""
  )}`;
};


const cardTones = [
  "primary",
  "mint",
  "lime",
] as const;
---


<InternalPageLayout
  title="News Weekly | Prakhar's Universe"
  description="Weekly stories, discoveries, film notes and transmissions from Prakhar."
  message="No aliens were harmed while building this page."
  pageClass="weekly-page"
>
  <!-- =====================================================
       LEFT COLUMN
  ====================================================== -->

  <div
    slot="sidebar"
    class="weekly-left-column"
  >
    <!-- ===================================================
         NEWS CHANNEL IDENT
    ==================================================== -->

    <section
      class="weekly-news-ident"
      aria-label="News Weekly broadcast channel"
    >
      <header
        class="weekly-news-ident__bar"
      >
        <div>
          <span
            class="weekly-live-dot"
            aria-hidden="true"
          ></span>

          <strong>
            LIVE
          </strong>
        </div>

        <span>
          CHANNEL // 214
        </span>
      </header>


      <div
        class="weekly-news-ident__stage"
        aria-hidden="true"
      >
        <!-- Space / broadcast texture -->

        <span
          class="weekly-ident-stars"
        ></span>

        <span
          class="weekly-ident-scan"
        ></span>


        <!-- Wireframe broadcast globe -->

        <div
          class="weekly-ident-globe"
        >
          <span
            class="weekly-ident-globe__latitude weekly-ident-globe__latitude--one"
          ></span>

          <span
            class="weekly-ident-globe__latitude weekly-ident-globe__latitude--two"
          ></span>

          <span
            class="weekly-ident-globe__longitude weekly-ident-globe__longitude--one"
          ></span>

          <span
            class="weekly-ident-globe__longitude weekly-ident-globe__longitude--two"
          ></span>

          <span
            class="weekly-ident-globe__core"
          ></span>
        </div>


        <!-- Expanding transmission pulses -->

        <span
          class="weekly-ident-pulse weekly-ident-pulse--one"
        ></span>

        <span
          class="weekly-ident-pulse weekly-ident-pulse--two"
        ></span>


        <!-- Channel ident text -->

        <div
          class="weekly-ident-title"
        >
          <span>
            WEEKLY BROADCAST
          </span>

          <strong>
            NEWS WEEKLY
          </strong>

          <p>
            CURRENT TRANSMISSIONS
          </p>
        </div>


        <!-- Decorative targeting corners -->

        <span
          class="weekly-ident-corner weekly-ident-corner--tl"
        ></span>

        <span
          class="weekly-ident-corner weekly-ident-corner--tr"
        ></span>

        <span
          class="weekly-ident-corner weekly-ident-corner--bl"
        ></span>

        <span
          class="weekly-ident-corner weekly-ident-corner--br"
        ></span>


        <!-- Audio / signal indicator -->

        <div
          class="weekly-ident-signal"
        >
          <i></i>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
      </div>


      <!-- =================================================
           NEWS TICKER
      ================================================== -->

      <div
        class="weekly-news-ticker"
      >
        <div
          class="weekly-news-ticker__label"
        >
          LIVE FEED
        </div>

        <div
          class="weekly-news-ticker__window"
        >
          <div
            class="weekly-news-ticker__track"
          >
            <span>
              MOVIE BREAKDOWNS
            </span>

            <i>//</i>

            <span>
              CODING LOGS
            </span>

            <i>//</i>

            <span>
              PERSONAL FILES
            </span>

            <i>//</i>

            <span>
              NEW TRANSMISSIONS EVERY FRIDAY
            </span>

            <i>//</i>

            <span>
              MOVIE BREAKDOWNS
            </span>

            <i>//</i>

            <span>
              CODING LOGS
            </span>

            <i>//</i>

            <span>
              PERSONAL FILES
            </span>

            <i>//</i>

            <span>
              NEW TRANSMISSIONS EVERY FRIDAY
            </span>
          </div>
        </div>
      </div>
    </section>


    <!-- ===================================================
         PUBLICATION CYCLE
    ==================================================== -->

    <section
      class="weekly-schedule-card"
      aria-label="Weekly publication schedule"
    >
      <div
        class="weekly-schedule-card__title"
      >
        <span>
          PUBLICATION CYCLE
        </span>

        <strong>
          FRESH FILES EVERY FRIDAY
        </strong>
      </div>


      <div
        class="weekly-schedule-card__countdown"
      >
        <span>
          NEXT TRANSMISSION
        </span>

        <strong
          id="weekly-countdown"
        >
          CALCULATING
        </strong>
      </div>
    </section>
  </div>


  <!-- =====================================================
       RIGHT COLUMN
  ====================================================== -->

  <div
    slot="content"
    class="weekly-right-column"
  >
    <div
      class="weekly-content-stage"
    >
      <section
        class="weekly-feed-panel"
        id="weekly-feed-panel"
        aria-labelledby="weekly-feed-title"
      >
        <header
          class="weekly-feed-header"
        >
          <p
            class="weekly-feed-header__eyebrow"
          >
            <span
              class="weekly-status-dot"
              aria-hidden="true"
            ></span>

            CURRENT TRANSMISSIONS
          </p>


          <h1
            id="weekly-feed-title"
          >
            Weekly Files
          </h1>


          <p
            class="weekly-feed-header__description"
          >
            Select a file to read the complete transmission.
          </p>
        </header>


        <div
          class="weekly-card-list"
        >
          {
            posts.map(
              (
                post,
                index
              ) => {
                const tone =
                  cardTones[
                    index %
                    cardTones.length
                  ];

                return (
                  <a
                    class:list={[
                      "weekly-post-card",
                      `weekly-post-card--${tone}`,
                    ]}
                    href={buildSiteUrl(
                      `/weekly/${post.slug}`
                    )}
                    style={`--card-delay: ${index * 70}ms;`}
                  >
                    <div
                      class="weekly-post-card__top"
                    >
                      <span>
                        {post.number}
                      </span>


                      <span
                        class:list={[
                          "weekly-card-status",
                          post.statusTone &&
                            `weekly-card-status--${post.statusTone}`,
                        ]}
                      >
                        <i
                          aria-hidden="true"
                        ></i>

                        <strong>
                          {post.status}
                        </strong>
                      </span>
                    </div>


                    <h2>
                      {post.title}
                    </h2>


                    <p
                      class="weekly-post-card__category"
                    >
                      {post.category}
                    </p>


                    <p
                      class="weekly-post-card__description"
                    >
                      {post.summary}
                    </p>


                    <div
                      class="weekly-post-card__footer"
                    >
                      <span>
                        PUBLISHED {post.date} // {post.readTime}
                      </span>

                      <strong>
                        OPEN TRANSMISSION
                      </strong>
                    </div>
                  </a>
                );
              }
            )
          }
        </div>
      </section>


      <div
        class="weekly-scrollbar"
        id="weekly-scrollbar"
        aria-hidden="true"
      >
        <div
          class="weekly-scrollbar__thumb"
          id="weekly-scrollbar-thumb"
        ></div>
      </div>
    </div>
  </div>
</InternalPageLayout>


<script>
  type WeeklyRuntimeWindow =
    Window & {
      __weeklyPageController?:
        AbortController;

      __weeklyPageResizeObserver?:
        ResizeObserver;
    };


  const weeklyRuntimeWindow =
    window as WeeklyRuntimeWindow;


  function updateWeeklyCountdown(): void {
    const countdown =
      document.querySelector<HTMLElement>(
        "#weekly-countdown"
      );

    if (!countdown) {
      return;
    }


    const now =
      new Date();

    const currentDay =
      now.getDay();

    const friday =
      5;


    const daysUntilFriday =
      (
        friday -
        currentDay +
        7
      ) %
      7;


    if (
      daysUntilFriday ===
      0
    ) {
      countdown.textContent =
        "TODAY";

      return;
    }


    if (
      daysUntilFriday ===
      1
    ) {
      countdown.textContent =
        "1 DAY";

      return;
    }


    countdown.textContent =
      `${daysUntilFriday} DAYS`;
  }


  function initialiseWeeklyPage(): void {
    weeklyRuntimeWindow
      .__weeklyPageController
      ?.abort();

    weeklyRuntimeWindow
      .__weeklyPageResizeObserver
      ?.disconnect();


    const controller =
      new AbortController();

    weeklyRuntimeWindow
      .__weeklyPageController =
      controller;


    const signal =
      controller.signal;


    updateWeeklyCountdown();


    const contentWindow =
      document.querySelector<HTMLElement>(
        "#weekly-feed-panel"
      );

    const scrollbar =
      document.querySelector<HTMLElement>(
        "#weekly-scrollbar"
      );

    const scrollbarThumb =
      document.querySelector<HTMLElement>(
        "#weekly-scrollbar-thumb"
      );


    if (
      !contentWindow ||
      !scrollbar ||
      !scrollbarThumb
    ) {
      return;
    }


    const getScrollbarMetrics = () => {
      const styles =
        window.getComputedStyle(
          scrollbar
        );

      const paddingTop =
        Number.parseFloat(
          styles.paddingTop
        ) || 0;

      const paddingBottom =
        Number.parseFloat(
          styles.paddingBottom
        ) || 0;

      const trackHeight =
        Math.max(
          0,
          scrollbar.clientHeight -
            paddingTop -
            paddingBottom
        );

      const maximumScroll =
        Math.max(
          0,
          contentWindow.scrollHeight -
            contentWindow.clientHeight
        );

      const visibleRatio =
        contentWindow.scrollHeight >
        0
          ? contentWindow.clientHeight /
            contentWindow.scrollHeight
          : 1;

      const thumbHeight =
        Math.min(
          trackHeight,
          Math.max(
            46,
            trackHeight *
              visibleRatio
          )
        );

      const movementDistance =
        Math.max(
          0,
          trackHeight -
            thumbHeight
        );

      return {
        paddingTop,
        trackHeight,
        maximumScroll,
        thumbHeight,
        movementDistance,
      };
    };


    const updateScrollbar =
      (): void => {
        const {
          maximumScroll,
          thumbHeight,
          movementDistance,
        } =
          getScrollbarMetrics();


        const scrollProgress =
          maximumScroll >
          0
            ? contentWindow.scrollTop /
              maximumScroll
            : 0;


        scrollbarThumb.style.height =
          `${thumbHeight}px`;


        scrollbarThumb.style.transform =
          `translateY(${
            scrollProgress *
            movementDistance
          }px)`;


        scrollbar.classList.toggle(
          "is-static",
          maximumScroll ===
            0
        );
      };


    contentWindow.addEventListener(
      "scroll",
      updateScrollbar,
      {
        passive: true,
        signal,
      }
    );


    scrollbar.addEventListener(
      "wheel",
      (
        event:
          WheelEvent
      ): void => {
        const {
          maximumScroll,
        } =
          getScrollbarMetrics();

        if (
          maximumScroll ===
          0
        ) {
          return;
        }

        event.preventDefault();

        contentWindow.scrollTop +=
          event.deltaY;
      },
      {
        passive: false,
        signal,
      }
    );


    scrollbar.addEventListener(
      "click",
      (
        event:
          MouseEvent
      ): void => {
        if (
          event.target ===
          scrollbarThumb
        ) {
          return;
        }

        const {
          paddingTop,
          maximumScroll,
          thumbHeight,
          movementDistance,
        } =
          getScrollbarMetrics();

        if (
          maximumScroll ===
            0 ||
          movementDistance ===
            0
        ) {
          return;
        }

        const bounds =
          scrollbar.getBoundingClientRect();

        const pointerPosition =
          event.clientY -
          bounds.top -
          paddingTop -
          thumbHeight /
            2;

        const thumbPosition =
          Math.max(
            0,
            Math.min(
              movementDistance,
              pointerPosition
            )
          );

        contentWindow.scrollTop =
          (
            thumbPosition /
            movementDistance
          ) *
          maximumScroll;
      },
      {
        signal,
      }
    );


    let isDragging =
      false;

    let dragStartY =
      0;

    let dragStartScroll =
      0;


    scrollbarThumb.addEventListener(
      "pointerdown",
      (
        event:
          PointerEvent
      ): void => {
        const {
          maximumScroll,
        } =
          getScrollbarMetrics();

        if (
          maximumScroll ===
          0
        ) {
          return;
        }

        isDragging =
          true;

        dragStartY =
          event.clientY;

        dragStartScroll =
          contentWindow.scrollTop;

        scrollbarThumb.setPointerCapture(
          event.pointerId
        );

        scrollbarThumb.classList.add(
          "is-dragging"
        );

        event.preventDefault();
      },
      {
        signal,
      }
    );


    scrollbarThumb.addEventListener(
      "pointermove",
      (
        event:
          PointerEvent
      ): void => {
        if (
          !isDragging
        ) {
          return;
        }

        const {
          maximumScroll,
          movementDistance,
        } =
          getScrollbarMetrics();

        if (
          maximumScroll ===
            0 ||
          movementDistance ===
            0
        ) {
          return;
        }

        const pointerMovement =
          event.clientY -
          dragStartY;

        contentWindow.scrollTop =
          dragStartScroll +
          (
            pointerMovement /
            movementDistance
          ) *
          maximumScroll;
      },
      {
        signal,
      }
    );


    const stopDragging =
      (
        event?:
          PointerEvent
      ): void => {
        if (
          !isDragging
        ) {
          return;
        }

        isDragging =
          false;

        scrollbarThumb.classList.remove(
          "is-dragging"
        );

        if (
          event &&
          scrollbarThumb.hasPointerCapture(
            event.pointerId
          )
        ) {
          scrollbarThumb.releasePointerCapture(
            event.pointerId
          );
        }
      };


    scrollbarThumb.addEventListener(
      "pointerup",
      stopDragging,
      {
        signal,
      }
    );

    scrollbarThumb.addEventListener(
      "pointercancel",
      stopDragging,
      {
        signal,
      }
    );


    window.addEventListener(
      "resize",
      updateScrollbar,
      {
        signal,
      }
    );


    const resizeObserver =
      new ResizeObserver(
        updateScrollbar
      );


    resizeObserver.observe(
      contentWindow
    );

    resizeObserver.observe(
      scrollbar
    );


    weeklyRuntimeWindow
      .__weeklyPageResizeObserver =
      resizeObserver;


    window.requestAnimationFrame(
      updateScrollbar
    );
  }


  initialiseWeeklyPage();


  document.addEventListener(
    "astro:page-load",
    initialiseWeeklyPage
  );
</script>