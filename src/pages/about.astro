---
import InternalPageLayout from "../layouts/InternalPageLayout.astro";
import { getCollection } from "astro:content";
import "../styles/about.css";
import "../styles/about-vault.css";
import "../styles/about-interests.css";

/* ==================================================
   WORK PROJECTS
   Loaded entirely from Markdown:
   src/content/work/*.md
=================================================== */

const workEntries = await getCollection("work");

const projectFiles = workEntries
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const baseUrl = import.meta.env.BASE_URL;

const buildSiteUrl = (path: string): string =>
  `${baseUrl}${path.replace(/^\/+/, "")}`;

const vaultUrl = buildSiteUrl("vault");

---

<InternalPageLayout
  title="About Me | Prakhar's Universe"
  description="Learn about Prakhar Pandey and explore his creative work."
  message="You are currently somewhere between a portfolio and a minor space incident."
  pageClass="about-page"
>
  <!-- ==================================================
       LEFT COLUMN
  =================================================== -->

  <div slot="sidebar" class="about-left-column">
    <figure class="about-photo-frame">
      <img
        class="about-photo"
        id="about-photo"
        src="/assets/about/about-photo.png"
        alt="Portrait of Prakhar Pandey"
        draggable="false"
        loading="eager"
      />

      <div
        class="about-photo-fallback"
        id="about-photo-fallback"
        hidden
      >
        <strong>PORTRAIT FILE MISSING</strong>

        <span>
          Add about-photo.png inside public/assets/about
        </span>
      </div>
    </figure>

    <section class="about-profile-card">
      <!-- Main profile -->

      <div
        class="about-profile-panel"
        data-profile-panel="about"
      >
        <div class="about-profile-terminal">
          <header class="about-profile-terminal__header">
            <span class="about-profile-terminal__title">
              USER PROFILE // LOCAL RECORD

              <span
                class="terminal-caret"
                aria-hidden="true"
              >
                ▮
              </span>
            </span>

            <span class="about-profile-terminal__status">
              <span
                class="terminal-status-dot"
                aria-hidden="true"
              ></span>

              ONLINE · ID: P-01
            </span>
          </header>

          <div class="about-profile-grid">
            <div class="about-profile-cell about-profile-cell--label">
              NAME
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              PRAKHAR
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--psychic">
                <span>TYPE</span>
                <strong>PSYCHIC</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              PRONOUNS
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              HE/HIM
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--enfp">
                <span>MBTI</span>
                <strong>ENFP</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              BDAY
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              01/11
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--scorpio">
                <span>SIGN</span>
                <strong>SCORPIO</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              LOCATION
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              INDIA
            </div>

            <div
              class="about-profile-cell about-profile-cell--badge"
              aria-hidden="true"
            ></div>

            <div class="about-profile-cell about-profile-cell--label">
              STRENGTH
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              CAN CRACK JOKES!!!
            </div>

            <div
              class="about-profile-cell about-profile-cell--badge"
              aria-hidden="true"
            ></div>

            <div class="about-profile-cell about-profile-cell--label">
              WEAKNESS
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              SWEETS, CATS, BED, BRAINFOG
            </div>

            <div
              class="about-profile-cell about-profile-cell--badge"
              aria-hidden="true"
            ></div>
          </div>
        </div>
      </div>

      <!-- Work information -->

      <div
        class="about-profile-panel about-profile-panel--section"
        data-profile-panel="work"
        hidden
      >
        <p class="about-panel-eyebrow">
          PORTFOLIO SECTION
        </p>

        <h2>Project Archive</h2>

        <p class="about-profile-description">
          Browse film, photography, typography and motion-design
          projects stored inside the portfolio archive.
        </p>

        <dl class="about-section-details">
          <div>
            <dt>FILES</dt>
            <dd>Film, design and photography</dd>
          </div>

          <div>
            <dt>ACCESS</dt>
            <dd>Public archive</dd>
          </div>

          <div>
            <dt>STATUS</dt>
            <dd>Continuously expanding</dd>
          </div>
        </dl>
      </div>

      <!-- Interests information -->

      <div
        class="about-profile-panel about-profile-panel--section"
        data-profile-panel="interests"
        hidden
      >
        <p class="about-panel-eyebrow">
          INTEREST DATABASE
        </p>

        <h2>Current Obsessions</h2>

        <p class="about-profile-description">
          Subjects that repeatedly steal my attention and
          occasionally become entire projects.
        </p>

        <dl class="about-section-details">
          <div>
            <dt>SIGNAL</dt>
            <dd>Visual storytelling</dd>
          </div>

          <div>
            <dt>FREQUENCY</dt>
            <dd>Constant</dd>
          </div>

          <div>
            <dt>CONTROL</dt>
            <dd>Questionable</dd>
          </div>
        </dl>
      </div>

      <!-- Vault information -->

      <div
        class="about-profile-panel about-profile-panel--section"
        data-profile-panel="vault"
        hidden
      >
        <p class="about-panel-eyebrow">
          RESTRICTED SECTION
        </p>

        <h2>The Vault</h2>

        <p class="about-profile-description">
          A visual hoard of images, references, interfaces, film frames
          and other things I found too interesting to lose.
        </p>

        <dl class="about-section-details">
          <div>
            <dt>SECURITY</dt>
            <dd>Needlessly excessive</dd>
          </div>

          <div>
            <dt>CONTENT</dt>
            <dd>Recovered objects</dd>
          </div>

          <div>
            <dt>ACCESS</dt>
            <dd>Turn the lock</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  <!-- ==================================================
       RIGHT COLUMN
  =================================================== -->

  <div slot="content" class="about-right-column">
    <nav
      class="about-tabs"
      aria-label="About page sections"
    >
      <button
        class="about-tab is-active"
        type="button"
        data-about-tab="about"
        aria-selected="true"
      >
        ABOUT
      </button>

      <button
        class="about-tab"
        type="button"
        data-about-tab="work"
        aria-selected="false"
      >
        WORK
      </button>

      <button
        class="about-tab"
        type="button"
        data-about-tab="interests"
        aria-selected="false"
      >
        INTERESTS
      </button>

      <button
        class="about-tab"
        type="button"
        data-about-tab="vault"
        aria-selected="false"
      >
        VAULT
      </button>
    </nav>

    <div class="about-content-stage">
      <div
        class="about-content-window"
        id="about-content-window"
      >
        <!-- About -->

        <section
          class="about-content-panel about-content-panel--biography"
          data-about-panel="about"
        >
          <div class="about-biography">
            <p>
              Hi, I’m Prakhar. I’m a multimedia design student,
              filmmaker, photographer and occasional victim of CSS.
            </p>

            <p>
              Most of my time goes into making films, taking
              photographs, designing strange little websites and
              convincing myself that every new project is not
              another side quest. I like stories that feel slightly
              unsettling, visually interesting and human enough to
              stay with you after the screen goes dark.
            </p>

            <p>
              I have written and directed short films, worked behind
              the camera, explored streets with a camera in hand and
              spent an unreasonable amount of time moving elements
              two pixels to the left.
            </p>

            <p>
              This website is my inventory. It contains films,
              photographs, experiments, unfinished thoughts and a
              few projects that survived the final boss known as the
              deadline.
            </p>
          </div>

          <footer class="about-contact">
            <span>CONTACT</span>

            <a href="mailto:prakharpandey2027@gmail.com">
              prakharpandey2027@gmail.com
            </a>
          </footer>
        </section>

        <!-- Work -->

        <section
          class="about-content-panel"
          data-about-panel="work"
          hidden
        >
          <header class="about-content-header">
            <p>PORTFOLIO ARCHIVE</p>

            <h1>Project Files</h1>

            <span>
              Select a file to investigate the project.
            </span>
          </header>

          <div class="about-file-list">
            {
              projectFiles.map((project, index) => (
                <a
                  class="about-file-card about-file-card--project-link"
                  href={buildSiteUrl(`work/${project.id}`)}
                  style={`--project-delay: ${index * 70}ms;`}
                  aria-label={`Open ${project.data.title} project file`}
                >
                  <div class="about-file-card__top">
                    <span>{project.data.number}</span>

                    <div
                      class:list={[
                        "about-project-status",
                        project.data.statusType === "working" &&
                          "about-project-status--working",
                      ]}
                    >
                      <span
                        class="about-project-status__dot"
                        aria-hidden="true"
                      ></span>

                      <strong>{project.data.status}</strong>
                    </div>
                  </div>

                  <h2>{project.data.title}</h2>

                  <p class="about-file-card__metadata">
                    {project.data.metadata}
                  </p>

                  <p class="about-file-card__description">
                    {project.data.description}
                  </p>

                  <span class="about-file-card__link">
                    OPEN FILE
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <!-- Interests -->

        <section
          class="about-content-panel about-content-panel--interests"
          data-about-panel="interests"
          hidden
        >
          <div class="interest-network" data-interest-network>
            <header class="interest-network__header">
              <div>
                <p>ACTIVE SIGNALS // P-01</p>
                <h1>Interest Network</h1>
              </div>

              <span>
                <i aria-hidden="true"></i>
                04 CHANNELS ONLINE
              </span>
            </header>

            <div
              class="interest-network__stage"
              data-interest-stage
              aria-label="Interactive map of Prakhar's interests"
            >
              <svg
                class="interest-network__connectors"
                viewBox="0 0 1000 620"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <line class="interest-connector interest-connector--film" x1="500" y1="310" x2="205" y2="310" />
                <line class="interest-connector interest-connector--photo" x1="500" y1="310" x2="500" y2="95" />
                <line class="interest-connector interest-connector--theatre" x1="500" y1="310" x2="500" y2="525" />
                <line class="interest-connector interest-connector--music" x1="500" y1="310" x2="795" y2="310" />

                <circle class="interest-packet interest-packet--film" cx="500" cy="310" r="4" />
                <circle class="interest-packet interest-packet--photo" cx="500" cy="310" r="4" />
                <circle class="interest-packet interest-packet--theatre" cx="500" cy="310" r="4" />
                <circle class="interest-packet interest-packet--music" cx="500" cy="310" r="4" />
              </svg>

              <div class="interest-core" data-interest-core>
                <span class="interest-core__orbit interest-core__orbit--outer" aria-hidden="true"></span>
                <span class="interest-core__orbit interest-core__orbit--inner" aria-hidden="true"></span>
                <span class="interest-core__pulse" aria-hidden="true"></span>

                <span class="interest-core__eyebrow">P-01</span>
                <strong>INTEREST<br />NETWORK</strong>
                <small data-interest-readout>
                  MOVE CURSOR TO ACQUIRE SIGNAL
                </small>
              </div>

              <button
                class="interest-signal interest-signal--filmmaking"
                type="button"
                data-interest-signal="filmmaking"
                aria-controls="interest-detail-filmmaking"
              >
                <span class="interest-signal__index">SIG.01</span>

                <span class="interest-signal__icon interest-icon interest-icon--film" aria-hidden="true">
                  <svg viewBox="0 0 96 96" focusable="false">
                    <rect x="14" y="20" width="68" height="54" rx="2"></rect>
                    <path d="M24 30h12M24 30v12M72 30H60M72 30v12M24 64h12M24 64V52M72 64H60M72 64V52"></path>
                    <path class="interest-icon__film-play" d="M43 40l16 9-16 9z"></path>
                    <circle class="interest-icon__film-rec" cx="72" cy="20" r="4"></circle>
                    <path class="interest-icon__film-scan" d="M20 48h56"></path>
                  </svg>
                </span>

                <span class="interest-signal__copy">
                  <strong>FILMMAKING</strong>
                  <small>VISUAL NARRATIVE</small>
                </span>
              </button>

              <button
                class="interest-signal interest-signal--photography"
                type="button"
                data-interest-signal="photography"
                aria-controls="interest-detail-photography"
              >
                <span class="interest-signal__index">SIG.02</span>

                <span class="interest-signal__icon interest-icon interest-icon--photo" aria-hidden="true">
                  <svg viewBox="0 0 96 96" focusable="false">
                    <circle cx="48" cy="48" r="31"></circle>
                    <circle class="interest-icon__photo-ring" cx="48" cy="48" r="21"></circle>
                    <path class="interest-icon__aperture interest-icon__aperture--1" d="M48 27l11 10-4 14-15-2z"></path>
                    <path class="interest-icon__aperture interest-icon__aperture--2" d="M69 44l-4 14-15 2-3-15 11-9z"></path>
                    <path class="interest-icon__aperture interest-icon__aperture--3" d="M57 67l-15 2-8-12 10-11 14 6z"></path>
                    <path class="interest-icon__aperture interest-icon__aperture--4" d="M31 60l-4-14 11-10 11 10-7 14z"></path>
                    <path class="interest-icon__photo-flash" d="M21 48h54"></path>
                  </svg>
                </span>

                <span class="interest-signal__copy">
                  <strong>PHOTOGRAPHY</strong>
                  <small>FIELD OBSERVATION</small>
                </span>
              </button>

              <button
                class="interest-signal interest-signal--theatre"
                type="button"
                data-interest-signal="theatre"
                aria-controls="interest-detail-theatre"
              >
                <span class="interest-signal__index">SIG.03</span>

                <span class="interest-signal__icon interest-icon interest-icon--theatre" aria-hidden="true">
                  <svg viewBox="0 0 96 96" focusable="false">
                    <path class="interest-icon__spot-fixture" d="M26 21h29l7 13H34z"></path>
                    <path class="interest-icon__spot-arm" d="M26 27l-10-8M55 27l10-8"></path>
                    <path class="interest-icon__spot-beam" d="M35 35l-17 42h60L55 35z"></path>
                    <circle class="interest-icon__stage-head" cx="48" cy="57" r="5"></circle>
                    <path class="interest-icon__stage-body" d="M48 62v11M40 69l8-4 8 4"></path>
                    <path d="M18 77h60"></path>
                  </svg>
                </span>

                <span class="interest-signal__copy">
                  <strong>THEATRE</strong>
                  <small>LIVE PERFORMANCE</small>
                </span>
              </button>

              <button
                class="interest-signal interest-signal--music"
                type="button"
                data-interest-signal="music"
                aria-controls="interest-detail-music"
              >
                <span class="interest-signal__index">SIG.04</span>

                <span class="interest-signal__icon interest-icon interest-icon--music" aria-hidden="true">
                  <svg viewBox="0 0 96 96" focusable="false">
                    <path class="interest-icon__wave" d="M12 50c7 0 7-18 14-18s7 32 14 32 7-45 14-45 7 58 14 58 7-27 16-27"></path>
                    <path class="interest-icon__music-grid" d="M14 23v54M30 23v54M46 23v54M62 23v54M78 23v54"></path>
                    <rect class="interest-icon__bar interest-icon__bar--1" x="18" y="48" width="6" height="22"></rect>
                    <rect class="interest-icon__bar interest-icon__bar--2" x="34" y="36" width="6" height="34"></rect>
                    <rect class="interest-icon__bar interest-icon__bar--3" x="50" y="43" width="6" height="27"></rect>
                    <rect class="interest-icon__bar interest-icon__bar--4" x="66" y="30" width="6" height="40"></rect>
                  </svg>
                </span>

                <span class="interest-signal__copy">
                  <strong>MUSIC</strong>
                  <small>AUDIO FREQUENCY</small>
                </span>
              </button>

              <div class="interest-network__coordinates" aria-hidden="true">
                <span>X: 214.04</span>
                <span>Y: P-01</span>
                <span>STATUS: LISTENING</span>
              </div>
            </div>

            <div class="interest-network__detail" data-interest-detail-shell hidden>
              <header class="interest-detail__header">
                <div>
                  <span data-interest-detail-signal>SIG.01 // ACQUIRED</span>
                  <h2 data-interest-detail-title>FILMMAKING</h2>
                </div>

                <button
                  class="interest-detail__back"
                  type="button"
                  data-interest-back
                >
                  ← RETURN TO NETWORK
                </button>
              </header>

              <section
                class="interest-detail-panel"
                id="interest-detail-filmmaking"
                data-interest-detail="filmmaking"
                hidden
              >
                <div class="interest-detail-visual interest-detail-visual--film" aria-hidden="true">
                  <span></span><span></span><span></span><span></span><span></span>
                  <strong>REC</strong>
                </div>

                <p>
                  Filmmaking is the interest that somehow manages to absorb most of the others. Writing, directing, cinematography, editing, sound — I like the whole messy process of turning an idea into something people can actually watch.
                </p>

                <div class="interest-detail-tags">
                  <span>DIRECTING</span>
                  <span>CINEMATOGRAPHY</span>
                  <span>EDITING</span>
                  <span>SOUND</span>
                </div>
              </section>

              <section
                class="interest-detail-panel"
                id="interest-detail-photography"
                data-interest-detail="photography"
                hidden
              >
                <div class="interest-detail-visual interest-detail-visual--photo" aria-hidden="true">
                  <span class="interest-detail-aperture"></span>
                  <i></i><i></i><i></i><i></i>
                </div>

                <p>
                  I like photographs where it feels like something happened half a second before I arrived. Streets, people, odd details, strange light and those moments nobody seems to notice until a camera freezes them.
                </p>

                <div class="interest-detail-tags">
                  <span>STREET</span>
                  <span>PEOPLE</span>
                  <span>LIGHT</span>
                  <span>OBSERVATION</span>
                </div>
              </section>

              <section
                class="interest-detail-panel"
                id="interest-detail-theatre"
                data-interest-detail="theatre"
                hidden
              >
                <div class="interest-detail-visual interest-detail-visual--theatre" aria-hidden="true">
                  <span class="interest-detail-spotlight"></span>
                  <i></i>
                </div>

                <p>
                  Theatre is probably where a lot of my obsession with performance came from. Characters, movement, timing, people pretending to be someone else in a room full of people who have agreed to believe them.
                </p>

                <div class="interest-detail-tags">
                  <span>PERFORMANCE</span>
                  <span>CHARACTERS</span>
                  <span>STAGING</span>
                  <span>TIMING</span>
                </div>
              </section>

              <section
                class="interest-detail-panel"
                id="interest-detail-music"
                data-interest-detail="music"
                hidden
              >
                <div class="interest-detail-visual interest-detail-visual--music" aria-hidden="true">
                  <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                </div>

                <p>
                  Music is almost always playing somewhere around me — while working, walking, editing or because apparently silence lasted too long. I am especially drawn to film scores, game soundtracks and songs that completely change the mood of a space.
                </p>

                <div class="interest-detail-tags">
                  <span>FILM SCORES</span>
                  <span>GAME OSTs</span>
                  <span>INDIE / ALT</span>
                  <span>RANDOM FINDS</span>
                </div>
              </section>
            </div>
          </div>
        </section>

        <!-- Vault -->

        <section
          class="about-content-panel about-content-panel--vault"
          data-about-panel="vault"
          hidden
        >
          <div class="vault-entry">
            <header class="vault-entry__header">
              <div>
                <p>RESTRICTED ARCHIVE // P-214</p>
                <h1>THE VAULT</h1>
              </div>

              <span data-vault-status>SECURITY STATE // LOCKED</span>
            </header>

            <div class="vault-entry__chamber" data-vault-machine>
              <div class="vault-entry__ambient" aria-hidden="true"></div>

              <div class="vault-entry__door-zone">
                <a
                  class="vault-door-trigger"
                  href={vaultUrl}
                  data-vault-open
                  aria-label="Unlock and enter the Vault"
                >
                  <span class="vault-door" aria-hidden="true">
                    <span class="vault-door__outer-teeth"></span>
                    <span class="vault-door__rim vault-door__rim--outer"></span>
                    <span class="vault-door__rim vault-door__rim--middle"></span>
                    <span class="vault-door__rim vault-door__rim--inner"></span>
                    <span class="vault-door__scanner"></span>

                    <span class="vault-door__bolt vault-door__bolt--top"></span>
                    <span class="vault-door__bolt vault-door__bolt--right"></span>
                    <span class="vault-door__bolt vault-door__bolt--bottom"></span>
                    <span class="vault-door__bolt vault-door__bolt--left"></span>

                    <span class="vault-door__wheel">
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                      <i></i>
                      <b>214</b>
                    </span>

                    <span class="vault-door__hinge vault-door__hinge--top"></span>
                    <span class="vault-door__hinge vault-door__hinge--bottom"></span>

                    <span class="vault-door__label">CONTAINMENT UNIT // 214</span>
                  </span>

                  <span class="vault-door-trigger__copy">
                    <strong>&gt; OPEN VAULT</strong>
                    <small data-vault-command>
                      CLICK TO REQUEST ACCESS
                    </small>
                  </span>
                </a>
              </div>

              <div class="vault-entry__telemetry">
                <span>LOCKS // <strong data-vault-locks>04 ENGAGED</strong></span>
                <span>CONTENTS // UNCLASSIFIED</span>
                <span data-vault-readout>DOOR // SEALED</span>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div
        class="about-scrollbar"
        id="about-scrollbar"
        aria-hidden="true"
      >
        <div
          class="about-scrollbar__thumb"
          id="about-scrollbar-thumb"
        ></div>
      </div>
    </div>
  </div>
</InternalPageLayout>

<script>
  const validAboutTabs = [
    "about",
    "work",
    "interests",
    "vault",
  ] as const;

  type AboutTab =
    (typeof validAboutTabs)[number];

  type AboutRuntimeWindow = Window & {
    __aboutPageController?: AbortController;
    __aboutPageResizeObserver?: ResizeObserver;
  };

  const aboutRuntimeWindow =
    window as AboutRuntimeWindow;

  const isAboutTab = (
    value: string
  ): value is AboutTab =>
    validAboutTabs.includes(
      value as AboutTab
    );

  function initialiseAboutPage(): void {
    /*
     * Astro's ClientRouter keeps JavaScript modules alive between
     * navigations. Any listeners attached to the old About DOM can
     * therefore become stale. Clear the old runtime first, then query
     * the current page again.
     */
    aboutRuntimeWindow.__aboutPageController?.abort();
    aboutRuntimeWindow.__aboutPageResizeObserver?.disconnect();

    const tabButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          ".about-page [data-about-tab]"
        )
      );

    if (tabButtons.length === 0) {
      return;
    }

    const controller =
      new AbortController();

    const { signal } = controller;

    aboutRuntimeWindow.__aboutPageController =
      controller;

    const contentPanels =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".about-page [data-about-panel]"
        )
      );

    const profilePanels =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".about-page [data-profile-panel]"
        )
      );

    const contentWindow =
      document.querySelector<HTMLElement>(
        "#about-content-window"
      );

    const scrollbar =
      document.querySelector<HTMLElement>(
        "#about-scrollbar"
      );

    const scrollbarThumb =
      document.querySelector<HTMLElement>(
        "#about-scrollbar-thumb"
      );

    const aboutPhoto =
      document.querySelector<HTMLImageElement>(
        "#about-photo"
      );

    const photoFallback =
      document.querySelector<HTMLElement>(
        "#about-photo-fallback"
      );

    const restartEntryAnimation = (
      element: HTMLElement | undefined
    ): void => {
      if (!element) {
        return;
      }

      element.classList.remove("is-entering");
      void element.offsetWidth;
      element.classList.add("is-entering");
    };

    const updateScrollbar = (): void => {
      if (
        !contentWindow ||
        !scrollbar ||
        !scrollbarThumb
      ) {
        return;
      }

      const usableTrackHeight =
        Math.max(
          0,
          scrollbar.clientHeight - 10
        );

      const maximumScroll =
        Math.max(
          0,
          contentWindow.scrollHeight -
            contentWindow.clientHeight
        );

      const visibleRatio =
        contentWindow.scrollHeight > 0
          ? contentWindow.clientHeight /
            contentWindow.scrollHeight
          : 1;

      const thumbHeight =
        Math.min(
          usableTrackHeight,
          Math.max(
            48,
            usableTrackHeight * visibleRatio
          )
        );

      const movementRange =
        Math.max(
          0,
          usableTrackHeight - thumbHeight
        );

      const scrollProgress =
        maximumScroll > 0
          ? contentWindow.scrollTop /
            maximumScroll
          : 0;

      scrollbarThumb.style.height =
        `${thumbHeight}px`;

      scrollbarThumb.style.transform =
        `translateY(${scrollProgress * movementRange}px)`;
    };

    const activateAboutTab = (
      tabName: AboutTab,
      updateHash = true
    ): void => {
      let activeContentPanel:
        HTMLElement | undefined;

      let activeProfilePanel:
        HTMLElement | undefined;

      tabButtons.forEach((button) => {
        const isActive =
          button.dataset.aboutTab === tabName;

        button.classList.toggle(
          "is-active",
          isActive
        );

        button.setAttribute(
          "aria-selected",
          String(isActive)
        );
      });

      contentPanels.forEach((panel) => {
        const isActive =
          panel.dataset.aboutPanel === tabName;

        panel.hidden = !isActive;

        if (isActive) {
          activeContentPanel = panel;
        }
      });

      profilePanels.forEach((panel) => {
        const isActive =
          panel.dataset.profilePanel === tabName;

        panel.hidden = !isActive;

        if (isActive) {
          activeProfilePanel = panel;
        }
      });

      if (contentWindow) {
        contentWindow.scrollTop = 0;
      }

      if (tabName !== "interests") {
        const interestDetailShell =
          document.querySelector<HTMLElement>(
            ".about-page [data-interest-detail-shell]"
          );

        const interestStage =
          document.querySelector<HTMLElement>(
            ".about-page [data-interest-stage]"
          );

        const interestNetwork =
          document.querySelector<HTMLElement>(
            ".about-page [data-interest-network]"
          );

        if (interestDetailShell) {
          interestDetailShell.hidden = true;
        }

        interestStage?.removeAttribute("hidden");
        interestNetwork?.classList.remove(
          "is-inspecting",
          "is-tuning"
        );
      }

      if (updateHash) {
        window.history.replaceState(
          null,
          "",
          `${window.location.pathname}${window.location.search}#${tabName}`
        );
      }

      restartEntryAnimation(
        activeContentPanel
      );

      restartEntryAnimation(
        activeProfilePanel
      );

      window.requestAnimationFrame(
        updateScrollbar
      );
    };

    tabButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const requestedTab =
            button.dataset.aboutTab;

          if (
            requestedTab &&
            isAboutTab(requestedTab)
          ) {
            activateAboutTab(
              requestedTab
            );
          }
        },
        { signal }
      );
    });

    const interestNetwork =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-network]"
      );

    const interestStage =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-stage]"
      );

    const interestCore =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-core]"
      );

    const interestReadout =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-readout]"
      );

    const interestButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          ".about-page [data-interest-signal]"
        )
      );

    const interestDetailShell =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-detail-shell]"
      );

    const interestDetailPanels =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".about-page [data-interest-detail]"
        )
      );

    const interestDetailTitle =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-detail-title]"
      );

    const interestDetailSignal =
      document.querySelector<HTMLElement>(
        ".about-page [data-interest-detail-signal]"
      );

    const interestBackButton =
      document.querySelector<HTMLButtonElement>(
        ".about-page [data-interest-back]"
      );

    const interestMeta: Record<
      string,
      { title: string; signal: string; hover: string }
    > = {
      filmmaking: {
        title: "FILMMAKING",
        signal: "SIG.01 // ACQUIRED",
        hover: "> VISUAL FEED ACQUIRED // REC ACTIVE",
      },
      photography: {
        title: "PHOTOGRAPHY",
        signal: "SIG.02 // ACQUIRED",
        hover: "> OPTICAL SIGNAL ACQUIRED // APERTURE OPEN",
      },
      theatre: {
        title: "THEATRE",
        signal: "SIG.03 // ACQUIRED",
        hover: "> LIVE SIGNAL DETECTED // STAGE ACTIVE",
      },
      music: {
        title: "MUSIC",
        signal: "SIG.04 // ACQUIRED",
        hover: "> AUDIO SIGNAL LOCKED // PLAYBACK ACTIVE",
      },
    };

    const clearInterestHover = (): void => {
      interestButtons.forEach((button) => {
        button.classList.remove("is-muted");
        button.classList.remove("is-hovered");
      });

      if (interestReadout) {
        interestReadout.textContent =
          "MOVE CURSOR TO ACQUIRE SIGNAL";
      }
    };

    const previewInterest = (
      selectedButton: HTMLButtonElement
    ): void => {
      const key =
        selectedButton.dataset.interestSignal;

      if (!key || !interestMeta[key]) {
        return;
      }

      interestButtons.forEach((button) => {
        const selected = button === selectedButton;
        button.classList.toggle(
          "is-hovered",
          selected
        );
        button.classList.toggle(
          "is-muted",
          !selected
        );
      });

      if (interestReadout) {
        interestReadout.textContent =
          interestMeta[key].hover;
      }
    };

    const openInterestDetail = (
      key: string
    ): void => {
      const meta = interestMeta[key];

      if (
        !meta ||
        !interestNetwork ||
        !interestDetailShell
      ) {
        return;
      }

      interestNetwork.classList.add(
        "is-tuning"
      );

      window.setTimeout(() => {
        interestDetailPanels.forEach(
          (panel) => {
            panel.hidden =
              panel.dataset.interestDetail !== key;
          }
        );

        if (interestDetailTitle) {
          interestDetailTitle.textContent =
            meta.title;
        }

        if (interestDetailSignal) {
          interestDetailSignal.textContent =
            meta.signal;
        }

        interestStage?.setAttribute(
          "hidden",
          ""
        );

        interestDetailShell.hidden = false;

        interestNetwork.classList.remove(
          "is-tuning"
        );
        interestNetwork.classList.add(
          "is-inspecting"
        );

        interestBackButton?.focus({
          preventScroll: true,
        });

        window.requestAnimationFrame(
          updateScrollbar
        );
      }, 260);
    };

    const closeInterestDetail = (): void => {
      if (
        !interestNetwork ||
        !interestDetailShell ||
        !interestStage
      ) {
        return;
      }

      interestNetwork.classList.remove(
        "is-inspecting"
      );
      interestDetailShell.hidden = true;
      interestStage.removeAttribute("hidden");
      clearInterestHover();

      window.requestAnimationFrame(
        updateScrollbar
      );
    };

    interestButtons.forEach((button) => {
      button.addEventListener(
        "pointerenter",
        () => previewInterest(button),
        { signal }
      );

      button.addEventListener(
        "focus",
        () => previewInterest(button),
        { signal }
      );

      button.addEventListener(
        "click",
        () => {
          const key =
            button.dataset.interestSignal;

          if (key) {
            openInterestDetail(key);
          }
        },
        { signal }
      );
    });

    interestStage?.addEventListener(
      "pointerleave",
      clearInterestHover,
      { signal }
    );

    interestStage?.addEventListener(
      "pointermove",
      (event) => {
        if (!interestCore) {
          return;
        }

        const bounds =
          interestStage.getBoundingClientRect();

        const x =
          (event.clientX - bounds.left) /
            Math.max(bounds.width, 1) -
          0.5;

        const y =
          (event.clientY - bounds.top) /
            Math.max(bounds.height, 1) -
          0.5;

        interestCore.style.setProperty(
          "--core-shift-x",
          `${x * 12}px`
        );

        interestCore.style.setProperty(
          "--core-shift-y",
          `${y * 12}px`
        );
      },
      { signal }
    );

    interestBackButton?.addEventListener(
      "click",
      closeInterestDetail,
      { signal }
    );

    const vaultMachine =
      document.querySelector<HTMLElement>(
        ".about-page [data-vault-machine]"
      );

    const vaultOpenLink =
      document.querySelector<HTMLAnchorElement>(
        ".about-page [data-vault-open]"
      );

    const vaultStatus =
      document.querySelector<HTMLElement>(
        ".about-page [data-vault-status]"
      );

    const vaultCommand =
      document.querySelector<HTMLElement>(
        ".about-page [data-vault-command]"
      );

    const vaultLocks =
      document.querySelector<HTMLElement>(
        ".about-page [data-vault-locks]"
      );

    const vaultReadout =
      document.querySelector<HTMLElement>(
        ".about-page [data-vault-readout]"
      );

    vaultOpenLink?.addEventListener(
      "click",
      (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          !vaultMachine ||
          vaultMachine.classList.contains("is-opening")
        ) {
          return;
        }

        if (
          window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches
        ) {
          return;
        }

        event.preventDefault();

        const destination =
          vaultOpenLink.href;

        vaultMachine.classList.add(
          "is-opening"
        );

        vaultOpenLink.setAttribute(
          "aria-disabled",
          "true"
        );

        if (vaultStatus) {
          vaultStatus.textContent =
            "SECURITY STATE // UNLOCKING";
        }

        if (vaultCommand) {
          vaultCommand.textContent =
            "VERIFYING ENTITY...";
        }

        if (vaultLocks) {
          vaultLocks.textContent =
            "04 RETRACTING";
        }

        if (vaultReadout) {
          vaultReadout.textContent =
            "DOOR // PRESSURE RELEASE";
        }

        window.setTimeout(() => {
          if (vaultStatus) {
            vaultStatus.textContent =
              "SECURITY STATE // ACCESS GRANTED";
          }

          if (vaultCommand) {
            vaultCommand.textContent =
              "ENTERING ARCHIVE";
          }

          if (vaultLocks) {
            vaultLocks.textContent =
              "00 ENGAGED";
          }

          if (vaultReadout) {
            vaultReadout.textContent =
              "DOOR // OPEN";
          }
        }, 1050);

        window.setTimeout(() => {
          window.location.assign(
            destination
          );
        }, 2050);
      },
      { signal }
    );

    const activateFromLocation = (): void => {
      const requestedTab =
        window.location.hash.replace(
          "#",
          ""
        );

      activateAboutTab(
        requestedTab &&
        isAboutTab(requestedTab)
          ? requestedTab
          : "about",
        false
      );
    };

    contentWindow?.addEventListener(
      "scroll",
      updateScrollbar,
      {
        passive: true,
        signal,
      }
    );

    scrollbar?.addEventListener(
      "pointerdown",
      (event) => {
        if (
          !contentWindow ||
          !scrollbar ||
          !scrollbarThumb ||
          event.target === scrollbarThumb
        ) {
          return;
        }

        const rectangle =
          scrollbar.getBoundingClientRect();

        const usableTrackHeight =
          Math.max(
            1,
            scrollbar.clientHeight - 10
          );

        const movementRange =
          Math.max(
            1,
            usableTrackHeight -
              scrollbarThumb.offsetHeight
          );

        const requestedPosition =
          Math.min(
            movementRange,
            Math.max(
              0,
              event.clientY -
                rectangle.top -
                scrollbarThumb.offsetHeight / 2
            )
          );

        const maximumScroll =
          Math.max(
            0,
            contentWindow.scrollHeight -
              contentWindow.clientHeight
          );

        contentWindow.scrollTop =
          (requestedPosition / movementRange) *
          maximumScroll;
      },
      { signal }
    );

    scrollbarThumb?.addEventListener(
      "pointerdown",
      (event) => {
        if (
          !contentWindow ||
          !scrollbar ||
          !scrollbarThumb
        ) {
          return;
        }

        event.preventDefault();

        const startingPointerY =
          event.clientY;

        const startingScrollTop =
          contentWindow.scrollTop;

        const usableTrackHeight =
          Math.max(
            1,
            scrollbar.clientHeight - 10
          );

        const movementRange =
          Math.max(
            1,
            usableTrackHeight -
              scrollbarThumb.offsetHeight
          );

        const maximumScroll =
          Math.max(
            0,
            contentWindow.scrollHeight -
              contentWindow.clientHeight
          );

        scrollbarThumb.setPointerCapture(
          event.pointerId
        );

        const moveThumb = (
          moveEvent: PointerEvent
        ): void => {
          contentWindow.scrollTop =
            startingScrollTop +
            ((
              moveEvent.clientY -
              startingPointerY
            ) /
              movementRange) *
              maximumScroll;
        };

        const releaseThumb = (
          releaseEvent: PointerEvent
        ): void => {
          if (
            scrollbarThumb.hasPointerCapture(
              releaseEvent.pointerId
            )
          ) {
            scrollbarThumb.releasePointerCapture(
              releaseEvent.pointerId
            );
          }

          scrollbarThumb.removeEventListener(
            "pointermove",
            moveThumb
          );

          scrollbarThumb.removeEventListener(
            "pointerup",
            releaseThumb
          );

          scrollbarThumb.removeEventListener(
            "pointercancel",
            releaseThumb
          );
        };

        scrollbarThumb.addEventListener(
          "pointermove",
          moveThumb
        );

        scrollbarThumb.addEventListener(
          "pointerup",
          releaseThumb
        );

        scrollbarThumb.addEventListener(
          "pointercancel",
          releaseThumb
        );
      },
      { signal }
    );

    window.addEventListener(
      "resize",
      updateScrollbar,
      { signal }
    );

    window.addEventListener(
      "hashchange",
      activateFromLocation,
      { signal }
    );

    if ("ResizeObserver" in window) {
      const observer =
        new ResizeObserver(
          updateScrollbar
        );

      if (contentWindow) {
        observer.observe(
          contentWindow
        );
      }

      aboutRuntimeWindow.__aboutPageResizeObserver =
        observer;
    }

    const showPhoto = (): void => {
      if (aboutPhoto) {
        aboutPhoto.hidden = false;
      }

      if (photoFallback) {
        photoFallback.hidden = true;
      }
    };

    const showPhotoFallback = (): void => {
      if (aboutPhoto) {
        aboutPhoto.hidden = true;
      }

      if (photoFallback) {
        photoFallback.hidden = false;
      }
    };

    aboutPhoto?.addEventListener(
      "load",
      showPhoto,
      { signal }
    );

    aboutPhoto?.addEventListener(
      "error",
      showPhotoFallback,
      { signal }
    );

    if (aboutPhoto?.complete) {
      if (aboutPhoto.naturalWidth > 0) {
        showPhoto();
      } else {
        showPhotoFallback();
      }
    }

    activateFromLocation();
    window.requestAnimationFrame(
      updateScrollbar
    );
  }

  document.addEventListener(
    "astro:page-load",
    initialiseAboutPage
  );

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseAboutPage,
      { once: true }
    );
  } else {
    initialiseAboutPage();
  }
</script>