</InternalPageLayout>

<script>
  const validAboutTabs = [
    "about",
    "work",
    "interests",
    "vault",
  ] as const;

  type AboutTab =
    (typeof validAboutTabs)[number];

  type AboutRuntimeWindow = Window & {
    __aboutPageController?: AbortController;
    __aboutPageResizeObserver?: ResizeObserver;
  };

  const aboutRuntimeWindow =
    window as AboutRuntimeWindow;

  const isAboutTab = (
    value: string
  ): value is AboutTab =>
    validAboutTabs.includes(
      value as AboutTab
    );

  function initialiseAboutPage(): void {
    /*
     * Astro's ClientRouter keeps JavaScript modules alive between
     * navigations. Any listeners attached to the old About DOM can
     * therefore become stale. Clear the old runtime first, then query
     * the current page again.
     */
    aboutRuntimeWindow.__aboutPageController?.abort();
    aboutRuntimeWindow.__aboutPageResizeObserver?.disconnect();

    const tabButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          ".about-page [data-about-tab]"
        )
      );

    if (tabButtons.length === 0) {
      return;
    }

    const controller =
      new AbortController();

    const { signal } = controller;

    aboutRuntimeWindow.__aboutPageController =
      controller;

    const contentPanels =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".about-page [data-about-panel]"
        )
      );

    const profilePanels =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".about-page [data-profile-panel]"
        )
      );

    const contentWindow =
      document.querySelector<HTMLElement>(
        "#about-content-window"
      );

    const scrollbar =
      document.querySelector<HTMLElement>(
        "#about-scrollbar"
      );

    const scrollbarThumb =
      document.querySelector<HTMLElement>(
        "#about-scrollbar-thumb"
      );

    const aboutPhoto =
      document.querySelector<HTMLImageElement>(
        "#about-photo"
      );

    const photoFallback =
      document.querySelector<HTMLElement>(
        "#about-photo-fallback"
      );

    const restartEntryAnimation = (
      element: HTMLElement | undefined
    ): void => {
      if (!element) {
        return;
      }

      element.classList.remove("is-entering");
      void element.offsetWidth;
      element.classList.add("is-entering");
    };

    const updateScrollbar = (): void => {
      if (
        !contentWindow ||
        !scrollbar ||
        !scrollbarThumb
      ) {
        return;
      }

      const usableTrackHeight =
        Math.max(
          0,
          scrollbar.clientHeight - 10
        );

      const maximumScroll =
        Math.max(
          0,
          contentWindow.scrollHeight -
            contentWindow.clientHeight
        );

      const visibleRatio =
        contentWindow.scrollHeight > 0
          ? contentWindow.clientHeight /
            contentWindow.scrollHeight
          : 1;

      const thumbHeight =
        Math.min(
          usableTrackHeight,
          Math.max(
            48,
            usableTrackHeight * visibleRatio
          )
        );

      const movementRange =
        Math.max(
          0,
          usableTrackHeight - thumbHeight
        );

      const scrollProgress =
        maximumScroll > 0
          ? contentWindow.scrollTop /
            maximumScroll
          : 0;

      scrollbarThumb.style.height =
        `${thumbHeight}px`;

      scrollbarThumb.style.transform =
        `translateY(${scrollProgress * movementRange}px)`;
    };

    const activateAboutTab = (
      tabName: AboutTab,
      updateHash = true
    ): void => {
      let activeContentPanel:
        HTMLElement | undefined;

      let activeProfilePanel:
        HTMLElement | undefined;

      tabButtons.forEach((button) => {
        const isActive =
          button.dataset.aboutTab === tabName;

        button.classList.toggle(
          "is-active",
          isActive
        );

        button.setAttribute(
          "aria-selected",
          String(isActive)
        );
      });

      contentPanels.forEach((panel) => {
        const isActive =
          panel.dataset.aboutPanel === tabName;

        panel.hidden = !isActive;

        if (isActive) {
          activeContentPanel = panel;
        }
      });

      profilePanels.forEach((panel) => {
        const isActive =
          panel.dataset.profilePanel === tabName;

        panel.hidden = !isActive;

        if (isActive) {
          activeProfilePanel = panel;
        }
      });

      if (contentWindow) {
        contentWindow.scrollTop = 0;
      }

      if (updateHash) {
        window.history.replaceState(
          null,
          "",
          `${window.location.pathname}${window.location.search}#${tabName}`
        );
      }

      restartEntryAnimation(
        activeContentPanel
      );

      restartEntryAnimation(
        activeProfilePanel
      );

      window.requestAnimationFrame(
        updateScrollbar
      );
    };

    tabButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const requestedTab =
            button.dataset.aboutTab;

          if (
            requestedTab &&
            isAboutTab(requestedTab)
          ) {
            activateAboutTab(
              requestedTab
            );
          }
        },
        { signal }
      );
    });

    const activateFromLocation = (): void => {
      const requestedTab =
        window.location.hash.replace(
          "#",
          ""
        );

      activateAboutTab(
        requestedTab &&
        isAboutTab(requestedTab)
          ? requestedTab
          : "about",
        false
      );
    };

    contentWindow?.addEventListener(
      "scroll",
      updateScrollbar,
      {
        passive: true,
        signal,
      }
    );

    scrollbar?.addEventListener(
      "pointerdown",
      (event) => {
        if (
          !contentWindow ||
          !scrollbar ||
          !scrollbarThumb ||
          event.target === scrollbarThumb
        ) {
          return;
        }

        const rectangle =
          scrollbar.getBoundingClientRect();

        const usableTrackHeight =
          Math.max(
            1,
            scrollbar.clientHeight - 10
          );

        const movementRange =
          Math.max(
            1,
            usableTrackHeight -
              scrollbarThumb.offsetHeight
          );

        const requestedPosition =
          Math.min(
            movementRange,
            Math.max(
              0,
              event.clientY -
                rectangle.top -
                scrollbarThumb.offsetHeight / 2
            )
          );

        const maximumScroll =
          Math.max(
            0,
            contentWindow.scrollHeight -
              contentWindow.clientHeight
          );

        contentWindow.scrollTop =
          (requestedPosition / movementRange) *
          maximumScroll;
      },
      { signal }
    );

    scrollbarThumb?.addEventListener(
      "pointerdown",
      (event) => {
        if (
          !contentWindow ||
          !scrollbar ||
          !scrollbarThumb
        ) {
          return;
        }

        event.preventDefault();

        const startingPointerY =
          event.clientY;

        const startingScrollTop =
          contentWindow.scrollTop;

        const usableTrackHeight =
          Math.max(
            1,
            scrollbar.clientHeight - 10
          );

        const movementRange =
          Math.max(
            1,
            usableTrackHeight -
              scrollbarThumb.offsetHeight
          );

        const maximumScroll =
          Math.max(
            0,
            contentWindow.scrollHeight -
              contentWindow.clientHeight
          );

        scrollbarThumb.setPointerCapture(
          event.pointerId
        );

        const moveThumb = (
          moveEvent: PointerEvent
        ): void => {
          contentWindow.scrollTop =
            startingScrollTop +
            ((
              moveEvent.clientY -
              startingPointerY
            ) /
              movementRange) *
              maximumScroll;
        };

        const releaseThumb = (
          releaseEvent: PointerEvent
        ): void => {
          if (
            scrollbarThumb.hasPointerCapture(
              releaseEvent.pointerId
            )
          ) {
            scrollbarThumb.releasePointerCapture(
              releaseEvent.pointerId
            );
          }

          scrollbarThumb.removeEventListener(
            "pointermove",
            moveThumb
          );

          scrollbarThumb.removeEventListener(
            "pointerup",
            releaseThumb
          );

          scrollbarThumb.removeEventListener(
            "pointercancel",
            releaseThumb
          );
        };

        scrollbarThumb.addEventListener(
          "pointermove",
          moveThumb
        );

        scrollbarThumb.addEventListener(
          "pointerup",
          releaseThumb
        );

        scrollbarThumb.addEventListener(
          "pointercancel",
          releaseThumb
        );
      },
      { signal }
    );

    window.addEventListener(
      "resize",
      updateScrollbar,
      { signal }
    );

    window.addEventListener(
      "hashchange",
      activateFromLocation,
      { signal }
    );

    if ("ResizeObserver" in window) {
      const observer =
        new ResizeObserver(
          updateScrollbar
        );

      if (contentWindow) {
        observer.observe(
          contentWindow
        );
      }

      aboutRuntimeWindow.__aboutPageResizeObserver =
        observer;
    }

    const showPhoto = (): void => {
      if (aboutPhoto) {
        aboutPhoto.hidden = false;
      }

      if (photoFallback) {
        photoFallback.hidden = true;
      }
    };

    const showPhotoFallback = (): void => {
      if (aboutPhoto) {
        aboutPhoto.hidden = true;
      }

      if (photoFallback) {
        photoFallback.hidden = false;
      }
    };

    aboutPhoto?.addEventListener(
      "load",
      showPhoto,
      { signal }
    );

    aboutPhoto?.addEventListener(
      "error",
      showPhotoFallback,
      { signal }
    );

    if (aboutPhoto?.complete) {
      if (aboutPhoto.naturalWidth > 0) {
        showPhoto();
      } else {
        showPhotoFallback();
      }
    }

    activateFromLocation();
    window.requestAnimationFrame(
      updateScrollbar
    );
  }

  document.addEventListener(
    "astro:page-load",
    initialiseAboutPage
  );

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseAboutPage,
      { once: true }
    );
  } else {
    initialiseAboutPage();
  }
</script>