---
import InternalPageLayout from "../layouts/InternalPageLayout.astro";
import { getCollection } from "astro:content";
import "../styles/about.css";

/* ==================================================
   WORK PROJECTS
   Loaded entirely from Markdown:
   src/content/work/*.md
=================================================== */

const workEntries = await getCollection("work");

const projectFiles = workEntries
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const baseUrl = import.meta.env.BASE_URL;

const buildSiteUrl = (path: string): string =>
  `${baseUrl}${path.replace(/^\/+/, "")}`;

const interestFiles = [
  {
    number: "INTEREST FILE 001",
    title: "FILMMAKING",
    description:
      "Stories, performances, camera movement, visual tension and the satisfying chaos of trying to make a film.",
  },
  {
    number: "INTEREST FILE 002",
    title: "PHOTOGRAPHY",
    description:
      "Observing people, public spaces, light, colour and moments that appear when nobody is performing for the camera.",
  },
  {
    number: "INTEREST FILE 003",
    title: "THEATRE",
    description:
      "Characters, stage movement, performance and stories that become real inside a shared physical space.",
  },
  {
    number: "INTEREST FILE 004",
    title: "INTERACTIVE WEB",
    description:
      "Designing digital spaces that feel less like ordinary websites and more like explorable worlds.",
  },
];

const vaultFiles = [
  {
    number: "VAULT FILE 001",
    title: "UNFINISHED STORIES",
    description:
      "Characters, scenes and film ideas currently waiting for enough courage, time or production budget.",
  },
  {
    number: "VAULT FILE 002",
    title: "STRANGE OBSERVATIONS",
    description:
      "Small details, overheard sentences and everyday events that might become stories later.",
  },
  {
    number: "VAULT FILE 003",
    title: "EXPERIMENTS",
    description:
      "Design tests, abandoned interfaces, visual accidents and ideas that refused to fit anywhere else.",
  },
];
---

<InternalPageLayout
  title="About Me | Prakhar's Universe"
  description="Learn about Prakhar Pandey and explore his creative work."
  message="You are currently somewhere between a portfolio and a minor space incident."
  pageClass="about-page"
>
  <!-- ==================================================
       LEFT COLUMN
  =================================================== -->

