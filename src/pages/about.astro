    </section>
  </div>

  <!-- ==================================================
       RIGHT COLUMN
  =================================================== -->

  <div slot="content" class="about-right-column">
    <nav
      class="about-tabs"
      aria-label="About page sections"
    >
      <button
        class="about-tab is-active"
        type="button"
        data-about-tab="about"
        aria-selected="true"
