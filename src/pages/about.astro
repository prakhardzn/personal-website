        data-profile-panel="about"
      >
        <div class="about-profile-terminal">
          <header class="about-profile-terminal__header">
            <span class="about-profile-terminal__title">
              USER PROFILE // LOCAL RECORD

              <span
                class="terminal-caret"
                aria-hidden="true"
              >
                ▮
              </span>
            </span>

            <span class="about-profile-terminal__status">
              <span
                class="terminal-status-dot"
                aria-hidden="true"
              ></span>

              ONLINE · ID: P-01
            </span>
          </header>

          <div class="about-profile-grid">
            <div class="about-profile-cell about-profile-cell--label">
              NAME
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              PRAKHAR
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--psychic">
                <span>TYPE</span>
                <strong>PSYCHIC</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              PRONOUNS
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              HE/HIM
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--enfp">
                <span>MBTI</span>
                <strong>ENFP</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              BDAY
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              01/11
            </div>

            <div class="about-profile-cell about-profile-cell--badge">
              <div class="about-identity-tag about-identity-tag--scorpio">
                <span>SIGN</span>
                <strong>SCORPIO</strong>
              </div>
            </div>

            <div class="about-profile-cell about-profile-cell--label">
              LOCATION
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              INDIA
            </div>

            <div
              class="about-profile-cell about-profile-cell--badge"
              aria-hidden="true"
            ></div>

            <div class="about-profile-cell about-profile-cell--label">
              STRENGTH
            </div>

            <div class="about-profile-cell about-profile-cell--value">
              CAN CRACK JOKES!!!
            </div>

            <div
