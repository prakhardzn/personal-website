---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/homepage.css";
---

<BaseLayout
  title="Prakhar's Universe"
  description="Explore Prakhar's personal creative universe."
>
  <div class="site-shell" id="site-shell">

    <!-- ==================================================
         TOP SYSTEM BAR
    =================================================== -->

    <header class="system-bar">
      <button
        class="icon-button icon-button--back"
        type="button"
        disabled
        aria-label="Back button unavailable on the homepage"
      >
        <span aria-hidden="true">←</span>
        <span class="visually-hidden">Back</span>
      </button>

      <p
        class="system-message"
        data-typewriter
      >
        “Nothing is broken. It just works differently in this dimension.”
      </p>

      <div class="system-actions">
        <button
          class="icon-button icon-button--pause"
          id="pause-button"
          type="button"
          aria-label="Pause homepage animations"
          aria-pressed="false"
        >
          <span aria-hidden="true">Ⅱ</span>

          <span
            class="visually-hidden"
            id="pause-label"
          >
            Pause animations
          </span>
        </button>

        <button
          class="icon-button icon-button--power"
          id="power-button"
          type="button"
          aria-label="Enter sleep mode"
          aria-pressed="false"
        >
          <span aria-hidden="true">⏻</span>

          <span
            class="visually-hidden"
            id="power-label"
          >
            Enter sleep mode
          </span>
        </button>
      </div>
    </header>


    <!-- ==================================================
         PLANET NAVIGATION
    =================================================== -->

    <main class="planet-map">
      <h1 class="visually-hidden">
        Explore Prakhar's universe
      </h1>

      <nav
        class="planet-navigation"
        aria-label="Main website sections"
      >
        <ul class="destination-list">

          <!-- About Me -->

          <li class="destination destination--about">
            <a
              class="planet-link"
              href="/about"
              aria-label="Open the About Me page"
            >
              <img
                class="planet-artwork"
                src="/assets/planets/about-me-planet.png"
                alt=""
              />

              <span class="planet-label">
                About Me
              </span>
            </a>
          </li>


          <!-- Weekly -->

          <li class="destination destination--weekly">
            <a
              class="planet-link"
              href="/weekly"
              aria-label="Open the Weekly page"
            >
              <img
                class="planet-artwork"
                src="/assets/planets/weekly-planet.png"
                alt=""
              />

              <span class="planet-label">
                Weekly
              </span>
            </a>
          </li>


          <!-- Astrology -->

          <li class="destination destination--astrology">
            <a
              class="planet-link"
              href="/astrology"
              aria-label="Open the Astrology page"
            >
              <img
                class="planet-artwork"
                src="/assets/planets/astrology-planet.png"
                alt=""
              />

              <span class="planet-label">
                Astrology
              </span>
            </a>
          </li>


          <!-- Libraries -->

          <li class="destination destination--libraries">
            <button
              class="planet-link planet-link--button"
              id="libraries-button"
              type="button"
              aria-label="Libraries section coming soon"
            >
              <img
                class="planet-artwork"
                src="/assets/planets/library-planet.png"
                alt=""
              />

              <span class="planet-label">
                Libraries
              </span>
            </button>
          </li>

        </ul>
      </nav>
    </main>


    <!-- ==================================================
         BOTTOM NAVIGATION
    =================================================== -->

    <footer class="bottom-dock">

      <!-- Time and coordinates -->

      <section
        class="system-status"
        aria-label="Visitor system information"
      >
        <p class="status-row status-row--time">
          <span class="status-label">
            TIME:
          </span>

          <time id="current-time">
            --:--
          </time>
        </p>

        <p class="status-row">
          <span class="status-label">
            COORD:
          </span>

          <span id="current-coordinates">
            LOCATING...
          </span>
        </p>

        <p
          class="visually-hidden"
          id="location-status"
          aria-live="polite"
        >
          Waiting for location access.
        </p>
      </section>


      <!-- Icon navigation cards -->

      <section
        class="dock-actions"
        aria-label="Additional website controls"
      >

        <!-- Info -->

        <button
          class="dock-card"
          type="button"
          data-panel="info"
        >
          <span class="dock-card__inner">
            <span
              class="dock-card__icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 48 48">
                <circle
                  cx="24"
                  cy="24"
                  r="18"
                />

                <circle
                  class="dock-card__icon-fill"
                  cx="24"
                  cy="15"
                  r="2"
                />

                <path d="M24 22V34" />
              </svg>
            </span>

            <span class="dock-card__copy">
              <span class="dock-card__title">
                Info
              </span>

              <span class="dock-card__description">
                About this realm
              </span>
            </span>
          </span>
        </button>


        <!-- Sitemap -->

        <button
          class="dock-card"
          type="button"
          data-panel="sitemap"
        >
          <span class="dock-card__inner">
            <span
              class="dock-card__icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 48 48">
                <path
                  d="
                    M5 10
                    L17 5
                    L31 11
                    L43 6
                    V38
                    L31 43
                    L17 37
                    L5 42
                    Z
                  "
                />

                <path d="M17 5V37" />
                <path d="M31 11V43" />
              </svg>
            </span>

            <span class="dock-card__copy">
              <span class="dock-card__title">
                Sitemap
              </span>

              <span class="dock-card__description">
                Navigate all
              </span>
            </span>
          </span>
        </button>


        <!-- Credits -->

        <button
          class="dock-card"
          type="button"
          data-panel="credits"
        >
          <span class="dock-card__inner">
            <span
              class="dock-card__icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 48 48">
                <path
                  d="
                    M24 4
                    L30 17
                    L44 19
                    L34 29
                    L36 43
                    L24 36
                    L12 43
                    L14 29
                    L4 19
                    L18 17
                    Z
                  "
                />
              </svg>
            </span>

            <span class="dock-card__copy">
              <span class="dock-card__title">
                Credits
              </span>

              <span class="dock-card__description">
                Thanks and magic
              </span>
            </span>
          </span>
        </button>


        <!-- Links -->

        <button
          class="dock-card"
          type="button"
          data-panel="links"
        >
          <span class="dock-card__inner">
            <span
              class="dock-card__icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 48 48">
                <path
                  d="
                    M20 30
                    L15 35
                    C11 39 5 39 2 35
                    C-1 32 0 26 4 22
                    L11 15
                    C15 11 21 11 24 15
                  "
                />

                <path
                  d="
                    M28 18
                    L33 13
                    C37 9 43 9 46 13
                    C49 16 48 22 44 26
                    L37 33
                    C33 37 27 37 24 33
                  "
                />

                <path d="M16 32L32 16" />
              </svg>
            </span>

            <span class="dock-card__copy">
              <span class="dock-card__title">
                Links
              </span>

              <span class="dock-card__description">
                Connect outwards
              </span>
            </span>
          </span>
        </button>

      </section>
    </footer>


    <!-- ==================================================
         INFORMATION PANEL
    =================================================== -->

    <dialog
      class="information-panel"
      id="information-panel"
      aria-labelledby="panel-title"
    >
      <header class="information-panel__header">
        <h2 id="panel-title">
          Information
        </h2>

        <button
          class="information-panel__close"
          id="close-information-panel"
          type="button"
          aria-label="Close information panel"
        >
          ×
        </button>
      </header>

      <div
        class="information-panel__content"
        id="panel-content"
      >
      </div>
    </dialog>


    <!-- ==================================================
         TEMPORARY SYSTEM MESSAGE
    =================================================== -->

    <div
      class="system-toast"
      id="system-toast"
      role="status"
      aria-live="polite"
      hidden
    >
    </div>

  </div>
</BaseLayout>


<script>
  /* ======================================================
     PANEL TYPES
  ====================================================== */

  type PanelName =
    | "info"
    | "sitemap"
    | "credits"
    | "links";

  interface PanelInformation {
    title: string;
    content: string;
  }


  /* ======================================================
     LIVE TIME
  ====================================================== */

  const timeElement =
    document.querySelector<HTMLTimeElement>(
      "#current-time"
    );

  function updateVisitorTime(): void {
    if (!timeElement) {
      return;
    }

    const now = new Date();

    timeElement.textContent =
      new Intl.DateTimeFormat(
        undefined,
        {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        }
      ).format(now);

    timeElement.dateTime =
      now.toISOString();
  }

  updateVisitorTime();

  window.setInterval(
    updateVisitorTime,
    30000
  );


  /* ======================================================
     VISITOR COORDINATES
  ====================================================== */

  const coordinatesElement =
    document.querySelector<HTMLSpanElement>(
      "#current-coordinates"
    );

  const locationStatusElement =
    document.querySelector<HTMLParagraphElement>(
      "#location-status"
    );

  function formatCoordinate(
    coordinate: number,
    positiveDirection: string,
    negativeDirection: string
  ): string {
    const direction =
      coordinate >= 0
        ? positiveDirection
        : negativeDirection;

    return `${Math.abs(coordinate).toFixed(4)}° ${direction}`;
  }

  function showVisitorLocation(): void {
    if (
      !coordinatesElement ||
      !locationStatusElement
    ) {
      return;
    }

    if (!("geolocation" in navigator)) {
      coordinatesElement.textContent =
        "UNAVAILABLE";

      locationStatusElement.textContent =
        "Geolocation is unavailable.";

      return;
    }

    navigator.geolocation.getCurrentPosition(
      (position: GeolocationPosition) => {
        const latitude =
          formatCoordinate(
            position.coords.latitude,
            "N",
            "S"
          );

        const longitude =
          formatCoordinate(
            position.coords.longitude,
            "E",
            "W"
          );

        coordinatesElement.textContent =
          `${latitude}, ${longitude}`;

        locationStatusElement.textContent =
          "Location signal acquired.";
      },

      () => {
        coordinatesElement.textContent =
          "ACCESS UNAVAILABLE";

        locationStatusElement.textContent =
          "Location permission was unavailable.";
      },

      {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 300000,
      }
    );
  }

  showVisitorLocation();


  /* ======================================================
     SYSTEM TOAST
  ====================================================== */

  const systemToast =
    document.querySelector<HTMLDivElement>(
      "#system-toast"
    );

  let toastTimer:
    number | undefined;

  function showSystemMessage(
    message: string
  ): void {
    if (!systemToast) {
      return;
    }

    if (toastTimer !== undefined) {
      window.clearTimeout(toastTimer);
    }

    systemToast.textContent = message;
    systemToast.hidden = false;

    toastTimer =
      window.setTimeout(
        () => {
          systemToast.hidden = true;
          systemToast.textContent = "";
          toastTimer = undefined;
        },
        3000
      );
  }


  /* ======================================================
     LIBRARIES BUTTON
  ====================================================== */

  const librariesButton =
    document.querySelector<HTMLButtonElement>(
      "#libraries-button"
    );

  librariesButton?.addEventListener(
    "click",
    () => {
      showSystemMessage(
        "LIBRARY TRANSMISSION NOT YET AVAILABLE"
      );
    }
  );


  /* ======================================================
     PAUSE BUTTON
  ====================================================== */

  const pauseButton =
    document.querySelector<HTMLButtonElement>(
      "#pause-button"
    );

  const pauseLabel =
    document.querySelector<HTMLSpanElement>(
      "#pause-label"
    );

  pauseButton?.addEventListener(
    "click",
    () => {
      const animationsArePaused =
        document.body.classList.toggle(
          "animations-paused"
        );

      pauseButton.setAttribute(
        "aria-pressed",
        String(animationsArePaused)
      );

      pauseButton.setAttribute(
        "aria-label",
        animationsArePaused
          ? "Resume homepage animations"
          : "Pause homepage animations"
      );

      if (pauseLabel) {
        pauseLabel.textContent =
          animationsArePaused
            ? "Resume animations"
            : "Pause animations";
      }

      showSystemMessage(
        animationsArePaused
          ? "PLANETARY MOTION PAUSED"
          : "PLANETARY MOTION RESUMED"
      );
    }
  );


  /* ======================================================
     POWER BUTTON
  ====================================================== */

  const powerButton =
    document.querySelector<HTMLButtonElement>(
      "#power-button"
    );

  const powerLabel =
    document.querySelector<HTMLSpanElement>(
      "#power-label"
    );

  powerButton?.addEventListener(
    "click",
    () => {
      const sleepModeIsActive =
        document.body.classList.toggle(
          "sleep-mode"
        );

      powerButton.setAttribute(
        "aria-pressed",
        String(sleepModeIsActive)
      );

      powerButton.setAttribute(
        "aria-label",
        sleepModeIsActive
          ? "Exit sleep mode"
          : "Enter sleep mode"
      );

      if (powerLabel) {
        powerLabel.textContent =
          sleepModeIsActive
            ? "Exit sleep mode"
            : "Enter sleep mode";
      }

      showSystemMessage(
        sleepModeIsActive
          ? "SYSTEM ENTERING SLEEP MODE"
          : "SYSTEM RESTORED"
      );
    }
  );


  /* ======================================================
     PANEL CONTENT
  ====================================================== */

  const panelInformation:
    Record<PanelName, PanelInformation> = {
      info: {
        title: "Info",

        content: `
          <p>
            This is Prakhar's personal corner of the universe.
            Each planet leads to a different collection of work,
            discoveries and questionable transmissions.
          </p>
        `,
      },

      sitemap: {
        title: "Sitemap",

        content: `
          <nav aria-label="Website sitemap">
            <ul>
              <li>
                <a href="/">Home</a>
              </li>

              <li>
                <a href="/about">About Me</a>
              </li>

              <li>
                <a href="/weekly">Weekly</a>
              </li>

              <li>
                <a href="/astrology">Astrology</a>
              </li>

              <li>
                Libraries — Coming Soon
              </li>
            </ul>
          </nav>
        `,
      },

      credits: {
        title: "Credits",

        content: `
          <p>
            Designed and developed by Prakhar Pandey.
          </p>

          <p>
            Built using Astro.
          </p>

          <p>
            Visual assets and illustrations by Prakhar Pandey.
          </p>
        `,
      },

      links: {
        title: "Links",

        content: `
          <ul>
            <li>
              <a href="mailto:prakharpandey2027@gmail.com">
                Email
              </a>
            </li>

            <li>
              <a href="#" target="_blank" rel="noreferrer">
                Instagram
              </a>
            </li>

            <li>
              <a href="#" target="_blank" rel="noreferrer">
                LinkedIn
              </a>
            </li>

            <li>
              <a href="#" target="_blank" rel="noreferrer">
                GitHub
              </a>
            </li>

            <li>
              <a href="#" target="_blank" rel="noreferrer">
                YouTube
              </a>
            </li>
          </ul>
        `,
      },
    };

  function isPanelName(
    value: string
  ): value is PanelName {
    return value in panelInformation;
  }


  /* ======================================================
     PANEL ELEMENTS
  ====================================================== */

  const informationPanel =
    document.querySelector<HTMLDialogElement>(
      "#information-panel"
    );

  const panelTitle =
    document.querySelector<HTMLHeadingElement>(
      "#panel-title"
    );

  const panelContent =
    document.querySelector<HTMLDivElement>(
      "#panel-content"
    );

  const panelButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-panel]"
    );

  const closeInformationButton =
    document.querySelector<HTMLButtonElement>(
      "#close-information-panel"
    );


  function openInformationPanel(
    panelName: PanelName
  ): void {
    if (
      !informationPanel ||
      !panelTitle ||
      !panelContent
    ) {
      return;
    }

    const selectedPanel =
      panelInformation[panelName];

    panelTitle.textContent =
      selectedPanel.title;

    panelContent.innerHTML =
      selectedPanel.content;

    if (!informationPanel.open) {
      informationPanel.showModal();
    }
  }


  panelButtons.forEach(
    (button: HTMLButtonElement) => {
      button.addEventListener(
        "click",
        () => {
          const panelName =
            button.dataset.panel;

          if (
            !panelName ||
            !isPanelName(panelName)
          ) {
            return;
          }

          openInformationPanel(
            panelName
          );
        }
      );
    }
  );


  closeInformationButton?.addEventListener(
    "click",
    () => {
      informationPanel?.close();
    }
  );


  informationPanel?.addEventListener(
    "click",
    (event: MouseEvent) => {
      if (
        event.target ===
        informationPanel
      ) {
        informationPanel.close();
      }
    }
  );
</script>