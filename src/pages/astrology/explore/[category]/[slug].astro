---
import type {
  GetStaticPaths,
} from "astro";

import InternalPageLayout from
  "../../../../layouts/InternalPageLayout.astro";

import "../../../../styles/astrology.css";

import {
  astrologyCategories,
  type AstrologyCategory,
  type AstrologyEntry,
} from "../../../../data/astrology";


export const getStaticPaths:
  GetStaticPaths = () => {
    return astrologyCategories.flatMap(
      (category) =>
        category.entries.map(
          (entry) => ({
            params: {
              category:
                category.key,

              slug:
                entry.slug,
            },

            props: {
              category,
              entry,
            },
          })
        )
    );
  };


const {
  category,
  entry,
} = Astro.props as {
  category: AstrologyCategory;
  entry: AstrologyEntry;
};


/* =========================================================
   DEPLOYMENT-SAFE URLS
========================================================= */

const baseUrl =
  import.meta.env.BASE_URL;


const buildSiteUrl = (
  path: string
): string => {
  return `${baseUrl}${path.replace(
    /^\/+/,
    ""
  )}`;
};


/* =========================================================
   ENTRY INFORMATION
========================================================= */

const entryIndex =
  Math.max(
    0,
    category.entries.findIndex(
      (categoryEntry) =>
        categoryEntry.slug ===
        entry.slug
    )
  );


const entryNumber =
  String(
    entryIndex + 1
  ).padStart(
    2,
    "0"
  );


const archiveNumber =
  category.number.replace(
    "ASTRO FILE ",
    ""
  );


const categoryMode =
  category.key ===
  "zodiac-signs"
    ? "ZODIAC"
    : category.singularLabel.toUpperCase();


/* =========================================================
   CONTROLLED GREEN PALETTE

   Every entry inside one archive uses the same green shade.
   Individual planets and houses no longer change colours.
========================================================= */

const getCategoryTone = (
  key: AstrologyCategory["key"]
):
  | "primary"
  | "mint"
  | "lime"
  | "muted" => {
  switch (key) {
    case "planets":
      return "primary";

    case "zodiac-signs":
      return "mint";

    case "nakshatras":
      return "lime";

    case "houses":
      return "muted";

    default:
      return "primary";
  }
};


const categoryTone =
  getCategoryTone(
    category.key
  );


const categoryAccentMap = {
  primary: "#8cff58",
  mint: "#45e89a",
  lime: "#b2e77c",
  muted: "#64984f",
} as const;


const categoryAccent =
  categoryAccentMap[
    categoryTone
  ];


/* =========================================================
   ASTRO PEDIA TERMINAL DIAL
========================================================= */

const outerSegments =
  Array.from({
    length: 24,
  });


const lunarTicks =
  Array.from({
    length: 27,
  });


const sectorLabels =
  Array.from(
    {
      length: 12,
    },
    (
      _,
      index
    ) => ({
      number:
        String(
          index + 1
        ).padStart(
          2,
          "0"
        ),

      degree:
        `${String(
          index * 30
        ).padStart(
          3,
          "0"
        )}°`,
    })
  );


const archiveNodes = [
  {
    key: "planets",
    short: "P",
    label: "PLANETS",
    tone: "primary",
  },

  {
    key: "zodiac-signs",
    short: "Z",
    label: "ZODIAC",
    tone: "mint",
  },

  {
    key: "nakshatras",
    short: "N",
    label: "NAKSHATRAS",
    tone: "lime",
  },

  {
    key: "houses",
    short: "H",
    label: "HOUSES",
    tone: "muted",
  },
] as const;
---

<InternalPageLayout
  title={`${entry.name} | Astro Pedia`}
  description={entry.summary}
  message="Celestial file opened. Interpret responsibly."
  pageClass="astrology-page astrology-subpage"
>
  <!-- ==================================================
       LEFT COLUMN
  =================================================== -->

  <div
    slot="sidebar"
    class="astrology-left-column astrology-subpage-left astrology-entry-tone"
    style={`
      --entry-accent:
      ${categoryAccent};

      --astrology-card-border:
      ${categoryAccent};
    `}
  >
    <!-- Astro Pedia terminal -->

    <figure
      class="astrology-terminal-card astrology-entry-terminal"
      aria-labelledby="astro-entry-terminal-title"
    >
      <header class="astrology-terminal-card__header">
        <div>
          <span
            class="astrology-online-dot"
            aria-hidden="true"
          ></span>

          <strong id="astro-entry-terminal-title">
            CELESTIAL RECORD // {entry.name}
          </strong>
        </div>

        <span>
          FILE: {entryNumber}
        </span>
      </header>


      <div class="astrology-terminal-viewport">
        <div
          class="astrology-dial"
          role="img"
          aria-label={`Astro Pedia terminal dial displaying the ${entry.name} record`}
        >
          <!-- Coordinate labels -->

          <span
            class="astrology-coordinate astrology-coordinate--north"
          >
            Y: +090
          </span>

          <span
            class="astrology-coordinate astrology-coordinate--east"
          >
            X: +180
          </span>

          <span
            class="astrology-coordinate astrology-coordinate--south"
          >
            Y: -090
          </span>

          <span
            class="astrology-coordinate astrology-coordinate--west"
          >
            X: 000
          </span>


          <!-- Fixed crosshair -->

          <div
            class="astrology-dial__crosshair"
            aria-hidden="true"
          >
            <span></span>
            <span></span>
          </div>


          <!-- Rotating segmented ring -->

          <div
            class="astrology-dial__outer-ring"
            aria-hidden="true"
          >
            {
              outerSegments.map(
                (
                  _,
                  index
                ) => (
                  <span
                    class="astrology-dial__outer-segment"
                    style={`
                      --segment-angle:
                      ${index * 15}deg;
                    `}
                  ></span>
                )
              )
            }
          </div>


          <!-- Counter-rotating lunar ring -->

          <div
            class="astrology-dial__lunar-ring"
            aria-hidden="true"
          >
            {
              lunarTicks.map(
                (
                  _,
                  index
                ) => (
                  <span
                    class="astrology-dial__lunar-tick"
                    style={`
                      --tick-angle:
                      ${(index * 360) / 27}deg;
                    `}
                  ></span>
                )
              )
            }
          </div>


          <!-- Fixed sectors -->

          <div
            class="astrology-dial__sectors"
            aria-hidden="true"
          >
            {
              sectorLabels.map(
                (
                  sector,
                  index
                ) => (
                  <span
                    class="astrology-dial__sector"
                    style={`
                      --sector-angle:
                      ${index * 30}deg;

                      --sector-counter-angle:
                      ${index * -30}deg;
                    `}
                  >
                    <strong>
                      {sector.number}
                    </strong>

                    <small>
                      {sector.degree}
                    </small>
                  </span>
                )
              )
            }
          </div>


          <!-- Moving tracking node -->

          <div
            class="astrology-dial__tracker-path"
            aria-hidden="true"
          >
            <span class="astrology-dial__tracker">
              <i></i>

              <em>
                REC {entryNumber}
              </em>
            </span>
          </div>


          <!-- Archive nodes -->

          <div
            class="astrology-dial__archive-nodes"
            aria-hidden="true"
          >
            {
              archiveNodes.map(
                (node) => (
                  <div
                    class:list={[
                      "astrology-archive-node",

                      `astrology-archive-node--${node.key}`,

                      `astrology-archive-node--${node.tone}`,

                      node.key ===
                        category.key &&
                        "is-linked",
                    ]}
                    data-archive-node={node.key}
                  >
                    <span>
                      {node.short}
                    </span>

                    <strong>
                      {node.label}
                    </strong>
                  </div>
                )
              )
            }
          </div>


          <!-- Fixed terminal centre -->

          <div class="astrology-dial__core">
            <p>
              ASTRO PEDIA

              <span
                class="astrology-terminal-caret"
                aria-hidden="true"
              >
                _
              </span>
            </p>

            <dl>
              <div>
                <dt>
                  MODE
                </dt>

                <dd>
                  {categoryMode}
                </dd>
              </div>

              <div>
                <dt>
                  FILE
                </dt>

                <dd>
                  {entryNumber}
                </dd>
              </div>

              <div>
                <dt>
                  SIGNAL
                </dt>

                <dd>
                  STABLE
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>


      <!-- Terminal information strip -->

      <figcaption class="astrology-terminal-readout">
        <span>
          ARCHIVE

          <strong>
            {archiveNumber}
          </strong>
        </span>

        <span>
          RECORD

          <strong>
            {entryNumber}
          </strong>
        </span>

        <span>
          TYPE

          <strong>
            {categoryMode}
          </strong>
        </span>

        <span class="astrology-terminal-readout__status">
          <i aria-hidden="true"></i>

          FILE OPEN
        </span>
      </figcaption>
    </figure>


    <!-- Entry information -->

    <section class="astrology-sidebar-card">
      <div class="astrology-sidebar-panel">
        <p>
          {category.singularLabel.toUpperCase()} FILE {entryNumber}
        </p>

        <h2>
          {entry.name}
        </h2>

        <span>
          {entry.summary}
        </span>

        <dl>
          {
            entry.facts.map(
              (fact) => (
                <div>
                  <dt>
                    {fact.label}
                  </dt>

                  <dd>
                    {fact.value}
                  </dd>
                </div>
              )
            )
          }
        </dl>
      </div>
    </section>
  </div>


  <!-- ==================================================
       RIGHT COLUMN
  =================================================== -->

  <div
    slot="content"
    class="astrology-right-column astrology-entry-tone"
    style={`
      --entry-accent:
      ${categoryAccent};

      --astrology-card-border:
      ${categoryAccent};
    `}
  >
    <!-- Main Astrology navigation -->

    <nav
      class="astrology-tabs astrology-tabs--links"
      aria-label="Astrology sections"
    >
      <a
        class="astrology-tab is-active"
        href={`${buildSiteUrl(
          "/astrology"
        )}#explore`}
      >
        <span aria-hidden="true">
          &gt;
        </span>

        ASTRO PEDIA
      </a>

      <a
        class="astrology-tab"
        href={`${buildSiteUrl(
          "/astrology"
        )}#case-studies`}
      >
        <span aria-hidden="true">
          &gt;
        </span>

        CASE STUDIES
      </a>

      <a
        class="astrology-tab"
        href={`${buildSiteUrl(
          "/astrology"
        )}#questions`}
      >
        <span aria-hidden="true">
          &gt;
        </span>

        QUESTIONS
      </a>

      <a
        class="astrology-tab"
        href={`${buildSiteUrl(
          "/astrology"
        )}#blogs`}
      >
        <span aria-hidden="true">
          &gt;
        </span>

        BLOGS
      </a>
    </nav>


    <div class="astrology-subpage-window">
      <article
        class="astrology-content-panel astrology-detail-page astrology-entry-detail"
      >
        <!-- Breadcrumbs -->

        <nav
          class="astrology-breadcrumbs"
          aria-label="Astrology breadcrumb"
        >
          <a
            href={buildSiteUrl(
              "/astrology"
            )}
          >
            ASTRO PEDIA
          </a>

          <span>
            /
          </span>

          <a
            href={buildSiteUrl(
              `/astrology/explore/${category.key}`
            )}
          >
            {category.label}
          </a>

          <span>
            /
          </span>

          <strong>
            {entry.name}
          </strong>
        </nav>


        <!-- Entry heading -->

        <header class="astrology-detail-header">
          <p>
            <span
              class="astrology-observation-dot"
              aria-hidden="true"
            ></span>

            {category.singularLabel.toUpperCase()} FILE {entryNumber}
          </p>

          <h1>
            {entry.name}
          </h1>

          {
            entry.alternate && (
              <h2>
                {entry.alternate}
              </h2>
            )
          }

          <span>
            {entry.subtitle}
          </span>
        </header>


        <!-- Introduction -->

        <p class="astrology-detail-introduction">
          {entry.summary}
        </p>


        <!-- Facts -->

        <div class="astrology-fact-grid">
          {
            entry.facts.map(
              (fact) => (
                <div>
                  <span>
                    {fact.label}
                  </span>

                  <strong>
                    {fact.value}
                  </strong>
                </div>
              )
            )
          }
        </div>


        <!-- Main sections -->

        <div class="astrology-detail-sections">
          {
            entry.sections.map(
              (
                section,
                index
              ) => (
                <section>
                  <span class="astrology-entry-section-number">
                    SECTION {
                      String(
                        index + 1
                      ).padStart(
                        2,
                        "0"
                      )
                    }
                  </span>

                  <h2>
                    {section.heading}
                  </h2>

                  <p>
                    {section.body}
                  </p>
                </section>
              )
            )
          }
        </div>


        <!-- Keywords -->

        <section class="astrology-entry-keyword-section">
          <p>
            INDEX KEYWORDS
          </p>

          <div class="astrology-keywords astrology-keywords--large">
            {
              entry.keywords.map(
                (keyword) => (
                  <span>
                    {keyword}
                  </span>
                )
              )
            }
          </div>
        </section>


        <footer class="astrology-disclaimer">
          Astrology is interpretive. These entries are learning
          notes and should not replace medical, legal or
          financial guidance.
        </footer>
      </article>
    </div>
  </div>
</InternalPageLayout>


<style>
  /* =======================================================
     CATEGORY-SPECIFIC GREEN ACCENT

     Planets:
     #8cff58

     Zodiac:
     #45e89a

     Nakshatras:
     #b2e77c

     Houses:
     #64984f
  ======================================================= */

  .astrology-entry-tone
  .astrology-terminal-card__header {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-online-dot {
    color:
      var(--entry-accent);

    background:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-dial__core {
    border-color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-terminal-readout strong {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-terminal-readout__status {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-terminal-readout__status i {
    color:
      var(--entry-accent);

    background:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-sidebar-panel > p {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-sidebar-panel h2 {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-sidebar-status {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-sidebar-status i {
    color:
      var(--entry-accent);

    background:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-breadcrumbs strong {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-detail-header > p {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-observation-dot {
    color:
      var(--entry-accent);

    background:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-detail-header h1 {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-detail-header h2 {
    color:
      color-mix(
        in srgb,
        var(--entry-accent) 72%,
        var(--astro-white)
      );
  }


  .astrology-entry-tone
  .astrology-fact-grid > div {
    border-color:
      color-mix(
        in srgb,
        var(--entry-accent) 44%,
        var(--astro-border)
      );
  }


  .astrology-entry-tone
  .astrology-fact-grid strong {
    color:
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-detail-sections section {
    border-left:
      2px solid
      var(--entry-accent);
  }


  .astrology-entry-tone
  .astrology-detail-sections h2 {
    color:
      var(--entry-accent);
  }


  .astrology-entry-section-number {
    display:
      block;

    margin-bottom:
      8px;

    color:
      var(--astro-green-muted);

    font-family:
      var(--astro-display-font);

    font-size:
      var(--astro-text-micro);

    letter-spacing:
      0.09em;

    text-transform:
      uppercase;
  }


  .astrology-entry-keyword-section {
    padding-top:
      24px;

    margin-top:
      28px;

    border-top:
      1px solid
      var(--astro-border);
  }


  .astrology-entry-keyword-section > p {
    margin:
      0
      0
      14px;

    color:
      var(--entry-accent);

    font-family:
      var(--astro-display-font);

    font-size:
      var(--astro-text-meta);

    letter-spacing:
      0.11em;

    text-transform:
      uppercase;
  }


  .astrology-entry-tone
  .astrology-keywords span {
    border-color:
      var(--entry-accent);

    color:
      var(--entry-accent);
  }
</style>