---
import InternalPageLayout from "../layouts/InternalPageLayout.astro";
import "../styles/libraries.css";

import { getCollection } from "astro:content";

import {
  libraryCategories,
  defaultLibraryCategory,
  getLibraryEntries,
} from "../data/library";

import type {
  LibraryCategoryKey,
  LibraryEntry,
} from "../data/library";


/* =========================================================
   TYPES
========================================================= */

type DisplayLibraryEntry =
  LibraryEntry & {
    poster: string | null;
    imdbId?: string | null;
    imdbRating?: string | null;
  };


interface MusicSignal {
  id: string;
  title: string;
  artist: string;
  album: string | null;
  year: string | null;
  recordingId: string;
  releaseId: string | null;
  releaseGroupId: string | null;
  durationMs: number | null;
  cover: string | null;
  status: "saved" | "discover-later";
  favourite: boolean;
  myRating: number | null;
  shelf: string;
  tags: string[];
  note: string;
}


/* =========================================================
   MOVIES
========================================================= */

const markdownMovies =
  (
    await getCollection("movies")
  ).sort(
    (first, second) =>
      second.data.addedAt.localeCompare(
        first.data.addedAt
      )
  );


const savedMovieEntries:
  DisplayLibraryEntry[] =
  markdownMovies.map(
    (movie, index) => {
      const data = movie.data;

      const personalNote =
        movie.body?.trim() ||
        "No personal note yet.";

      const statusLabel =
        data.status === "watched"
          ? "WATCHED"
          : "WATCHLIST";

      const state =
        data.status === "watched"
          ? "completed"
          : "pending";

      return {
        id: `movie-${movie.id}`,

        category: "movies",

        title: data.title,

        creator:
          data.director ??
          "Director unavailable",

        year: data.year,

        mediaType: "MOVIE",

        state,

        statusLabel,

        favourite:
          data.favourite,

        rating:
          data.myRating,

        note:
          personalNote,

        synopsis:
          data.plot ??
          "No plot information available.",

        shelf:
          data.shelf,

        coverCode:
          `MOV-${String(
            index + 1
          ).padStart(3, "0")}`,

        coverCaption:
          data.title,

        coverTone:
          "green",

        tags:
          data.tags.length
            ? data.tags
            : data.genre,

        facts: [
          {
            label: "DIRECTOR",
            value:
              data.director ??
              "Unknown",
          },

          {
            label: "RUNTIME",
            value:
              data.runtime ??
              "Unknown",
          },

          {
            label: "GENRE",
            value:
              data.genre.length
                ? data.genre.join(", ")
                : "Unknown",
          },

          {
            label: "IMDb",
            value:
              data.imdbRating
                ? `${data.imdbRating}/10`
                : "Unrated",
          },

          {
            label: "IMDb ID",
            value:
              data.imdbId,
          },

          {
            label: "RELEASED",
            value:
              data.released ??
              "Unknown",
          },

          {
            label: "LANGUAGE",
            value:
              data.language.length
                ? data.language.join(", ")
                : "Unknown",
          },

          {
            label: "COUNTRY",
            value:
              data.country.length
                ? data.country.join(", ")
                : "Unknown",
          },
        ],

        poster:
          data.poster,

        imdbId:
          data.imdbId,

        imdbRating:
          data.imdbRating,
      };
    }
  );


/* =========================================================
   GAMES
========================================================= */

const gameEntries:
  DisplayLibraryEntry[] =
  getLibraryEntries("games").map(
    (entry) => ({
      ...entry,

      poster: null,

      imdbId: null,

      imdbRating: null,
    })
  );


const genericEntries:
  DisplayLibraryEntry[] = [
    ...savedMovieEntries,
    ...gameEntries,
  ];


/* =========================================================
   MUSIC
========================================================= */

const markdownMusic =
  await getCollection("music");


const musicSignals:
  MusicSignal[] =
  markdownMusic.map(
    (song) => ({
      id:
        song.id,

      title:
        song.data.title,

      artist:
        song.data.artist,

      album:
        song.data.album,

      year:
        song.data.year,

      recordingId:
        song.data.recordingId,

      releaseId:
        song.data.releaseId,

      releaseGroupId:
        song.data.releaseGroupId,

      durationMs:
        song.data.durationMs,

      cover:
        song.data.cover,

      status:
        song.data.status,

      favourite:
        song.data.favourite,

      myRating:
        song.data.myRating,

      shelf:
        song.data.shelf,

      tags:
        song.data.tags,

      note:
        song.body?.trim() ||
        "No personal note yet.",
    })
  );


/* =========================================================
   MUSIC ARTISTS
========================================================= */

const preferredArtistOrder = [
  "Daft Punk",
  "Toby Fox",
  "Tame Impala",
  "The Beatles",
  "Maroon 5",
  "Michael Jackson",
  "Queen",
  "Eminem",
  "Dua Lipa",
];


const discoveredArtists =
  Array.from(
    new Set(
      musicSignals.map(
        (signal) =>
          signal.artist
      )
    )
  );


const orderedArtists = [
  ...preferredArtistOrder.filter(
    (artist) =>
      discoveredArtists.includes(
        artist
      )
  ),

  ...discoveredArtists
    .filter(
      (artist) =>
        !preferredArtistOrder.includes(
          artist
        )
    )
    .sort(
      (first, second) =>
        first.localeCompare(second)
    ),
];


const artistSummaries =
  orderedArtists.map(
    (artist) => {
      const songs =
        musicSignals.filter(
          (song) =>
            song.artist === artist
        );

      const albums =
        new Set(
          songs.map(
            (song) =>
              song.album ??
              "Loose Signals"
          )
        );

      const cover =
        songs.find(
          (song) =>
            Boolean(song.cover)
        )?.cover ??
        null;

      return {
        artist,

        count:
          songs.length,

        albums:
          albums.size,

        cover,
      };
    }
  );


/* =========================================================
   CATEGORY HELPERS
========================================================= */

const getGenericEntries =
  (
    category:
      LibraryCategoryKey
  ) =>
    genericEntries.filter(
      (entry) =>
        entry.category ===
        category
    );


const getCategoryCount =
  (
    category:
      LibraryCategoryKey
  ) => {
    if (
      category === "music"
    ) {
      return musicSignals.length;
    }

    return getGenericEntries(
      category
    ).length;
  };


const movieCount =
  getCategoryCount("movies");

const gameCount =
  getCategoryCount("games");

const musicCount =
  getCategoryCount("music");


const archiveNodes = [
  {
    key: "movies",
    number: "01",
    title: "MOVIE FILES",
    short: "CINEMA STORAGE",
    count: movieCount,
    unit: "FILES",
    description:
      "Films, short films and moving images stored inside the visual archive.",
  },

  {
    key: "games",
    number: "02",
    title: "GAME VAULT",
    short: "INTERACTIVE STORAGE",
    count: gameCount,
    unit: "FILES",
    description:
      "Games played, completed, abandoned or remembered for suspiciously long periods.",
  },

  {
    key: "music",
    number: "03",
    title: "AUDIO SIGNALS",
    short: "FREQUENCY ARCHIVE",
    count: musicCount,
    unit: "SIGNALS",
    description:
      "Songs and artists repeatedly transmitted into the headphones.",
  },
] as const;


const musicDataJson =
  JSON.stringify(
    musicSignals
  ).replace(
    /</g,
    "\\u003c"
  );
