  function renderMusicArtist(
    artist:
      string
  ): void {
    const songs =
      musicSignals.filter(
        (song) =>
          song.artist ===
          artist
      );


    if (!songs.length) {
      return;
    }


    activeMusicArtist =
      artist;


    if (
      musicArtistIndex
    ) {
      musicArtistIndex.hidden =
        true;
    }


    if (
      musicArtistView
    ) {
      musicArtistView.hidden =
        false;
    }


    if (
      musicArtistTitle
    ) {
      musicArtistTitle.textContent =
        artist;
    }


    const groups =
      new Map<
        string,
        MusicSignal[]
      >();


    songs.forEach(
      (song) => {
        const album =
          song.album ??
          "Loose Signals";


        const current =
          groups.get(album) ??
          [];


        current.push(song);

        groups.set(
          album,
          current
        );
      }
    );


    if (
      musicArtistSongCount
    ) {
      musicArtistSongCount.textContent =
        `${songs.length} SIGNALS`;
    }


    if (
      musicArtistAlbumCount
    ) {
      musicArtistAlbumCount.textContent =
        `${groups.size} RELEASES`;
    }


    if (
      musicArtistCover
    ) {
      musicArtistCover
        .querySelectorAll("img")
        .forEach(
          (image) =>
            image.remove()
        );


      const cover =
        songs.find(
          (song) =>
            Boolean(song.cover)
        )?.cover ??
        null;


      if (cover) {
        const image =
          document.createElement(
            "img"
          );

        image.src =
          cover;

        image.alt =
          `${artist} artwork`;

        musicArtistCover.prepend(
          image
        );
      }
    }


    musicAlbumList
      ?.replaceChildren();


    Array.from(
      groups.entries()
    )
      .sort(
        (first, second) => {
          const firstYear =
            first[1].find(
              (song) =>
                song.year
            )?.year ??
            "9999";


          const secondYear =
            second[1].find(
              (song) =>
                song.year
            )?.year ??
            "9999";


          if (
            firstYear !==
            secondYear
          ) {
            return firstYear.localeCompare(
              secondYear
            );
          }


          return first[0].localeCompare(
            second[0]
          );
        }
      )
      .forEach(
        ([album, albumSongs]) => {
          musicAlbumList?.append(
            createAlbumSection(
              album,
              albumSongs
            )
          );
        }
      );


    if (
      musicSignalSearch
    ) {
      musicSignalSearch.value =
        "";
    }
  }


