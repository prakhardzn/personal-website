---
import InternalPageLayout from "../layouts/InternalPageLayout.astro";
import "../styles/libraries.css";

import {
  defaultLibraryCategory,
  getLibraryEntries,
  libraryCategories,
  libraryEntries,
} from "../data/library";

const categorySummaries = libraryCategories.map((category) => {
  const entries = getLibraryEntries(category.key);

  const completedCount = entries.filter(
    (entry) => entry.state === "completed"
  ).length;

  const pendingCount = entries.filter(
    (entry) => entry.state === "pending"
  ).length;

  return {
    ...category,
    entries,
    totalCount: entries.length,
    completedCount,
    pendingCount,
  };
});

const defaultCategory =
  categorySummaries.find(
    (category) => category.key === defaultLibraryCategory.key
  ) ?? categorySummaries[0];
---

<InternalPageLayout
  title="Interdimensional Library | Prakhar's Universe"
  description="Explore Prakhar's personal movie, game and music archives."
  message="This archive is poorly organised, emotionally biased and somehow still operational."
  pageClass="libraries-page"
>
  <!-- ==================================================
       LEFT COLUMN
  =================================================== -->

  <div
    slot="sidebar"
    class="library-left-column"
  >
    <figure
      class="library-terminal"
      aria-labelledby="library-terminal-title"
    >
      <header class="library-terminal__header">
        <div>
          <span
            class="library-online-dot"
            aria-hidden="true"
          ></span>

          <strong id="library-terminal-title">
            MEDIA CORE // L-01
          </strong>
        </div>

        <span>
          SYS: ONLINE
        </span>
      </header>

      <div class="library-terminal__viewport">
        <span class="library-coordinate library-coordinate--north">
          Y: +090
        </span>

        <span class="library-coordinate library-coordinate--east">
          X: +180
        </span>

        <span class="library-coordinate library-coordinate--south">
          Y: -090
        </span>

        <span class="library-coordinate library-coordinate--west">
          X: 000
        </span>

        <div
          class="library-radar"
          aria-hidden="true"
        >
          <span class="library-radar__ring library-radar__ring--outer">
          </span>

          <span class="library-radar__ring library-radar__ring--middle">
          </span>

          <span class="library-radar__ring library-radar__ring--inner">
          </span>

          <span class="library-radar__horizontal">
          </span>

          <span class="library-radar__vertical">
          </span>

          <span class="library-radar__scanner">
          </span>

          <div class="library-radar__core">
            <span>
              MEDIA
            </span>

            <strong>
              CORE
            </strong>

            <small>
              L-01
            </small>
          </div>

          {
            categorySummaries.map((category, index) => (
              <span
                class:list={[
                  "library-radar__node",
                  `library-radar__node--${category.key}`,
                  category.key === defaultCategory.key && "is-active",
                ]}
                data-library-radar-node={category.key}
                style={`--node-index: ${index};`}
              >
                <i>
                  {category.number}
                </i>

                <strong>
                  {category.shortTitle}
                </strong>
              </span>
            ))
          }
        </div>
      </div>

      <figcaption class="library-terminal__footer">
        <span>
          ARCHIVES

          <strong>
            {String(categorySummaries.length).padStart(2, "0")}
          </strong>
        </span>

        <span>
          RECORDS

          <strong>
            {String(libraryEntries.length).padStart(2, "0")}
          </strong>
        </span>

        <span class="library-terminal__status">
          <i aria-hidden="true"></i>

          SIGNAL STABLE
        </span>
      </figcaption>
    </figure>

    <section
      class="library-sidebar-card"
      aria-live="polite"
    >
      <header class="library-sidebar-card__header">
        <span>
          SELECTED ARCHIVE
        </span>

        <strong id="library-sidebar-number">
          {defaultCategory.number}
        </strong>
      </header>

      <div class="library-sidebar-card__content">
        <p>
          CURRENT STORAGE UNIT
        </p>

        <h2 id="library-sidebar-title">
          {defaultCategory.title}
        </h2>

        <span id="library-sidebar-description">
          {defaultCategory.description}
        </span>

        <dl>
          <div>
            <dt id="library-sidebar-stat-one-label">
              {defaultCategory.firstStatLabel}
            </dt>

            <dd id="library-sidebar-stat-one-value">
              {String(defaultCategory.completedCount).padStart(3, "0")}
            </dd>
          </div>

          <div>
            <dt id="library-sidebar-stat-two-label">
              {defaultCategory.secondStatLabel}
            </dt>

            <dd id="library-sidebar-stat-two-value">
              {String(defaultCategory.pendingCount).padStart(3, "0")}
            </dd>
          </div>
        </dl>
      </div>

      <footer class="library-sidebar-card__footer">
        <span
          class="library-status-dot"
          aria-hidden="true"
        ></span>

        <span id="library-sidebar-status">
          {defaultCategory.systemStatus}
        </span>
      </footer>
    </section>
  </div>

  <!-- ==================================================
       RIGHT COLUMN
  =================================================== -->

  <div
    slot="content"
    class="library-right-column"
  >
    <!-- ==================================================
         ENTRANCE VIEW
    =================================================== -->

    <section
      class="library-view library-view--entrance"
      id="library-entrance-view"
    >
      <header class="library-page-header">
        <div>
          <p>
            PERSONAL MEDIA STORAGE SYSTEM
          </p>

          <h1>
            Interdimensional Library
          </h1>

          <span>
            Things I watched, played and listened to instead of
            doing something productive.
          </span>
        </div>

        <div class="library-page-header__status">
          <i aria-hidden="true"></i>

          <span>
            <small>
              ARCHIVE STATUS
            </small>

            <strong>
              POORLY ORGANISED
            </strong>
          </span>
        </div>
      </header>

      <div class="library-portal-grid">
        {
          categorySummaries.map((category) => (
            <button
              class:list={[
                "library-portal-card",
                `library-portal-card--${category.key}`,
                category.key === defaultCategory.key && "is-selected",
              ]}
              type="button"
              data-library-category={category.key}
              data-number={category.number}
              data-title={category.title}
              data-description={category.description}
              data-status={category.systemStatus}
              data-first-label={category.firstStatLabel}
              data-first-value={String(category.completedCount).padStart(
                3,
                "0"
              )}
              data-second-label={category.secondStatLabel}
              data-second-value={String(category.pendingCount).padStart(
                3,
                "0"
              )}
              data-action-label={category.actionLabel}
              aria-pressed={
                category.key === defaultCategory.key ? "true" : "false"
              }
            >
              <span class="library-portal-card__header">
                <span>
                  STORAGE UNIT {category.number}
                </span>

                <span>
                  <i aria-hidden="true"></i>

                  READY
                </span>
              </span>

              <span
                class="library-portal-card__visual"
                aria-hidden="true"
              >
                <span class="library-portal-card__orbit library-portal-card__orbit--outer">
                </span>

                <span class="library-portal-card__orbit library-portal-card__orbit--inner">
                </span>

                <span class="library-portal-card__symbol">
                  {
                    category.key === "movies"
                      ? "▶"
                      : category.key === "games"
                        ? "+"
                        : "≋"
                  }
                </span>

                <small>
                  {category.shortTitle}
                </small>
              </span>

              <span class="library-portal-card__content">
                <small>
                  {category.secondaryLabel}
                </small>

                <strong>
                  {category.title}
                </strong>

                <span>
                  {category.description}
                </span>
              </span>

              <span class="library-portal-card__footer">
                <span>
                  <strong>
                    {String(category.totalCount).padStart(2, "0")}
                  </strong>

                  {category.countLabel}
                </span>

                <span>
                  SELECT →
                </span>
              </span>

              <span class="library-portal-card__selected">
                SELECTED
              </span>
            </button>
          ))
        }
      </div>

      <section class="library-open-panel">
        <div>
          <span>
            ACTIVE STORAGE UNIT
          </span>

          <strong id="library-active-title">
            {defaultCategory.title}
          </strong>
        </div>

        <p id="library-active-description">
          {defaultCategory.description}
        </p>

        <button
          id="library-open-collection"
          type="button"
        >
          <span id="library-open-label">
            {defaultCategory.actionLabel}
          </span>

          <span aria-hidden="true">
            →
          </span>
        </button>
      </section>
    </section>

    <!-- ==================================================
         COLLECTION VIEW
    =================================================== -->

    <section
      class="library-view library-view--collection"
      id="library-collection-view"
      hidden
    >
      <header class="library-collection-header">
        <button
          class="library-return-button"
          id="library-return-button"
          type="button"
        >
          ← ARCHIVE ENTRANCE
        </button>

        <div>
          <p>
            ACTIVE COLLECTION
          </p>

          <h1
            id="library-collection-title"
            tabindex="-1"
          >
            {defaultCategory.title}
          </h1>

          <span id="library-collection-description">
            {defaultCategory.description}
          </span>
        </div>

        <aside>
          <small>
            ARCHIVED ITEMS
          </small>

          <strong id="library-collection-count">
            {String(defaultCategory.totalCount).padStart(2, "0")}
          </strong>
        </aside>
      </header>

      <nav
        class="library-tabs"
        aria-label="Library categories"
        role="tablist"
      >
        {
          categorySummaries.map((category) => (
            <button
              class:list={[
                "library-tab",
                `library-tab--${category.key}`,
                category.key === defaultCategory.key && "is-active",
              ]}
              type="button"
              role="tab"
              data-library-tab={category.key}
              data-title={category.title}
              data-description={category.description}
              data-count={String(category.totalCount).padStart(2, "0")}
              aria-selected={
                category.key === defaultCategory.key ? "true" : "false"
              }
            >
              <span>
                {category.number}
              </span>

              <strong>
                {category.shortTitle}
              </strong>

              <small>
                {String(category.totalCount).padStart(2, "0")}
              </small>
            </button>
          ))
        }
      </nav>

      <div class="library-panel-stage">
        {
          categorySummaries.map((category) => (
            <section
              class:list={[
                "library-collection-panel",
                `library-collection-panel--${category.key}`,
              ]}
              data-library-panel={category.key}
              hidden={category.key !== defaultCategory.key}
            >
              <header class="library-filter-bar">
                <div>
                  <span>
                    COLLECTION FILTER
                  </span>

                  <strong>
                    {category.title}
                  </strong>
                </div>

                <div class="library-filter-list">
                  <button
                    class="library-filter is-active"
                    type="button"
                    data-library-filter="all"
                    aria-pressed="true"
                  >
                    ALL
                  </button>

                  <button
                    class="library-filter"
                    type="button"
                    data-library-filter="favourite"
                    aria-pressed="false"
                  >
                    FAVOURITES
                  </button>

                  <button
                    class="library-filter"
                    type="button"
                    data-library-filter="completed"
                    aria-pressed="false"
                  >
                    {category.completedFilterLabel}
                  </button>

                  <button
                    class="library-filter"
                    type="button"
                    data-library-filter="pending"
                    aria-pressed="false"
                  >
                    {category.pendingFilterLabel}
                  </button>
                </div>
              </header>

              <div class="library-card-scroll">
                <div class="library-media-grid">
                  {
                    category.entries.map((entry, index) => (
                      <article
                        class:list={[
                          "library-media-card",
                          `library-media-card--${entry.coverTone}`,
                        ]}
                        data-library-card
                        data-state={entry.state}
                        data-favourite={String(entry.favourite)}
                        style={`--card-delay: ${index * 70}ms;`}
                      >
                        <button
                          class="library-media-card__open"
                          type="button"
                          data-library-open-entry={entry.id}
                          data-entry-category={entry.category}
                          aria-label={`Open details for ${entry.title}`}
                        >
                        </button>

                        <div class="library-media-card__cover">
                          <span class="library-media-card__number">
                            {category.number}.
                            {String(index + 1).padStart(2, "0")}
                          </span>

                          <span class="library-media-card__code">
                            {entry.coverCode}
                          </span>

                          <span class="library-media-card__caption">
                            {entry.coverCaption}
                          </span>

                          <span class="library-media-card__scan">
                          </span>
                        </div>

                        <div class="library-media-card__body">
                          <div class="library-media-card__metadata">
                            <span>
                              {entry.mediaType}
                            </span>

                            <span>
                              {entry.year}
                            </span>
                          </div>

                          <h2>
                            {entry.title}
                          </h2>

                          <p class="library-media-card__creator">
                            {entry.creator}
                          </p>

                          <div class="library-media-card__badges">
                            <span
                              class:list={[
                                "library-entry-status",
                                `library-entry-status--${entry.state}`,
                              ]}
                            >
                              {entry.statusLabel}
                            </span>

                            {
                              entry.favourite && (
                                <span class="library-entry-favourite">
                                  ★ FAVOURITE
                                </span>
                              )
                            }
                          </div>

                          <p class="library-media-card__note">
                            “{entry.note}”
                          </p>

                          <footer class="library-media-card__footer">
                            <span>
                              {entry.shelf}
                            </span>

                            <strong>
                              {
                                entry.rating === null
                                  ? "UNRATED"
                                  : `${entry.rating}/10`
                              }
                            </strong>
                          </footer>
                        </div>

                        <span class="library-media-card__command">
                          OPEN FILE →
                        </span>
                      </article>
                    ))
                  }
                </div>

                <p
                  class="library-empty-state"
                  data-library-empty-state
                  hidden
                >
                  NO FILES MATCH THIS FILTER. THE ARCHIVE MAY BE
                  LYING.
                </p>
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ==================================================
         DETAIL DRAWER
    =================================================== -->

    <aside
      class="library-drawer"
      id="library-drawer"
      data-category="movies"
      aria-hidden="true"
      hidden
    >
      <button
        class="library-drawer__backdrop"
        id="library-drawer-backdrop"
        type="button"
        aria-label="Close library file"
      >
      </button>

      <section
        class="library-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="library-drawer-title"
      >
        <header class="library-drawer__header">
          <div>
            <span>
              PERSONAL MEDIA ARCHIVE
            </span>

            <strong id="library-drawer-title">
              FILE INSPECTION
            </strong>
          </div>

          <button
            id="library-drawer-close"
            type="button"
          >
            CLOSE ×
          </button>
        </header>

        <div class="library-drawer__records">
          {
            libraryEntries.map((entry) => (
              <article
                class:list={[
                  "library-detail-record",
                  `library-detail-record--${entry.coverTone}`,
                ]}
                data-library-detail-record={entry.id}
                hidden
              >
                <div class="library-detail-cover">
                  <span class="library-detail-cover__type">
                    {entry.mediaType}
                  </span>

                  <span class="library-detail-cover__orbit library-detail-cover__orbit--outer">
                  </span>

                  <span class="library-detail-cover__orbit library-detail-cover__orbit--inner">
                  </span>

                  <strong>
                    {entry.coverCode}
                  </strong>

                  <span class="library-detail-cover__caption">
                    {entry.coverCaption}
                  </span>

                  <span class="library-detail-cover__scan">
                  </span>
                </div>

                <header class="library-detail-record__heading">
                  <p>
                    ARCHIVE RECORD // {entry.year}
                  </p>

                  <h2>
                    {entry.title}
                  </h2>

                  <span>
                    {entry.creator}
                  </span>
                </header>

                <div class="library-detail-record__badges">
                  <span
                    class:list={[
                      "library-entry-status",
                      `library-entry-status--${entry.state}`,
                    ]}
                  >
                    {entry.statusLabel}
                  </span>

                  {
                    entry.favourite && (
                      <span class="library-entry-favourite">
                        ★ FAVOURITE FILE
                      </span>
                    )
                  }

                  <span class="library-detail-record__rating">
                    {
                      entry.rating === null
                        ? "UNRATED"
                        : `${entry.rating} / 10`
                    }
                  </span>
                </div>

                <blockquote>
                  “{entry.note}”
                </blockquote>

                <section class="library-detail-record__section">
                  <p>
                    ARCHIVE SUMMARY
                  </p>

                  <span>
                    {entry.synopsis}
                  </span>
                </section>

                <dl class="library-detail-record__facts">
                  {
                    entry.facts.map((fact) => (
                      <div>
                        <dt>
                          {fact.label}
                        </dt>

                        <dd>
                          {fact.value}
                        </dd>
                      </div>
                    ))
                  }
                </dl>

                <section class="library-detail-record__section">
                  <p>
                    CLASSIFICATION TAGS
                  </p>

                  <div class="library-detail-record__tags">
                    {
                      entry.tags.map((tag) => (
                        <span>
                          {tag}
                        </span>
                      ))
                    }
                  </div>
                </section>

                <footer class="library-detail-record__shelf">
                  <span>
                    CURRENT SHELF
                  </span>

                  <strong>
                    {entry.shelf}
                  </strong>
                </footer>
              </article>
            ))
          }
        </div>

        <footer class="library-drawer__footer">
          <i aria-hidden="true"></i>

          FILE OPEN // MEMORY ACCESS GRANTED
        </footer>
      </section>
    </aside>
  </div>
</InternalPageLayout>

<script>
  const validLibraryCategories = [
    "movies",
    "games",
    "music",
  ] as const;

  const validLibraryFilters = [
    "all",
    "favourite",
    "completed",
    "pending",
  ] as const;

  type LibraryCategory =
    (typeof validLibraryCategories)[number];

  type LibraryFilter =
    (typeof validLibraryFilters)[number];

  const portalButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-library-category]"
      )
    );

  const radarNodes =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-library-radar-node]"
      )
    );

  const categoryTabs =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-library-tab]"
      )
    );

  const categoryPanels =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-library-panel]"
      )
    );

  const entranceView =
    document.querySelector<HTMLElement>(
      "#library-entrance-view"
    );

  const collectionView =
    document.querySelector<HTMLElement>(
      "#library-collection-view"
    );

  const openCollectionButton =
    document.querySelector<HTMLButtonElement>(
      "#library-open-collection"
    );

  const returnButton =
    document.querySelector<HTMLButtonElement>(
      "#library-return-button"
    );

  const activeTitle =
    document.querySelector<HTMLElement>(
      "#library-active-title"
    );

  const activeDescription =
    document.querySelector<HTMLElement>(
      "#library-active-description"
    );

  const openLabel =
    document.querySelector<HTMLElement>(
      "#library-open-label"
    );

  const sidebarNumber =
    document.querySelector<HTMLElement>(
      "#library-sidebar-number"
    );

  const sidebarTitle =
    document.querySelector<HTMLElement>(
      "#library-sidebar-title"
    );

  const sidebarDescription =
    document.querySelector<HTMLElement>(
      "#library-sidebar-description"
    );

  const sidebarStatus =
    document.querySelector<HTMLElement>(
      "#library-sidebar-status"
    );

  const sidebarStatOneLabel =
    document.querySelector<HTMLElement>(
      "#library-sidebar-stat-one-label"
    );

  const sidebarStatOneValue =
    document.querySelector<HTMLElement>(
      "#library-sidebar-stat-one-value"
    );

  const sidebarStatTwoLabel =
    document.querySelector<HTMLElement>(
      "#library-sidebar-stat-two-label"
    );

  const sidebarStatTwoValue =
    document.querySelector<HTMLElement>(
      "#library-sidebar-stat-two-value"
    );

  const collectionTitle =
    document.querySelector<HTMLElement>(
      "#library-collection-title"
    );

  const collectionDescription =
    document.querySelector<HTMLElement>(
      "#library-collection-description"
    );

  const collectionCount =
    document.querySelector<HTMLElement>(
      "#library-collection-count"
    );

  const drawer =
    document.querySelector<HTMLElement>(
      "#library-drawer"
    );

  const drawerCloseButton =
    document.querySelector<HTMLButtonElement>(
      "#library-drawer-close"
    );

  const drawerBackdrop =
    document.querySelector<HTMLButtonElement>(
      "#library-drawer-backdrop"
    );

  const drawerRecords =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-library-detail-record]"
      )
    );

  let activeCategory: LibraryCategory =
    "movies";

  let lastFocusedElement:
    HTMLElement | null =
      null;

  function isLibraryCategory(
    value: string | undefined
  ): value is LibraryCategory {
    return validLibraryCategories.includes(
      value as LibraryCategory
    );
  }

  function isLibraryFilter(
    value: string | undefined
  ): value is LibraryFilter {
    return validLibraryFilters.includes(
      value as LibraryFilter
    );
  }

  function getPortal(
    category: LibraryCategory
  ): HTMLButtonElement | undefined {
    return portalButtons.find(
      (button) =>
        button.dataset.libraryCategory ===
        category
    );
  }

  function updateSidebar(
    portal: HTMLButtonElement
  ): void {
    const category =
      portal.dataset.libraryCategory;

    if (!isLibraryCategory(category)) {
      return;
    }

    activeCategory =
      category;

    portalButtons.forEach((button) => {
      const isSelected =
        button === portal;

      button.classList.toggle(
        "is-selected",
        isSelected
      );

      button.setAttribute(
        "aria-pressed",
        String(isSelected)
      );
    });

    radarNodes.forEach((node) => {
      node.classList.toggle(
        "is-active",
        node.dataset.libraryRadarNode ===
          category
      );
    });

    if (sidebarNumber) {
      sidebarNumber.textContent =
        portal.dataset.number ?? "00";
    }

    if (sidebarTitle) {
      sidebarTitle.textContent =
        portal.dataset.title ??
        "UNKNOWN ARCHIVE";
    }

    if (sidebarDescription) {
      sidebarDescription.textContent =
        portal.dataset.description ??
        "";
    }

    if (sidebarStatus) {
      sidebarStatus.textContent =
        portal.dataset.status ??
        "SIGNAL UNKNOWN";
    }

    if (sidebarStatOneLabel) {
      sidebarStatOneLabel.textContent =
        portal.dataset.firstLabel ??
        "FILES";
    }

    if (sidebarStatOneValue) {
      sidebarStatOneValue.textContent =
        portal.dataset.firstValue ??
        "000";
    }

    if (sidebarStatTwoLabel) {
      sidebarStatTwoLabel.textContent =
        portal.dataset.secondLabel ??
        "PENDING";
    }

    if (sidebarStatTwoValue) {
      sidebarStatTwoValue.textContent =
        portal.dataset.secondValue ??
        "000";
    }

    if (activeTitle) {
      activeTitle.textContent =
        portal.dataset.title ??
        "UNKNOWN ARCHIVE";
    }

    if (activeDescription) {
      activeDescription.textContent =
        portal.dataset.description ??
        "";
    }

    if (openLabel) {
      openLabel.textContent =
        portal.dataset.actionLabel ??
        "OPEN ARCHIVE";
    }
  }

  function resetPanelFilter(
    panel: HTMLElement
  ): void {
    const filters =
      Array.from(
        panel.querySelectorAll<HTMLButtonElement>(
          "[data-library-filter]"
        )
      );

    const cards =
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          "[data-library-card]"
        )
      );

    const emptyState =
      panel.querySelector<HTMLElement>(
        "[data-library-empty-state]"
      );

    filters.forEach((filter) => {
      const isAll =
        filter.dataset.libraryFilter ===
        "all";

      filter.classList.toggle(
        "is-active",
        isAll
      );

      filter.setAttribute(
        "aria-pressed",
        String(isAll)
      );
    });

    cards.forEach((card) => {
      card.hidden = false;
    });

    if (emptyState) {
      emptyState.hidden = true;
    }
  }

  function activateCategory(
    category: LibraryCategory
  ): void {
    activeCategory =
      category;

    const portal =
      getPortal(category);

    if (portal) {
      updateSidebar(portal);
    }

    categoryTabs.forEach((tab) => {
      const isActive =
        tab.dataset.libraryTab ===
        category;

      tab.classList.toggle(
        "is-active",
        isActive
      );

      tab.setAttribute(
        "aria-selected",
        String(isActive)
      );

      if (isActive) {
        if (collectionTitle) {
          collectionTitle.textContent =
            tab.dataset.title ??
            "UNKNOWN COLLECTION";
        }

        if (collectionDescription) {
          collectionDescription.textContent =
            tab.dataset.description ??
            "";
        }

        if (collectionCount) {
          collectionCount.textContent =
            tab.dataset.count ??
            "00";
        }
      }
    });

    categoryPanels.forEach((panel) => {
      const isActive =
        panel.dataset.libraryPanel ===
        category;

      panel.hidden =
        !isActive;

      if (isActive) {
        resetPanelFilter(panel);
      }
    });
  }

  function openCollection(): void {
    activateCategory(
      activeCategory
    );

    if (entranceView) {
      entranceView.hidden =
        true;
    }

    if (collectionView) {
      collectionView.hidden =
        false;
    }

    collectionTitle?.focus();
  }

  function returnToEntrance(): void {
    if (collectionView) {
      collectionView.hidden =
        true;
    }

    if (entranceView) {
      entranceView.hidden =
        false;
    }

    openCollectionButton?.focus();
  }

  function openDrawer(
    entryId: string,
    category: LibraryCategory,
    trigger: HTMLElement
  ): void {
    if (!drawer) {
      return;
    }

    const selectedRecord =
      drawerRecords.find(
        (record) =>
          record.dataset.libraryDetailRecord ===
          entryId
      );

    if (!selectedRecord) {
      return;
    }

    lastFocusedElement =
      trigger;

    drawerRecords.forEach((record) => {
      record.hidden =
        record !== selectedRecord;
    });

    drawer.dataset.category =
      category;

    drawer.hidden =
      false;

    drawer.setAttribute(
      "aria-hidden",
      "false"
    );

    document.body.classList.add(
      "library-drawer-open"
    );

    window.requestAnimationFrame(() => {
      drawer.classList.add(
        "is-open"
      );

      drawerCloseButton?.focus();
    });
  }

  function closeDrawer(): void {
    if (!drawer) {
      return;
    }

    drawer.classList.remove(
      "is-open"
    );

    drawer.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.classList.remove(
      "library-drawer-open"
    );

    window.setTimeout(() => {
      if (
        drawer.classList.contains(
          "is-open"
        )
      ) {
        return;
      }

      drawer.hidden =
        true;

      drawerRecords.forEach((record) => {
        record.hidden =
          true;
      });

      lastFocusedElement?.focus();

      lastFocusedElement =
        null;
    }, 260);
  }

  portalButtons.forEach((portal) => {
    portal.addEventListener(
      "click",
      () => {
        updateSidebar(portal);
      }
    );
  });

  openCollectionButton?.addEventListener(
    "click",
    openCollection
  );

  returnButton?.addEventListener(
    "click",
    returnToEntrance
  );

  categoryTabs.forEach((tab) => {
    tab.addEventListener(
      "click",
      () => {
        const category =
          tab.dataset.libraryTab;

        if (!isLibraryCategory(category)) {
          return;
        }

        activateCategory(category);
      }
    );
  });

  document
    .querySelectorAll<HTMLButtonElement>(
      "[data-library-filter]"
    )
    .forEach((filterButton) => {
      filterButton.addEventListener(
        "click",
        () => {
          const filter =
            filterButton.dataset.libraryFilter;

          if (!isLibraryFilter(filter)) {
            return;
          }

          const panel =
            filterButton.closest<HTMLElement>(
              "[data-library-panel]"
            );

          if (!panel) {
            return;
          }

          const panelFilters =
            Array.from(
              panel.querySelectorAll<HTMLButtonElement>(
                "[data-library-filter]"
              )
            );

          const cards =
            Array.from(
              panel.querySelectorAll<HTMLElement>(
                "[data-library-card]"
              )
            );

          const emptyState =
            panel.querySelector<HTMLElement>(
              "[data-library-empty-state]"
            );

          panelFilters.forEach((button) => {
            const isActive =
              button === filterButton;

            button.classList.toggle(
              "is-active",
              isActive
            );

            button.setAttribute(
              "aria-pressed",
              String(isActive)
            );
          });

          let visibleCards =
            0;

          cards.forEach((card) => {
            const isFavourite =
              card.dataset.favourite ===
              "true";

            const state =
              card.dataset.state;

            const shouldShow =
              filter === "all" ||
              (
                filter === "favourite" &&
                isFavourite
              ) ||
              (
                filter === "completed" &&
                state === "completed"
              ) ||
              (
                filter === "pending" &&
                state === "pending"
              );

            card.hidden =
              !shouldShow;

            if (shouldShow) {
              visibleCards +=
                1;
            }
          });

          if (emptyState) {
            emptyState.hidden =
              visibleCards > 0;
          }
        }
      );
    });

  document
    .querySelectorAll<HTMLButtonElement>(
      "[data-library-open-entry]"
    )
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const entryId =
            button.dataset.libraryOpenEntry;

          const category =
            button.dataset.entryCategory;

          if (
            !entryId ||
            !isLibraryCategory(category)
          ) {
            return;
          }

          openDrawer(
            entryId,
            category,
            button
          );
        }
      );
    });

  drawerCloseButton?.addEventListener(
    "click",
    closeDrawer
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer
  );

  document.addEventListener(
    "keydown",
    (event: KeyboardEvent) => {
      if (
        event.key === "Escape" &&
        drawer?.classList.contains(
          "is-open"
        )
      ) {
        closeDrawer();
      }
    }
  );
</script>