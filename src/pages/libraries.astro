<script>
  type LibraryFilter =
    | "all"
    | "favourites"
    | "completed"
    | "pending";


  interface MovieSearchResult {
    title: string;
    year: string;
    imdbId: string;
    type: string;
    poster: string | null;
  }


  interface MovieSearchResponse {
    success: boolean;
    message?: string;
    results?: MovieSearchResult[];
  }


  interface MovieDetails {
    title: string | null;
    year: string | null;
    released: string | null;
    runtime: string | null;
    genre: string | null;
    director: string | null;
    actors: string | null;
    plot: string | null;
    language: string | null;
    country: string | null;
    awards: string | null;
    poster: string | null;
    imdbRating: string | null;
    imdbId: string | null;
  }


  interface MovieDetailsResponse {
    success: boolean;
    message?: string;
    movie?: MovieDetails;
  }


  interface MusicSignal {
    id: string;
    title: string;
    artist: string;
    album: string | null;
    year: string | null;
    recordingId: string;
    releaseId: string | null;
    releaseGroupId: string | null;
    durationMs: number | null;
    cover: string | null;
    status: "saved" | "discover-later";
    favourite: boolean;
    myRating: number | null;
    shelf: string;
    tags: string[];
    note: string;
  }


  /* ======================================================
     ENTRANCE ROUTER
  ====================================================== */

  const routerNodes =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-router-node]"
      )
    );


  const routerPreviewNumber =
    document.querySelector<HTMLElement>(
      "#router-preview-number"
    );

  const routerPreviewSubtitle =
    document.querySelector<HTMLElement>(
      "#router-preview-subtitle"
    );

  const routerPreviewTitle =
    document.querySelector<HTMLElement>(
      "#router-preview-title"
    );

  const routerPreviewDescription =
    document.querySelector<HTMLElement>(
      "#router-preview-description"
    );

  const routerPreviewCount =
    document.querySelector<HTMLElement>(
      "#router-preview-count"
    );

  const routerPreviewUnit =
    document.querySelector<HTMLElement>(
      "#router-preview-unit"
    );


  function previewRouterNode(
    node:
      HTMLButtonElement
  ): void {
    routerNodes.forEach(
      (item) => {
        item.classList.toggle(
          "is-targeted",
          item === node
        );
      }
    );


    if (
      routerPreviewNumber
    ) {
      routerPreviewNumber.textContent =
        node.dataset
          .routerNumber ??
        "00";
    }


    if (
      routerPreviewSubtitle
    ) {
      routerPreviewSubtitle.textContent =
        node.dataset
          .routerSubtitle ??
        "STORAGE NODE";
    }


    if (
      routerPreviewTitle
    ) {
      routerPreviewTitle.textContent =
        node.dataset
          .routerTitle ??
        "ARCHIVE";
    }


    if (
      routerPreviewDescription
    ) {
      routerPreviewDescription.textContent =
        node.dataset
          .routerDescription ??
        "";
    }


    if (
      routerPreviewCount
    ) {
      routerPreviewCount.textContent =
        node.dataset
          .routerCount ??
        "0";
    }


    if (
      routerPreviewUnit
    ) {
      routerPreviewUnit.textContent =
        node.dataset
          .routerUnit ??
        "FILES";
    }
  }


  routerNodes.forEach(
    (node) => {
      node.addEventListener(
        "mouseenter",
        () => {
          previewRouterNode(
            node
          );
        }
      );


      node.addEventListener(
        "focus",
        () => {
          previewRouterNode(
            node
          );
        }
      );
    }
  );


  if (
    routerNodes[0]
  ) {
    previewRouterNode(
      routerNodes[0]
    );
  }


  /* ======================================================
     LIBRARY NAVIGATION
  ====================================================== */

  const entrance =
    document.querySelector<HTMLElement>(
      "#library-entrance"
    );


  const collection =
    document.querySelector<HTMLElement>(
      "#library-collection"
    );


  const returnButton =
    document.querySelector<HTMLButtonElement>(
      "#library-return-button"
    );


  const collectionTitle =
    document.querySelector<HTMLElement>(
      "#library-collection-title"
    );


  const collectionCounter =
    document.querySelector<HTMLElement>(
      "#library-collection-counter"
    );


  const collectionStatus =
    document.querySelector<HTMLElement>(
      "#library-collection-status"
    );


  const movieSearchTerminal =
    document.querySelector<HTMLElement>(
      "#movie-search-terminal"
    );


  const genericLibraryArea =
    document.querySelector<HTMLElement>(
      "#generic-library-area"
    );


  const musicBrowser =
    document.querySelector<HTMLElement>(
      "#music-browser"
    );


  const completedFilterLabel =
    document.querySelector<HTMLElement>(
      "#library-completed-filter-label"
    );


  const pendingFilterLabel =
    document.querySelector<HTMLElement>(
      "#library-pending-filter-label"
    );


  const openLibraryButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-open-library]"
      )
    );


  const categoryTabs =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-library-tab]"
      )
    );


  const filterButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-library-filter]"
      )
    );


  const mediaCards =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-library-entry]"
      )
    );


  const noResults =
    document.querySelector<HTMLElement>(
      "#library-no-results"
    );


  let activeCategory =
    "movies";


  let activeFilter:
    LibraryFilter =
    "all";


  function getCategoryTab(
    category:
      string
  ) {
    return categoryTabs.find(
      (tab) =>
        tab.dataset
          .libraryTab ===
        category
    );
  }


  function resetFilters():
    void {
    activeFilter =
      "all";


    filterButtons.forEach(
      (button) => {
        const active =
          button.dataset
            .libraryFilter ===
          "all";

        button.classList.toggle(
          "library-filter-button--active",
          active
        );
      }
    );
  }


  function updateCategory(
    category:
      string
  ): void {
    const tab =
      getCategoryTab(
        category
      );


    if (!tab) {
      return;
    }


    activeCategory =
      category;


    resetFilters();


    categoryTabs.forEach(
      (button) => {
        const active =
          button.dataset
            .libraryTab ===
          category;

        button.classList.toggle(
          "library-category-tab--active",
          active
        );
      }
    );


    if (
      collectionTitle
    ) {
      collectionTitle.textContent =
        tab.dataset
          .libraryTitle ??
        "ARCHIVE";
    }


    if (
      collectionStatus
    ) {
      collectionStatus.textContent =
        tab.dataset
          .libraryStatus ??
        "STABLE";
    }


    if (
      completedFilterLabel
    ) {
      completedFilterLabel.textContent =
        tab.dataset
          .libraryCompletedLabel ??
        "COMPLETED";
    }


    if (
      pendingFilterLabel
    ) {
      pendingFilterLabel.textContent =
        tab.dataset
          .libraryPendingLabel ??
        "PENDING";
    }


    const isMovies =
      category ===
      "movies";


    const isMusic =
      category ===
      "music";


    if (
      movieSearchTerminal
    ) {
      movieSearchTerminal.hidden =
        !isMovies;
    }


    if (
      genericLibraryArea
    ) {
      genericLibraryArea.hidden =
        isMusic;
    }


    if (
      musicBrowser
    ) {
      musicBrowser.hidden =
        !isMusic;
    }


    if (
      isMusic
    ) {
      showMusicArtistDirectory();

      if (
        collectionCounter
      ) {
        collectionCounter.textContent =
          `${String(
            musicSignals.length
          ).padStart(
            2,
            "0"
          )} SIGNALS DETECTED`;
      }

      return;
    }


    applyGenericFilter();
  }


