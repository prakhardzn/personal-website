  function applyGenericFilter():
    void {
    let visible =
      0;


    mediaCards.forEach(
      (card) => {
        const categoryMatch =
          card.dataset
            .libraryEntryCategory ===
          activeCategory;


        const state =
          card.dataset
            .libraryEntryState;


        const favourite =
          card.dataset
            .libraryEntryFavourite ===
          "true";


        let filterMatch =
          true;


        if (
          activeFilter ===
          "favourites"
        ) {
          filterMatch =
            favourite;
        }


        if (
          activeFilter ===
          "completed"
        ) {
          filterMatch =
            state ===
            "completed";
        }


        if (
          activeFilter ===
          "pending"
        ) {
          filterMatch =
            state ===
            "pending";
        }


        const show =
          categoryMatch &&
          filterMatch;


        card.hidden =
          !show;


        if (show) {
          visible += 1;
        }
      }
    );


    if (
      collectionCounter
    ) {
      collectionCounter.textContent =
        `${String(
          visible
        ).padStart(
          2,
          "0"
        )} FILES DETECTED`;
    }


    if (
      noResults
    ) {
      noResults.hidden =
        visible !== 0;
    }
  }


