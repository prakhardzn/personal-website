  async function loadMovieDetails(
    imdbId:
      string
  ): Promise<void> {
    if (
      movieSelection
    ) {
      movieSelection.hidden =
        false;
    }


    setMovieMessage(
      "Retrieving full record...",
      "loading"
    );


    try {
      const response =
        await fetch(
          `/api/omdb/details?id=${encodeURIComponent(
            imdbId
          )}`
        );


      const data =
        (
          await response.json()
        ) as
          MovieDetailsResponse;


      if (
        !response.ok ||
        !data.success ||
        !data.movie
      ) {
        throw new Error(
          data.message ??
          "Movie unavailable."
        );
      }


      const movie =
        data.movie;


      setMovieText(
        "#movie-detail-title",
        movie.title
      );

      setMovieText(
        "#movie-detail-year",
        movie.year
      );

      setMovieText(
        "#movie-detail-director",
        movie.director
      );

      setMovieText(
        "#movie-detail-runtime",
        movie.runtime
      );

      setMovieText(
        "#movie-detail-genre",
        movie.genre
      );

      setMovieText(
        "#movie-detail-rating",
        movie.imdbRating
          ? `${movie.imdbRating}/10`
          : null
      );

      setMovieText(
        "#movie-detail-released",
        movie.released
      );

      setMovieText(
        "#movie-detail-language",
        movie.language
      );

      setMovieText(
        "#movie-detail-country",
        movie.country
      );

      setMovieText(
        "#movie-detail-imdb-id",
        movie.imdbId
      );

      setMovieText(
        "#movie-detail-actors",
        movie.actors
      );

      setMovieText(
        "#movie-detail-plot",
        movie.plot
      );

      setMovieText(
        "#movie-detail-awards",
        movie.awards
      );


      if (
        moviePoster
      ) {
        moviePoster
          .replaceChildren();


        if (movie.poster) {
          const image =
            document.createElement(
              "img"
            );

          image.src =
            movie.poster;

          image.alt =
            `${movie.title ?? "Movie"} poster`;

          moviePoster.append(
            image
          );
        } else {
          const fallback =
            document.createElement(
              "span"
            );

          fallback.textContent =
            "NO POSTER";

          moviePoster.append(
            fallback
          );
        }
      }


      setMovieMessage(
        "External record loaded.",
        "success"
      );
    } catch (
      error
    ) {
      setMovieMessage(
        error instanceof Error
          ? error.message
          : "Search failed.",
        "error"
      );
    }
  }


  function createMovieResult(
    movie:
      MovieSearchResult
  ): HTMLElement {
    const result =
      document.createElement(
        "article"
      );


    result.className =
      "movie-result-card";


    const visual =
      document.createElement(
        "div"
      );


    visual.className =
      "movie-result-card__poster";


    if (movie.poster) {
      const image =
        document.createElement(
          "img"
        );

      image.src =
        movie.poster;

      image.alt =
        `${movie.title} poster`;

      visual.append(
        image
      );
    } else {
      const fallback =
        document.createElement(
          "span"
        );

      fallback.textContent =
        "NO POSTER";

      visual.append(
        fallback
      );
    }


    const copy =
      document.createElement(
        "div"
      );


    copy.className =
      "movie-result-card__copy";


    const eyebrow =
      document.createElement(
        "p"
      );

    eyebrow.textContent =
      `OMDb // ${movie.imdbId}`;


    const title =
      document.createElement(
        "h4"
      );

    title.textContent =
      movie.title;


    const meta =
      document.createElement(
        "span"
      );

    meta.textContent =
      `${movie.year} // ${movie.type.toUpperCase()}`;


    const button =
      document.createElement(
        "button"
      );

    button.type =
      "button";

    button.textContent =
      "OPEN RECORD →";


    button.addEventListener(
      "click",
      () => {
        void loadMovieDetails(
          movie.imdbId
        );
      }
    );


    copy.append(
      eyebrow,
      title,
      meta,
      button
    );


    result.append(
      visual,
      copy
    );


    return result;
  }


  movieSearchForm?.addEventListener(
    "submit",
    async (
      event
    ) => {
      event.preventDefault();


      const query =
        movieSearchInput
          ?.value
          .trim() ??
        "";


      if (
        query.length < 2
      ) {
        setMovieMessage(
          "Enter at least two characters.",
          "error"
        );

        return;
      }


      movieSearchResults
        ?.replaceChildren();


      if (
        movieSelection
      ) {
        movieSelection.hidden =
          true;
      }


      setMovieMessage(
        `Searching "${query}"...`,
        "loading"
      );


      if (
        movieSearchSubmit
      ) {
        movieSearchSubmit.disabled =
          true;

        movieSearchSubmit.textContent =
          "WORKING...";
      }


      try {
        const response =
          await fetch(
            `/api/omdb/search?q=${encodeURIComponent(
              query
            )}`
          );


        const data =
          (
            await response.json()
          ) as
            MovieSearchResponse;


        if (
          !response.ok ||
          !data.success
        ) {
          throw new Error(
            data.message ??
            "Search failed."
          );
        }


        const results =
          data.results ??
          [];


        results.forEach(
          (movie) => {
            movieSearchResults?.append(
              createMovieResult(
                movie
              )
            );
          }
        );


        setMovieMessage(
          `${results.length} records detected.`,
          "success"
        );
      } catch (
        error
      ) {
        setMovieMessage(
          error instanceof Error
            ? error.message
            : "Search failed.",
          "error"
        );
      } finally {
        if (
          movieSearchSubmit
        ) {
          movieSearchSubmit.disabled =
            false;

          movieSearchSubmit.textContent =
            "EXECUTE";
        }
      }
    }
  );


  movieSelectionClose?.addEventListener(
    "click",
    () => {
      if (
        movieSelection
      ) {
        movieSelection.hidden =
          true;
      }
    }
  );


  /* ======================================================
     ESC
  ====================================================== */

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !==
        "Escape"
      ) {
        return;
      }


      if (
        musicDetailLayer &&
        !musicDetailLayer.hidden
      ) {
        closeMusicDetail();

        return;
      }


      if (
        drawerLayer &&
        !drawerLayer.hidden
      ) {
        closeDrawer();

        return;
      }


      if (
        activeCategory ===
          "music" &&
        activeMusicArtist
      ) {
        showMusicArtistDirectory();
      }
    }
  );


  updateCategory(
    activeCategory
  );
</script>