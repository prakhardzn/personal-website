          if (!filter) {
            return;
          }


          activeFilter =
            filter;


          filterButtons.forEach(
            (item) => {
              item.classList.toggle(
                "library-filter-button--active",
                item === button
              );
            }
          );


          applyGenericFilter();
        }
      );
    }
  );


