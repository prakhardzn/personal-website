---
import { getCollection } from "astro:content";
import InternalPageLayout from "../layouts/InternalPageLayout.astro";
import "../styles/libraries.css";

/* =========================================================
   PORTAL 214 // THE LIBRARIES

   Design rule for this version:
   - The collection gets most of the screen.
   - The left side uses an Astro-Pedia-like reference-terminal composition.
   - Movies / Games / Music stay on the same page.
   - The right side behaves like browsable shelves, not a dashboard.
========================================================= */

const movieEntries = (await getCollection("movies")).filter(
  (entry) => !(entry.data as Record<string, unknown>).draft
);

const musicEntries = (await getCollection("music")).filter(
  (entry) => !(entry.data as Record<string, unknown>).draft
);

const asRecord = (value: unknown): Record<string, unknown> =>
  typeof value === "object" && value !== null
    ? (value as Record<string, unknown>)
    : {};

const readValue = (
  record: Record<string, unknown>,
  keys: string[]
): string => {
  for (const key of keys) {
    const value = record[key];

    if (typeof value === "string" && value.trim()) {
      return value.trim();
    }

    if (typeof value === "number" && Number.isFinite(value)) {
      return String(value);
    }
  }

  return "";
};

const humaniseId = (id: string): string =>
  id
    .replace(/\.(md|mdx)$/i, "")
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (character) => character.toUpperCase());

const movieRecords = movieEntries.map((entry, index) => {
  const data = asRecord(entry.data);

  return {
    number: String(index + 1).padStart(3, "0"),
    id: entry.id,
    title: readValue(data, ["title", "name"]) || humaniseId(entry.id),
    year: readValue(data, ["year", "releaseYear", "date"]),
    director: readValue(data, ["director", "creator"]),
    poster: readValue(data, ["poster", "posterUrl", "image", "cover"]),
    rating: readValue(data, ["rating", "score"]),
  };
});

const musicRecords = musicEntries.map((entry, index) => {
  const data = asRecord(entry.data);

  return {
    number: String(index + 1).padStart(3, "0"),
    id: entry.id,
    title: readValue(data, ["title", "name", "track"]) || humaniseId(entry.id),
    artist: readValue(data, ["artist", "creator", "author"]),
    year: readValue(data, ["year", "releaseYear", "date"]),
    cover: readValue(data, ["cover", "image", "artwork", "poster"]),
  };
});

const chunk = <T,>(items: T[], size: number): T[][] => {
  const groups: T[][] = [];

  for (let index = 0; index < items.length; index += size) {
    groups.push(items.slice(index, index + size));
  }

  return groups;
};

const movieShelves = chunk(movieRecords, 5);
const musicShelves = chunk(musicRecords, 6);

const movieCount = movieRecords.length;
const gameCount = 3;
const musicCount = musicRecords.length;
const omdbApiKey = import.meta.env.OMDB_API_KEY ?? "";

const shelfLetter = (index: number): string =>
  String.fromCharCode(65 + (index % 26));

const librarySpines = [
  62, 84, 48, 73, 91, 56, 78, 66, 88, 52,
  71, 96, 59, 81, 68, 90, 54, 76, 64, 86,
  50, 74, 93, 61, 80, 57, 89, 69, 83, 55,
];
---

<InternalPageLayout
  title="The Libraries | Portal 214"
  description="Portal 214's personal media library for movies, games and music."
  message="This archive is poorly organised, emotionally biased and somehow still operational."
  pageClass="libraries-page"
>
  <!-- =====================================================
       LEFT // LIBRARY REFERENCE TERMINAL
  ====================================================== -->

  <aside
    slot="sidebar"
    class="libraries-reference-column"
    aria-label="Portal 214 library reference terminal"
  >
    <figure class="libraries-terminal-card">
      <header class="libraries-terminal-card__header">
        <div>
          <span class="libraries-status-square" aria-hidden="true"></span>
          <strong>MEDIA REFERENCE // LIB-214</strong>
        </div>

        <span>SYS: ONLINE</span>
      </header>

      <div class="libraries-terminal-viewport">
        <div class="libraries-stack-visual">
          <span class="libraries-stack-coordinate libraries-stack-coordinate--top">STACK INDEX</span>
          <span class="libraries-stack-coordinate libraries-stack-coordinate--bottom">PORTAL 214</span>

          <div class="libraries-stack-grid" aria-hidden="true">
            {
              librarySpines.map((height, index) => (
                <i style={`--spine-height: ${height}%; --spine-index: ${index};`}></i>
              ))
            }
          </div>

          <div class="libraries-stack-scan" aria-hidden="true"></div>

          <button
            class="libraries-stack-node libraries-stack-node--movies is-active"
            type="button"
            data-library-map-node="movies"
            aria-label="Browse movie archive"
          >
            <span>01</span>
            <strong>MOVIES</strong>
          </button>

          <button
            class="libraries-stack-node libraries-stack-node--games"
            type="button"
            data-library-map-node="games"
            aria-label="Browse game archive"
          >
            <span>02</span>
            <strong>GAMES</strong>
          </button>

          <button
            class="libraries-stack-node libraries-stack-node--music"
            type="button"
            data-library-map-node="music"
            aria-label="Browse music archive"
          >
            <span>03</span>
            <strong>MUSIC</strong>
          </button>

          <div class="libraries-stack-core">
            <p>THE LIBRARIES<span class="libraries-terminal-caret" aria-hidden="true">_</span></p>

            <dl>
              <div><dt>MODE</dt><dd id="libraries-terminal-mode">BROWSE</dd></div>
              <div><dt>STACK</dt><dd id="libraries-terminal-stack">01</dd></div>
              <div><dt>SIGNAL</dt><dd>STABLE</dd></div>
            </dl>
          </div>
        </div>
      </div>

      <figcaption class="libraries-terminal-readout">
        <span>STACKS <strong>03</strong></span>
        <span>RECORDS <strong id="libraries-map-count">{String(movieCount).padStart(3, "0")}</strong></span>
        <span>MODE <strong id="libraries-terminal-readout-mode">MOVIES</strong></span>
        <span class="libraries-terminal-readout__status"><i aria-hidden="true"></i> ONLINE</span>
      </figcaption>
    </figure>

    <section class="libraries-reference-card">
      <p>REFERENCE TERMINAL</p>
      <h2 id="libraries-reference-title">Movie Archive</h2>
      <span id="libraries-reference-description">
        Browse moving images as poster-led catalogue records arranged across Portal 214's digital shelves.
      </span>

      <dl>
        <div><dt>ACTIVE STACK</dt><dd id="libraries-map-active">01 // MOVING IMAGES</dd></div>
        <div><dt>CATALOGUE</dt><dd>PORTAL 214</dd></div>
        <div>
          <dt>STATUS</dt>
          <dd class="libraries-reference-status"><i aria-hidden="true"></i> Indexed</dd>
        </div>
      </dl>
    </section>
  </aside>

  <!-- =====================================================
       RIGHT // BROWSABLE LIBRARY
  ====================================================== -->

  <main
    slot="content"
    class="libraries-catalogue"
    data-library-root
    data-omdb-key={omdbApiKey}
  >
    <header class="libraries-catalogue-bar">
      <div class="libraries-catalogue-bar__identity">
        <span>ACTIVE STACK // PORTAL 214</span>
        <h1 id="libraries-active-title">MOVIE STACKS</h1>
      </div>

      <div class="libraries-header-search" data-library-movie-tools>
        <form class="libraries-search-form" id="libraries-movie-search-form">
          <div class="libraries-search-input-shell">
            <span aria-hidden="true">&gt;</span>
            <input
              id="libraries-movie-query"
              name="query"
              type="search"
              placeholder="SEARCH THE CATALOGUE"
              autocomplete="off"
              spellcheck="false"
              aria-label="Search movie catalogue"
            />
          </div>
          <button type="submit">EXECUTE</button>
        </form>

        <p
          class="libraries-search-status"
          id="libraries-search-status"
          role="status"
          aria-live="polite"
        >
          <span aria-hidden="true"></span>
          {omdbApiKey ? "OMDb READY" : "KEY REQUIRED"}
        </p>
      </div>

      <div class="libraries-catalogue-bar__status">
        <span id="libraries-active-count">{String(movieCount).padStart(2, "0")} RECORDS</span>
        <span class="libraries-projector-light" aria-hidden="true"></span>
        <strong>ONLINE</strong>
      </div>
    </header>

    <nav class="libraries-tabs" aria-label="Library sections">
      <button class="libraries-tab is-active" type="button" data-library-tab="movies" aria-selected="true">
        <span>01</span><strong>MOVIES</strong>
      </button>
      <button class="libraries-tab" type="button" data-library-tab="games" aria-selected="false">
        <span>02</span><strong>GAMES</strong>
      </button>
      <button class="libraries-tab" type="button" data-library-tab="music" aria-selected="false">
        <span>03</span><strong>MUSIC</strong>
      </button>
    </nav>

    <div class="libraries-catalogue__scroll" id="libraries-archive-scroll">
      <!-- =================================================
           MOVIES
      ================================================== -->

      <section
        class="libraries-panel"
        data-library-panel="movies"
        aria-labelledby="libraries-active-title"
      >
        <section
          class="libraries-search-shelf"
          id="libraries-search-results"
          aria-label="Movie search results"
          hidden
        ></section>

        <section class="libraries-stacks" aria-label="Saved movie stacks">
          {
            movieShelves.length > 0 ? (
              movieShelves.map((shelf, shelfIndex) => (
                <section class="libraries-shelf">
                  <header class="libraries-shelf__header">
                    <div>
                      <span>STACK {shelfLetter(shelfIndex)}</span>
                      <strong>MOVING IMAGES</strong>
                    </div>

                    <span>
                      {String(shelfIndex * 5 + 1).padStart(3, "0")}—
                      {String(shelfIndex * 5 + shelf.length).padStart(3, "0")}
                    </span>
                  </header>

                  <div class="libraries-shelf__grid">
                    {shelf.map((movie) => (
                      <article class="libraries-media-item libraries-media-item--movie">
                        <div class="libraries-media-item__cover">
                          {movie.poster ? (
                            <img
                              src={movie.poster}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <div class="libraries-cover-fallback" aria-hidden="true">
                              <span>M-{movie.number}</span>
                              <strong>NO COVER</strong>
                            </div>
                          )}

                          <span class="libraries-media-item__catalogue-id">
                            M-{movie.number}
                          </span>

                          {movie.rating && (
                            <span class="libraries-media-item__score">
                              {movie.rating}
                            </span>
                          )}
                        </div>

                        <div class="libraries-media-item__label">
                          <h2>{movie.title}</h2>

                          <p>
                            {[movie.year, movie.director]
                              .filter(Boolean)
                              .join(" // ") || "CATALOGUE RECORD"}
                          </p>

                          <span>&gt; OPEN RECORD</span>
                        </div>
                      </article>
                    ))}
                  </div>

                  <div class="libraries-shelf__rail" aria-hidden="true">
                    <span>STACK {shelfLetter(shelfIndex)} // PORTAL 214</span>
                  </div>
                </section>
              ))
            ) : (
              <div class="libraries-empty-state">
                <strong>NO MOVIE RECORDS DETECTED</strong>
                <span>Add Markdown files inside src/content/movies.</span>
              </div>
            )
          }
        </section>
      </section>

      <!-- =================================================
           GAMES
      ================================================== -->

      <section class="libraries-panel" data-library-panel="games" hidden>
        <section class="libraries-stacks" aria-label="Game stacks">
          <section class="libraries-shelf">
            <header class="libraries-shelf__header">
              <div>
                <span>STACK A</span>
                <strong>PLAYABLE OBJECTS</strong>
              </div>

              <span>001—003</span>
            </header>

            <div class="libraries-shelf__grid libraries-shelf__grid--games">
              {Array.from({ length: 3 }).map((_, index) => (
                <article class="libraries-media-item libraries-media-item--game">
                  <div class="libraries-media-item__cover">
                    <div class="libraries-cover-fallback libraries-cover-fallback--game">
                      <span>G-{String(index + 1).padStart(3, "0")}</span>
                      <strong>GAME SLOT</strong>
                    </div>
                  </div>

                  <div class="libraries-media-item__label">
                    <h2>RECORD SLOT {String(index + 1).padStart(2, "0")}</h2>
                    <p>GAME ARCHIVE // INDEXED</p>
                    <span>&gt; AWAITING ENTRY</span>
                  </div>
                </article>
              ))}
            </div>

            <div class="libraries-shelf__rail" aria-hidden="true">
              <span>STACK A // PLAYABLE OBJECTS</span>
            </div>
          </section>
        </section>
      </section>

      <!-- =================================================
           MUSIC
      ================================================== -->

      <section class="libraries-panel" data-library-panel="music" hidden>
        <section class="libraries-stacks" aria-label="Music stacks">
          {
            musicShelves.length > 0 ? (
              musicShelves.map((shelf, shelfIndex) => (
                <section class="libraries-shelf libraries-shelf--music">
                  <header class="libraries-shelf__header">
                    <div>
                      <span>STACK {shelfLetter(shelfIndex)}</span>
                      <strong>AUDIO SIGNALS</strong>
                    </div>

                    <span>
                      {String(shelfIndex * 6 + 1).padStart(3, "0")}—
                      {String(shelfIndex * 6 + shelf.length).padStart(3, "0")}
                    </span>
                  </header>

                  <div class="libraries-shelf__grid libraries-shelf__grid--music">
                    {shelf.map((track) => (
                      <article class="libraries-media-item libraries-media-item--music">
                        <div class="libraries-media-item__cover">
                          {track.cover ? (
                            <img
                              src={track.cover}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <div class="libraries-cover-fallback libraries-cover-fallback--music">
                              <span>A-{track.number}</span>
                              <strong>♪</strong>
                            </div>
                          )}

                          <span class="libraries-media-item__catalogue-id">
                            A-{track.number}
                          </span>
                        </div>

                        <div class="libraries-media-item__label">
                          <h2>{track.title}</h2>
                          <p>
                            {[track.artist, track.year]
                              .filter(Boolean)
                              .join(" // ") || "AUDIO RECORD"}
                          </p>
                          <span>&gt; OPEN RECORD</span>
                        </div>
                      </article>
                    ))}
                  </div>

                  <div class="libraries-shelf__rail" aria-hidden="true">
                    <span>STACK {shelfLetter(shelfIndex)} // AUDIO SIGNALS</span>
                  </div>
                </section>
              ))
            ) : (
              <div class="libraries-empty-state">
                <strong>NO AUDIO RECORDS DETECTED</strong>
                <span>Add Markdown files inside src/content/music.</span>
              </div>
            )
          }
        </section>
      </section>
    </div>
  </main>
</InternalPageLayout>

<script>
  type LibraryTab = "movies" | "games" | "music";

  type LibraryRuntimeWindow = Window & {
    __portal214LibraryController?: AbortController;
  };

  type OmdbSearchItem = {
    Title?: string;
    Year?: string;
    imdbID?: string;
    Type?: string;
    Poster?: string;
  };

  type OmdbSearchResponse = {
    Search?: OmdbSearchItem[];
    Response?: string;
    Error?: string;
  };

  const libraryRuntimeWindow = window as LibraryRuntimeWindow;

  const libraryMeta: Record<
    LibraryTab,
    {
      title: string;
      activeStack: string;
      countSelector: string;
      fallbackCount: number;
      referenceTitle: string;
      referenceDescription: string;
      terminalMode: string;
      terminalStack: string;
      readoutMode: string;
    }
  > = {
    movies: {
      title: "MOVIE STACKS",
      activeStack: "01 // MOVING IMAGES",
      countSelector: '[data-library-panel="movies"] .libraries-media-item--movie',
      fallbackCount: 0,
      referenceTitle: "Movie Archive",
      referenceDescription: "Browse moving images as poster-led catalogue records arranged across Portal 214's digital shelves.",
      terminalMode: "BROWSE",
      terminalStack: "01",
      readoutMode: "MOVIES",
    },
    games: {
      title: "GAME STACKS",
      activeStack: "02 // PLAYABLE OBJECTS",
      countSelector: '[data-library-panel="games"] .libraries-media-item--game',
      fallbackCount: 3,
      referenceTitle: "Game Archive",
      referenceDescription: "Playable objects, box art and future game records live inside this stack of the catalogue.",
      terminalMode: "PLAY",
      terminalStack: "02",
      readoutMode: "GAMES",
    },
    music: {
      title: "AUDIO STACKS",
      activeStack: "03 // AUDIO SIGNALS",
      countSelector: '[data-library-panel="music"] .libraries-media-item--music',
      fallbackCount: 0,
      referenceTitle: "Audio Archive",
      referenceDescription: "Browse albums and audio signals through square-cover shelves connected to the same media catalogue.",
      terminalMode: "LISTEN",
      terminalStack: "03",
      readoutMode: "MUSIC",
    },
  };

  function initialiseLibrariesPage(): void {
    libraryRuntimeWindow.__portal214LibraryController?.abort();

    const root = document.querySelector<HTMLElement>(
      ".libraries-page [data-library-root]"
    );

    if (!root) {
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;
    libraryRuntimeWindow.__portal214LibraryController = controller;

    const tabButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-library-tab]")
    );

    const mapButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        ".libraries-page [data-library-map-node]"
      )
    );

    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-library-panel]")
    );

    const activeTitle = root.querySelector<HTMLElement>(
      "#libraries-active-title"
    );

    const activeCount = root.querySelector<HTMLElement>(
      "#libraries-active-count"
    );

    const mapActive = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-map-active"
    );

    const mapCount = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-map-count"
    );

    const referenceTitle = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-reference-title"
    );

    const referenceDescription = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-reference-description"
    );

    const terminalMode = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-terminal-mode"
    );

    const terminalStack = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-terminal-stack"
    );

    const terminalReadoutMode = document.querySelector<HTMLElement>(
      ".libraries-page #libraries-terminal-readout-mode"
    );


    const movieTools = root.querySelector<HTMLElement>(
      "[data-library-movie-tools]"
    );

    const scrollArea = root.querySelector<HTMLElement>(
      "#libraries-archive-scroll"
    );

    const countFor = (tab: LibraryTab): number => {
      const count = root.querySelectorAll(libraryMeta[tab].countSelector).length;
      return count || libraryMeta[tab].fallbackCount;
    };

    const activateTab = (tab: LibraryTab): void => {
      tabButtons.forEach((button) => {
        const active = button.dataset.libraryTab === tab;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-selected", String(active));
      });

      mapButtons.forEach((button) => {
        const active = button.dataset.libraryMapNode === tab;
        button.classList.toggle("is-active", active);
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.libraryPanel !== tab;
      });

      const count = countFor(tab);

      if (activeTitle) {
        activeTitle.textContent = libraryMeta[tab].title;
      }

      if (activeCount) {
        activeCount.textContent = `${String(count).padStart(2, "0")} RECORDS`;
      }

      if (mapActive) {
        mapActive.textContent = libraryMeta[tab].activeStack;
      }

      if (mapCount) {
        mapCount.textContent = String(count).padStart(3, "0");
      }

      if (referenceTitle) {
        referenceTitle.textContent = libraryMeta[tab].referenceTitle;
      }

      if (referenceDescription) {
        referenceDescription.textContent = libraryMeta[tab].referenceDescription;
      }

      if (terminalMode) {
        terminalMode.textContent = libraryMeta[tab].terminalMode;
      }

      if (terminalStack) {
        terminalStack.textContent = libraryMeta[tab].terminalStack;
      }

      if (terminalReadoutMode) {
        terminalReadoutMode.textContent = libraryMeta[tab].readoutMode;
      }


      if (movieTools) {
        movieTools.hidden = tab !== "movies";
      }

      if (scrollArea) {
        scrollArea.scrollTop = 0;
      }
    };

    const bindTabButton = (
      button: HTMLButtonElement,
      datasetKey: "libraryTab" | "libraryMapNode"
    ): void => {
      button.addEventListener(
        "click",
        () => {
          const tab = button.dataset[datasetKey] as LibraryTab | undefined;

          if (tab && tab in libraryMeta) {
            activateTab(tab);
          }
        },
        { signal }
      );
    };

    tabButtons.forEach((button) => bindTabButton(button, "libraryTab"));
    mapButtons.forEach((button) => bindTabButton(button, "libraryMapNode"));

    /* =====================================================
       OMDb SEARCH
    ====================================================== */

    const searchForm = root.querySelector<HTMLFormElement>(
      "#libraries-movie-search-form"
    );

    const searchInput = root.querySelector<HTMLInputElement>(
      "#libraries-movie-query"
    );

    const searchStatus = root.querySelector<HTMLElement>(
      "#libraries-search-status"
    );

    const searchResults = root.querySelector<HTMLElement>(
      "#libraries-search-results"
    );

    const omdbKey = root.dataset.omdbKey?.trim() ?? "";

    const setSearchStatus = (
      message: string,
      state: "idle" | "loading" | "success" | "error" = "idle"
    ): void => {
      if (!searchStatus) {
        return;
      }

      searchStatus.classList.remove(
        "is-loading",
        "is-success",
        "is-error"
      );

      if (state !== "idle") {
        searchStatus.classList.add(`is-${state}`);
      }

      const textNode = Array.from(searchStatus.childNodes).find(
        (node) => node.nodeType === Node.TEXT_NODE
      );

      if (textNode) {
        textNode.textContent = ` ${message}`;
      } else {
        searchStatus.append(document.createTextNode(` ${message}`));
      }
    };

    const makeSearchItem = (
      movie: OmdbSearchItem,
      index: number
    ): HTMLElement => {
      const article = document.createElement("article");
      article.className =
        "libraries-media-item libraries-media-item--movie libraries-media-item--search";

      const cover = document.createElement("div");
      cover.className = "libraries-media-item__cover";

      if (movie.Poster && movie.Poster !== "N/A") {
        const image = document.createElement("img");
        image.src = movie.Poster;
        image.alt = "";
        image.loading = "lazy";
        image.decoding = "async";
        cover.append(image);
      } else {
        const fallback = document.createElement("div");
        fallback.className = "libraries-cover-fallback";
        fallback.innerHTML = `<span>EXT-${String(index + 1).padStart(3, "0")}</span><strong>NO COVER</strong>`;
        cover.append(fallback);
      }

      const code = document.createElement("span");
      code.className = "libraries-media-item__catalogue-id";
      code.textContent = movie.imdbID || `OMDB-${String(index + 1).padStart(3, "0")}`;
      cover.append(code);

      const label = document.createElement("div");
      label.className = "libraries-media-item__label";

      const title = document.createElement("h2");
      title.textContent = movie.Title || "UNTITLED RECORD";

      const meta = document.createElement("p");
      meta.textContent = [movie.Year, movie.Type]
        .filter(Boolean)
        .join(" // ") || "EXTERNAL RECORD";

      const action = document.createElement("span");
      action.textContent = "> EXTERNAL RECORD";

      label.append(title, meta, action);
      article.append(cover, label);

      return article;
    };

    searchForm?.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        const query = searchInput?.value.trim() ?? "";

        if (!query) {
          setSearchStatus("ENTER A MOVIE TITLE", "error");
          searchInput?.focus();
          return;
        }

        if (!omdbKey) {
          setSearchStatus("OMDB_API_KEY IS MISSING FROM .ENV", "error");
          return;
        }

        if (!searchResults) {
          return;
        }

        setSearchStatus("QUERYING EXTERNAL CATALOGUE...", "loading");
        searchResults.hidden = true;
        searchResults.replaceChildren();

        try {
          const requestUrl = new URL("https://www.omdbapi.com/");
          requestUrl.searchParams.set("apikey", omdbKey);
          requestUrl.searchParams.set("s", query);
          requestUrl.searchParams.set("type", "movie");
          requestUrl.searchParams.set("r", "json");

          const response = await fetch(requestUrl, { signal });

          if (!response.ok) {
            throw new Error(`OMDb returned HTTP ${response.status}.`);
          }

          const data = (await response.json()) as OmdbSearchResponse;

          if (data.Response === "False" || !data.Search?.length) {
            setSearchStatus(
              data.Error || "NO MATCHING RECORDS FOUND",
              "error"
            );
            return;
          }

          const heading = document.createElement("header");
          heading.className = "libraries-shelf__header";
          heading.innerHTML = `
            <div><span>EXTERNAL STACK</span><strong>SEARCH RESULTS</strong></div>
            <span>${String(Math.min(data.Search.length, 5)).padStart(2, "0")} RECORDS</span>
          `;

          const grid = document.createElement("div");
          grid.className = "libraries-shelf__grid";

          data.Search.slice(0, 5).forEach((movie, index) => {
            grid.append(makeSearchItem(movie, index));
          });

          const rail = document.createElement("div");
          rail.className = "libraries-shelf__rail";
          rail.innerHTML = "<span>EXTERNAL STACK // OMDb</span>";

          searchResults.append(heading, grid, rail);
          searchResults.hidden = false;

          setSearchStatus(
            `${Math.min(data.Search.length, 5)} RECORDS RECEIVED`,
            "success"
          );
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          console.error("OMDb search failed:", error);
          setSearchStatus("EXTERNAL CATALOGUE QUERY FAILED", "error");
        }
      },
      { signal }
    );

    activateTab("movies");
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseLibrariesPage,
      { once: true }
    );
  } else {
    initialiseLibrariesPage();
  }

  document.addEventListener("astro:page-load", initialiseLibrariesPage);
</script>
