---
import type {
  GetStaticPaths,
  MarkdownInstance,
} from "astro";

import InternalPageLayout from "../../layouts/InternalPageLayout.astro";

import {
  weeklyPosts,
  type WeeklyPost,
} from "../../data/weeklyposts";

import "../../styles/weekly.css";

type WeeklyPostFrontmatter = {
  number: string;
  slug: string;
  title: string;
  summary: string;
  category: string;
  date: string;
  readTime: string;
  status: string;
  statusTone?: string;
};

export const getStaticPaths: GetStaticPaths =
  () => {
    return weeklyPosts.map(
      (post) => ({
        params: {
          slug: post.slug,
        },
        props: {
          post,
        },
      })
    );
  };

interface Props {
  post: WeeklyPost;
}

const {
  post,
} = Astro.props as Props;

const weeklyMarkdownModules =
  import.meta.glob<
    MarkdownInstance<WeeklyPostFrontmatter>
  >(
    "../../content/weekly/*.md",
    {
      eager: true,
    }
  );

const weeklyMarkdownPosts =
  Object.values(
    weeklyMarkdownModules
  );

const markdownEntry =
  weeklyMarkdownPosts.find(
    (entry) =>
      entry.frontmatter.slug ===
      post.slug
  );

if (!markdownEntry) {
  throw new Error(
    `No Weekly Markdown file was found for slug "${post.slug}".`
  );
}

const compiledArticle =
  await markdownEntry.compiledContent();

const articleBody =
  compiledArticle.replace(
    /^\s*<h1(?:\s[^>]*)?>[\s\S]*?<\/h1>\s*/i,
    ""
  );

const markdownData =
  markdownEntry.frontmatter;

const number =
  markdownData.number ??
  post.number;

const title =
  markdownData.title ??
  post.title;

const summary =
  markdownData.summary ??
  post.summary;

const category =
  markdownData.category ??
  post.category;

const date =
  markdownData.date ??
  post.date;

const readTime =
  markdownData.readTime ??
  post.readTime;

const status =
  markdownData.status ??
  post.status;

const statusTone =
  markdownData.statusTone ??
  post.statusTone ??
  "new";

const baseUrl =
  import.meta.env.BASE_URL;

const buildSiteUrl = (
  path: string
): string => {
  return `${baseUrl}${path.replace(
    /^\/+/,
    ""
  )}`;
};
---

<InternalPageLayout
  title={`${title} | News Weekly`}
  description={summary}
  message="Transmission received. Opening weekly file."
  pageClass="weekly-page weekly-post-page"
>
  <div
    slot="sidebar"
    class="weekly-left-column"
  >
    <a
      class="weekly-post-back"
      href={buildSiteUrl("/weekly")}
    >
      BACK TO WEEKLY
    </a>

    <section class="weekly-post-meta">
      <header class="weekly-post-meta__header">
        FILE METADATA
      </header>

      <dl class="weekly-post-meta__list">
        <div>
          <dt>
            FILE
          </dt>

          <dd>
            {number}
          </dd>
        </div>

        <div>
          <dt>
            TYPE
          </dt>

          <dd>
            {category}
          </dd>
        </div>

        <div>
          <dt>
            DATE
          </dt>

          <dd>
            {date}
          </dd>
        </div>

        <div>
          <dt>
            LENGTH
          </dt>

          <dd>
            {readTime}
          </dd>
        </div>

        <div>
          <dt>
            STATUS
          </dt>

          <dd>
            <span
              class:list={[
                "weekly-status",
                `weekly-status--${statusTone}`,
              ]}
            >
              <span
                class="weekly-status__dot"
                aria-hidden="true"
              ></span>

              <strong>
                {status}
              </strong>
            </span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="weekly-post-signal">
      <div>
        <span
          class="weekly-signal-dot"
          aria-hidden="true"
        ></span>

        ARTICLE CHANNEL READY
      </div>

      <p>
        Markdown transmission successfully connected.
      </p>
    </section>
  </div>

  <div
    slot="content"
    class="weekly-right-column"
  >
    <div class="weekly-content-stage">
      <article class="weekly-feed-panel weekly-article">
        <header class="weekly-article-header">
          <div class="weekly-article-meta">
            <span>
              {number}
            </span>

            <span>
              {date} // {readTime}
            </span>
          </div>

          <p class="weekly-article-kicker">
            {category}
          </p>

          <h1>
            {title}
          </h1>

          <p class="weekly-article-summary">
            {summary}
          </p>
        </header>

        <div
          class="weekly-article-body"
          set:html={articleBody}
        ></div>
      </article>
    </div>
  </div>
</InternalPageLayout>