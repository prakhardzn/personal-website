---
import type {
  GetStaticPaths
} from "astro";

import InternalPageLayout from "../../layouts/InternalPageLayout.astro";

import {
  projectFiles,
  type ProjectFile,
} from "../../data/projects";

import "../../styles/about.css";


export const getStaticPaths = (() => {
  return projectFiles.map(
    (project) => ({
      params: {
        slug: project.slug,
      },

      props: {
        project,
      },
    })
  );
}) satisfies GetStaticPaths;


interface Props {
  project: ProjectFile;
}


const {
  project,
} = Astro.props;


const projectStyle = `
  --project-accent: ${project.accent};
  --project-accent-soft: ${project.accentSoft};
`;
---

<InternalPageLayout
  title={`${project.title} | Project Files`}
  description={project.summary}
  message="Project file unlocked. Please avoid touching unidentified objects."
  pageClass="project-detail-page"
>
  <div
    slot="sidebar"
    class="project-detail-sidebar"
    style={projectStyle}
  >
    <p class="project-detail-sidebar__number">
      {project.fileNumber}
    </p>

    <h1>
      {project.title}
    </h1>

    <p class="project-detail-sidebar__category">
      {project.category}
    </p>

    <dl>
      <div>
        <dt>Year</dt>
        <dd>{project.year}</dd>
      </div>

      <div>
        <dt>Role</dt>
        <dd>{project.role}</dd>
      </div>

      <div>
        <dt>Status</dt>
        <dd>{project.status}</dd>
      </div>
    </dl>

    <a
      class="project-detail-back"
      href="/about#work"
    >
      ← Return to project files
    </a>
  </div>


  <article
    slot="content"
    class="project-detail-content"
    style={projectStyle}
  >
    <header>
      <p>
        {project.fileNumber} / {project.category}
      </p>

      <h1>
        {project.title}
      </h1>

      <span>
        {project.role} · {project.year}
      </span>
    </header>

    <section>
      <h2>
        Project Summary
      </h2>

      <p class="project-detail-lead">
        {project.introduction}
      </p>

      <p>
        {project.summary}
      </p>
    </section>

    <section>
      <h2>
        Responsibilities
      </h2>

      <ol class="project-responsibility-list">
        {
          project.responsibilities.map(
            (responsibility) => (
              <li>
                {responsibility}
              </li>
            )
          )
        }
      </ol>
    </section>

    <section class="project-detail-placeholder">
      <p>
        VISUAL MATERIAL PENDING
      </p>

      <h2>
        Images, process material and project documentation
        will be added here.
      </h2>
    </section>
  </article>
</InternalPageLayout>


<style>
  .project-detail-sidebar {
    display: flex;
    flex-direction: column;

    height: 100%;
    padding: clamp(18px, 1.5vw, 28px);

    border:
      1px solid
      var(--project-accent);

    border-radius: 12px;

    background:
      linear-gradient(
        145deg,
        var(--project-accent-soft),
        rgb(2 10 11 / 96%)
      );
  }


  .project-detail-sidebar__number,
  .project-detail-sidebar__category {
    margin: 0;

    color: var(--project-accent);

    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  .project-detail-sidebar h1 {
    margin: 18px 0 10px;

    color: var(--interface-white);

    font-family: var(--font-display);
    font-size: clamp(24px, 2.3vw, 44px);
    line-height: 1.1;
  }


  .project-detail-sidebar dl {
    display: grid;

    gap: 12px;

    margin: 30px 0;
  }


  .project-detail-sidebar dl div {
    padding-top: 10px;

    border-top:
      1px solid
      color-mix(
        in srgb,
        var(--project-accent) 30%,
        transparent
      );
  }


  .project-detail-sidebar dt {
    margin-bottom: 4px;

    color:
      rgb(243 255 245 / 45%);

    font-family: var(--font-display);
    font-size: 8px;
    text-transform: uppercase;
  }


  .project-detail-sidebar dd {
    margin: 0;

    color: var(--interface-white);

    font-size: 12px;
  }


  .project-detail-back {
    margin-top: auto;
    padding: 11px 12px;

    border:
      1px solid
      var(--project-accent);

    border-radius: 7px;

    color: var(--project-accent);

    font-family: var(--font-display);
    font-size: 8px;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }


  .project-detail-back:hover,
  .project-detail-back:focus-visible {
    background: var(--project-accent);
    color: #02080a;
  }


  .project-detail-content {
    height: 100%;
    padding: clamp(22px, 2vw, 38px);

    overflow-y: auto;

    border:
      1px solid
      var(--project-accent);

    border-radius: 12px;

    background:
      linear-gradient(
        180deg,
        var(--project-accent-soft),
        rgb(2 10 11 / 96%) 28%
      );
  }


  .project-detail-content header {
    padding-bottom: 24px;
    margin-bottom: 28px;

    border-bottom:
      1px solid
      color-mix(
        in srgb,
        var(--project-accent) 34%,
        transparent
      );
  }


  .project-detail-content header p {
    margin: 0 0 10px;

    color: var(--project-accent);

    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 0.12em;
  }


  .project-detail-content header h1 {
    margin: 0 0 10px;

    color: var(--interface-white);

    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 58px);
    line-height: 1.05;
  }


  .project-detail-content header span {
    color:
      rgb(243 255 245 / 50%);

    font-size: 11px;
  }


  .project-detail-content section {
    max-width: 900px;
    margin-bottom: 34px;
  }


  .project-detail-content section > h2 {
    margin: 0 0 14px;

    color: var(--project-accent);

    font-family: var(--font-display);
    font-size: clamp(15px, 1.2vw, 22px);
  }


  .project-detail-content section > p {
    color:
      rgb(243 255 245 / 68%);

    font-size: clamp(12px, 0.85vw, 15px);
    line-height: 1.8;
  }


  .project-detail-lead {
    color:
      var(--interface-white) !important;

    font-size:
      clamp(
        15px,
        1.15vw,
        20px
      ) !important;

    line-height: 1.7 !important;
  }


  .project-responsibility-list {
    display: grid;

    gap: 10px;

    padding: 0;
    margin: 0;

    list-style: none;
    counter-reset: project-list;
  }


  .project-responsibility-list li {
    position: relative;

    padding:
      13px 15px
      13px 52px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--project-accent) 28%,
        transparent
      );

    border-radius: 8px;

    background:
      rgb(2 11 11 / 70%);

    color:
      rgb(243 255 245 / 72%);

    font-size: 12px;
    line-height: 1.6;

    counter-increment: project-list;
  }


  .project-responsibility-list li::before {
    position: absolute;

    top: 50%;
    left: 15px;

    color: var(--project-accent);

    font-family: var(--font-display);
    font-size: 9px;

    content:
      counter(project-list, decimal-leading-zero);

    transform: translateY(-50%);
  }


  .project-detail-placeholder {
    display: grid;
    place-items: center;

    min-height: 260px;
    padding: 30px;

    border:
      1px dashed
      var(--project-accent);

    border-radius: 10px;

    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 12px,
        var(--project-accent-soft) 13px,
        var(--project-accent-soft) 14px
      );

    text-align: center;
  }


  .project-detail-placeholder p {
    margin: 0 !important;

    color:
      var(--project-accent) !important;

    font-family:
      var(--font-display);

    font-size: 8px !important;
    letter-spacing: 0.14em;
  }


  .project-detail-placeholder h2 {
    max-width: 560px;
    margin: 12px 0 0 !important;

    color:
      var(--interface-white) !important;

    line-height: 1.5;
  }
</style>