---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Reality P-01",
  description = "A strange little local reality, assembled by Prakhar.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#02080a"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="preload"
      as="image"
      href="/assets/cursor/alien-bored.png"
    />

    <link
      rel="preload"
      as="image"
      href="/assets/cursor/alien-happy.png"
    />

    <link
      rel="preload"
      as="image"
      href="/assets/cursor/alien-annoyed.png"
    />

    <title>{title}</title>

    <ClientRouter fallback="animate" />
  </head>

  <body>
    <slot />

    <!-- ==================================================
         PORTAL 214 // PERSISTENT AIRLOCK TRANSITION
    =================================================== -->

    <div
      class="site-airlock"
      id="site-airlock"
      aria-hidden="true"
      transition:persist="site-airlock"
    >
      <div class="site-airlock__backdrop"></div>

      <div class="site-airlock__warning site-airlock__warning--top">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="site-airlock__door site-airlock__door--left">
        <div class="site-airlock__door-frame">
          <span class="site-airlock__panel site-airlock__panel--a"></span>
          <span class="site-airlock__panel site-airlock__panel--b"></span>
          <span class="site-airlock__panel site-airlock__panel--c"></span>

          <span class="site-airlock__vent site-airlock__vent--one"></span>
          <span class="site-airlock__vent site-airlock__vent--two"></span>

          <span class="site-airlock__door-id">AIRLOCK // L-214</span>
          <span class="site-airlock__door-mark">P214</span>
        </div>
      </div>

      <div class="site-airlock__door site-airlock__door--right">
        <div class="site-airlock__door-frame">
          <span class="site-airlock__panel site-airlock__panel--a"></span>
          <span class="site-airlock__panel site-airlock__panel--b"></span>
          <span class="site-airlock__panel site-airlock__panel--c"></span>

          <span class="site-airlock__vent site-airlock__vent--one"></span>
          <span class="site-airlock__vent site-airlock__vent--two"></span>

          <span class="site-airlock__door-id">AIRLOCK // R-214</span>
          <span class="site-airlock__door-mark">P214</span>
        </div>
      </div>

      <div class="site-airlock__seam" aria-hidden="true">
        <span></span>
      </div>

      <div class="site-airlock__lock">
        <div class="site-airlock__lock-lights" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>

        <span class="site-airlock__eyebrow">PORTAL 214 // TRANSIT BAY</span>

        <strong
          class="site-airlock__destination"
          id="site-airlock-destination"
        >
          NAVIGATION BAY
        </strong>

        <span class="site-airlock__status">
          <i aria-hidden="true"></i>
          ACCESS GRANTED
        </span>
      </div>

      <div class="site-airlock__warning site-airlock__warning--bottom">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <!-- ==================================================
         PERSISTENT ALIEN EXPRESSION CURSOR
    =================================================== -->

    <div
      class="alien-cursor"
      id="alien-cursor"
      aria-hidden="true"
      transition:persist="alien-cursor"
    >
      <span class="alien-cursor__hotspot"></span>
      <span class="alien-cursor__orbit"></span>
      <span class="alien-cursor__beam"></span>
      <span class="alien-cursor__anger-mark"></span>

      <span class="alien-cursor__face-container">
        <img
          class="alien-cursor__face alien-cursor__face--bored"
          src="/assets/cursor/alien-bored.png"
          alt=""
          draggable="false"
        />

        <img
          class="alien-cursor__face alien-cursor__face--happy"
          src="/assets/cursor/alien-happy.png"
          alt=""
          draggable="false"
        />

        <img
          class="alien-cursor__face alien-cursor__face--annoyed"
          src="/assets/cursor/alien-annoyed.png"
          alt=""
          draggable="false"
        />
      </span>
    </div>

    <script>
      import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

      type GlobalWindow = Window & {
        __prakharGlobalUIBound?: boolean;
      };

      const globalWindow = window as GlobalWindow;

      if (!globalWindow.__prakharGlobalUIBound) {
        globalWindow.__prakharGlobalUIBound = true;

        const reducedMotionQuery = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        );

        const wait = (milliseconds: number): Promise<void> =>
          new Promise((resolve) => {
            window.setTimeout(resolve, milliseconds);
          });

        /* ==================================================
           PORTAL 214 // AIRLOCK PAGE TRANSITION
        ================================================== */

        let transitionInProgress = false;
        let airlockCleanupTimer: number | undefined;

        const destinationNameForPath = (pathname: string): string => {
          const cleanPath = pathname
            .replace(/\/+$/, "")
            .toLowerCase();

          if (cleanPath === "" || cleanPath === "/") {
            return "COMMAND DECK";
          }

          if (cleanPath.startsWith("/about")) {
            return "PERSONAL ARCHIVE";
          }

          if (cleanPath.startsWith("/weekly")) {
            return "TRANSMISSION ROOM";
          }

          if (cleanPath.startsWith("/astrology")) {
            return "CELESTIAL ARCHIVE";
          }

          if (cleanPath.startsWith("/libraries")) {
            return "MEDIA STORAGE";
          }

          if (cleanPath.startsWith("/work")) {
            return "PROJECT FILES";
          }

          return "NAVIGATION BAY";
        };

        const setAirlockDestination = (url: URL): void => {
          const destination = document.getElementById(
            "site-airlock-destination"
          );

          if (!destination) return;

          destination.textContent = destinationNameForPath(url.pathname);
        };

        const clearAirlockClasses = (): void => {
          document.documentElement.classList.remove(
            "site-airlock-closing",
            "site-airlock-opening",
            "site-airlock-sealed"
          );
        };

        const beginAirlockClose = (destinationUrl: URL): void => {
          if (reducedMotionQuery.matches) return;

          transitionInProgress = true;
          setAirlockDestination(destinationUrl);

          if (airlockCleanupTimer !== undefined) {
            window.clearTimeout(airlockCleanupTimer);
            airlockCleanupTimer = undefined;
          }

          document.documentElement.classList.remove(
            "site-airlock-opening",
            "site-airlock-sealed"
          );

          /*
           * Force a style flush so repeated navigations always restart
           * the door-closing transition cleanly.
           */
          void document.documentElement.offsetWidth;

          document.documentElement.classList.add(
            "site-airlock-closing"
          );

          window.setTimeout(() => {
            if (!transitionInProgress) return;

            document.documentElement.classList.add(
              "site-airlock-sealed"
            );
          }, 300);
        };

        const revealNewPage = (): void => {
          if (!transitionInProgress || reducedMotionQuery.matches) {
            clearAirlockClasses();
            transitionInProgress = false;
            return;
          }

          document.documentElement.classList.remove(
            "site-airlock-closing",
            "site-airlock-sealed"
          );

          document.documentElement.classList.add(
            "site-airlock-opening"
          );

          airlockCleanupTimer = window.setTimeout(() => {
            clearAirlockClasses();

            airlockCleanupTimer = undefined;
            transitionInProgress = false;
          }, 520);
        };

        document.addEventListener(
          "astro:before-preparation",
          (event: TransitionBeforePreparationEvent) => {
            const originalLoader = event.loader;

            beginAirlockClose(event.to);

            event.loader = async (): Promise<void> => {
              if (!reducedMotionQuery.matches) {
                /*
                 * Hold the outgoing page just long enough for the two
                 * airlock doors to meet before Astro swaps the document.
                 */
                await wait(340);
              }

              await originalLoader();
            };
          }
        );

        document.addEventListener(
          "astro:page-load",
          revealNewPage
        );

        /* ==================================================
           ALIEN CURSOR
        ================================================== */

        const finePointerQuery = window.matchMedia(
          "(hover: hover) and (pointer: fine)"
        );

        const touchPointerQuery = window.matchMedia(
          "(hover: none), (pointer: coarse)"
        );

        let targetX = -100;
        let targetY = -100;
        let currentX = -100;
        let currentY = -100;
        let cursorHasMoved = false;
        let cursorAnimationStarted = false;
        let touchCursorHideTimer: number | undefined;

        const cursorStateClasses = [
          "is-happy",
          "is-annoyed",
          "is-over-planet",
          "is-over-dock",
          "is-over-control",
          "is-over-interactive",
        ];

        const getAlienCursor = (): HTMLElement | null =>
          document.getElementById("alien-cursor");

        const clearCursorState = (
          alienCursor: HTMLElement
        ): void => {
          cursorStateClasses.forEach((className) => {
            alienCursor.classList.remove(className);
          });
        };

        const updateCursorExpression = (
          alienCursor: HTMLElement,
          target: EventTarget | null
        ): void => {
          clearCursorState(alienCursor);

          if (!(target instanceof Element)) return;

          if (
            target.closest(
              [
                ".planet-link",
                ".planet-artwork",
                ".planet-label",
                ".mobile-destination",
                ".mobile-destination__viewport",
                ".mobile-destination__planet",
              ].join(",")
            )
          ) {
            alienCursor.classList.add(
              "is-happy",
              "is-over-planet"
            );
            return;
          }

          if (
            target.closest(
              [
                "#pause-button",
                "#power-button",
                "#internal-back-button",
                "#internal-settings-button",
                ".icon-button",
                ".internal-icon-button",
                ".information-panel__close",
                ".settings-dialog__close",
              ].join(",")
            )
          ) {
            alienCursor.classList.add(
              "is-annoyed",
              "is-over-control"
            );
            return;
          }

          if (
            target.closest(
              [
                ".dock-card",
                ".dock-actions [data-panel]",
              ].join(",")
            )
          ) {
            alienCursor.classList.add(
              "is-happy",
              "is-over-dock"
            );
            return;
          }

          if (
            target.closest(
              [
                "a",
                "button",
                "input",
                "textarea",
                "select",
                "summary",
                "[role='button']",
                ".about-tab",
                ".weekly-card",
              ].join(",")
            )
          ) {
            alienCursor.classList.add(
              "is-happy",
              "is-over-interactive"
            );
          }
        };

        const updateCursorPosition = (): void => {
          const alienCursor = getAlienCursor();

          const cursorEnabled =
            finePointerQuery.matches ||
            touchPointerQuery.matches;

          if (alienCursor && cursorEnabled) {
            const easing = touchPointerQuery.matches ? 0.52 : 0.34;

            currentX += (targetX - currentX) * easing;
            currentY += (targetY - currentY) * easing;

            alienCursor.style.setProperty(
              "--cursor-x",
              `${currentX}px`
            );

            alienCursor.style.setProperty(
              "--cursor-y",
              `${currentY}px`
            );
          }

          window.requestAnimationFrame(updateCursorPosition);
        };

        const initialiseCursor = (): void => {
          const alienCursor = getAlienCursor();

          if (!alienCursor) return;

          if (finePointerQuery.matches) {
            document.documentElement.classList.add(
              "has-alien-cursor"
            );

            document.documentElement.classList.remove(
              "has-touch-alien-cursor"
            );
          } else if (touchPointerQuery.matches) {
            document.documentElement.classList.remove(
              "has-alien-cursor"
            );

            document.documentElement.classList.add(
              "has-touch-alien-cursor"
            );

            alienCursor.classList.remove("is-visible");
          } else {
            document.documentElement.classList.remove(
              "has-alien-cursor",
              "has-touch-alien-cursor"
            );

            alienCursor.classList.remove("is-visible");
            return;
          }

          if (!cursorAnimationStarted) {
            cursorAnimationStarted = true;
            window.requestAnimationFrame(updateCursorPosition);
          }
        };

        const positionTouchCursor = (
          event: PointerEvent,
          alienCursor: HTMLElement
        ): void => {
          if (touchCursorHideTimer !== undefined) {
            window.clearTimeout(touchCursorHideTimer);
            touchCursorHideTimer = undefined;
          }

          /*
           * Touchscreens do not have a true independent hover cursor.
           * The alien therefore appears just above the finger,
           * reacts to the touched control, and lingers briefly after
           * the finger is released.
           */
          targetX = Math.max(8, event.clientX - 24);
          targetY = Math.max(8, event.clientY - 82);

          if (!cursorHasMoved) {
            currentX = targetX;
            currentY = targetY;
            cursorHasMoved = true;
          }

          alienCursor.classList.add("is-visible");
          updateCursorExpression(alienCursor, event.target);
        };

        const scheduleTouchCursorHide = (): void => {
          if (!touchPointerQuery.matches) return;

          if (touchCursorHideTimer !== undefined) {
            window.clearTimeout(touchCursorHideTimer);
          }

          touchCursorHideTimer = window.setTimeout(() => {
            const alienCursor = getAlienCursor();

            if (!alienCursor) return;

            alienCursor.classList.remove(
              "is-visible",
              "is-clicking"
            );

            clearCursorState(alienCursor);
            touchCursorHideTimer = undefined;
          }, 620);
        };

        document.addEventListener(
          "pointermove",
          (event: PointerEvent) => {
            const alienCursor = getAlienCursor();

            if (!alienCursor) return;

            if (
              event.pointerType === "touch" &&
              touchPointerQuery.matches
            ) {
              positionTouchCursor(event, alienCursor);
              return;
            }

            if (!finePointerQuery.matches) return;

            targetX = event.clientX;
            targetY = event.clientY;

            if (!cursorHasMoved) {
              currentX = targetX;
              currentY = targetY;
              cursorHasMoved = true;
            }

            alienCursor.classList.add("is-visible");
            updateCursorExpression(alienCursor, event.target);
          }
        );

        document.addEventListener(
          "pointerdown",
          (event: PointerEvent) => {
            const alienCursor = getAlienCursor();

            if (!alienCursor) return;

            if (
              event.pointerType === "touch" &&
              touchPointerQuery.matches
            ) {
              positionTouchCursor(event, alienCursor);
            }

            alienCursor.classList.add("is-clicking");
          }
        );

        document.addEventListener(
          "pointerup",
          (event: PointerEvent) => {
            const alienCursor = getAlienCursor();

            if (!alienCursor) return;

            alienCursor.classList.remove("is-clicking");

            if (event.pointerType === "touch") {
              scheduleTouchCursorHide();
            }
          }
        );

        document.addEventListener(
          "pointercancel",
          (event: PointerEvent) => {
            const alienCursor = getAlienCursor();

            if (!alienCursor) return;

            alienCursor.classList.remove("is-clicking");

            if (event.pointerType === "touch") {
              scheduleTouchCursorHide();
            }
          }
        );

        document.addEventListener("mouseout", (event: MouseEvent) => {
          if (event.relatedTarget !== null) return;

          const alienCursor = getAlienCursor();
          if (!alienCursor) return;

          alienCursor.classList.remove("is-visible");
          clearCursorState(alienCursor);
        });

        window.addEventListener("blur", () => {
          const alienCursor = getAlienCursor();
          if (!alienCursor) return;

          alienCursor.classList.remove("is-visible");
          clearCursorState(alienCursor);
        });

        finePointerQuery.addEventListener(
          "change",
          initialiseCursor
        );

        touchPointerQuery.addEventListener(
          "change",
          initialiseCursor
        );

        /* ==================================================
           SINGLE GLOBAL NAVBAR TYPEWRITER
        ================================================== */

        const typewriterRuns = new WeakMap<Element, number>();

        const typeText = async (
          element: HTMLElement,
          fullText: string,
          speed: number
        ): Promise<void> => {
          const currentRun =
            (typewriterRuns.get(element) ?? 0) + 1;

          typewriterRuns.set(element, currentRun);

          element.classList.add("js-typewriter");
          element.textContent = "";
          element.setAttribute("aria-label", fullText);

          if (reducedMotionQuery.matches) {
            element.textContent = fullText;
            element.classList.remove("js-typewriter");
            return;
          }

          for (
            let index = 0;
            index < fullText.length;
            index += 1
          ) {
            if (typewriterRuns.get(element) !== currentRun) return;

            const character = fullText[index];
            element.textContent += character;

            let delay = speed;

            if (".!?".includes(character)) {
              delay = speed * 4.5;
            } else if (",:;".includes(character)) {
              delay = speed * 2.2;
            }

            await wait(delay);
          }

          if (typewriterRuns.get(element) === currentRun) {
            element.classList.remove("js-typewriter");
          }
        };

        const initialiseNavbarTypewriters = (): void => {
          const typewriterElements =
            document.querySelectorAll<HTMLElement>(
              "[data-typewriter]"
            );

          typewriterElements.forEach((element, index) => {
            if (element.dataset.typewriterStarted === "true") return;

            const fullText =
              element.dataset.typewriterText ||
              element.textContent?.replace(/\s+/g, " ").trim() ||
              "";

            if (!fullText) return;

            element.dataset.typewriterStarted = "true";
            element.dataset.typewriterText = fullText;

            window.setTimeout(() => {
              void typeText(element, fullText, 32);
            }, 160 + index * 50);
          });
        };

        const initialiseGlobalUI = (): void => {
          initialiseCursor();
          initialiseNavbarTypewriters();
        };

        initialiseGlobalUI();

        document.addEventListener(
          "astro:page-load",
          initialiseGlobalUI
        );
      }
    </script>
  </body>
</html>

<style is:global>
  /* =========================================================
     PORTAL 214 // SPACECRAFT AIRLOCK TRANSITION

     The page itself swaps only while the doors are sealed.
     The overlay is persistent, so it survives Astro's DOM swap.
  ========================================================= */

  .site-airlock {
    --airlock-green: #a8ff36;
    --airlock-cyan: #58dfff;
    --airlock-black: #010504;
    --airlock-metal: #07110d;
    --airlock-metal-2: #0a1711;
    --airlock-line: rgb(168 255 54 / 24%);

    position: fixed;
    inset: 0;
    z-index: 9998;

    overflow: hidden;
    pointer-events: none;
    visibility: hidden;

    font-family: "Space Mono", monospace;

    contain: layout paint;
  }

  html.site-airlock-closing .site-airlock,
  html.site-airlock-sealed .site-airlock,
  html.site-airlock-opening .site-airlock {
    visibility: visible;
  }

  .site-airlock__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;

    opacity: 0;

    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(88 223 255 / 7%),
        transparent 34%
      ),
      rgb(0 4 3 / 88%);

    backdrop-filter: blur(0);

    transition:
      opacity 180ms ease,
      backdrop-filter 220ms ease;
  }

  html.site-airlock-closing .site-airlock__backdrop,
  html.site-airlock-sealed .site-airlock__backdrop {
    opacity: 1;
    backdrop-filter: blur(2px);
  }

  html.site-airlock-opening .site-airlock__backdrop {
    animation:
      airlock-backdrop-release
      500ms
      ease
      both;
  }

  /* =========================================================
     HEAVY DOORS
  ========================================================= */

  .site-airlock__door {
    position: absolute;
    top: -2vh;
    bottom: -2vh;
    z-index: 3;

    width: 57vw;
    min-width: 520px;

    overflow: hidden;

    background:
      linear-gradient(
        90deg,
        rgb(168 255 54 / 4%),
        transparent 14%,
        transparent 86%,
        rgb(88 223 255 / 5%)
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 54px,
        rgb(168 255 54 / 5%) 55px 56px
      ),
      linear-gradient(
        180deg,
        #0b1712 0%,
        #06100c 48%,
        #08140f 100%
      );

    box-shadow:
      inset 0 0 0 2px rgb(168 255 54 / 15%),
      inset 0 0 60px rgb(0 0 0 / 60%),
      0 0 42px rgb(0 0 0 / 85%);

    will-change: transform;
  }

  .site-airlock__door--left {
    left: -3vw;

    clip-path:
      polygon(
        0 0,
        91% 0,
        100% 9%,
        94% 22%,
        100% 36%,
        96% 50%,
        100% 64%,
        94% 78%,
        100% 91%,
        91% 100%,
        0 100%
      );

    transform: translate3d(-105%, 0, 0);
  }

  .site-airlock__door--right {
    right: -3vw;

    clip-path:
      polygon(
        9% 0,
        100% 0,
        100% 100%,
        9% 100%,
        0 91%,
        6% 78%,
        0 64%,
        4% 50%,
        0 36%,
        6% 22%,
        0 9%
      );

    transform: translate3d(105%, 0, 0);
  }

  html.site-airlock-closing .site-airlock__door,
  html.site-airlock-sealed .site-airlock__door {
    transform: translate3d(0, 0, 0);

    transition:
      transform
      320ms
      cubic-bezier(0.72, 0, 0.2, 1);
  }

  html.site-airlock-opening .site-airlock__door--left {
    animation:
      airlock-left-open
      480ms
      cubic-bezier(0.2, 0.72, 0.18, 1)
      both;
  }

  html.site-airlock-opening .site-airlock__door--right {
    animation:
      airlock-right-open
      480ms
      cubic-bezier(0.2, 0.72, 0.18, 1)
      both;
  }

  .site-airlock__door-frame {
    position: absolute;
    inset: 3.5vh 3.5vw;

    border: 1px solid rgb(168 255 54 / 20%);

    background:
      linear-gradient(
        135deg,
        transparent 0 14%,
        rgb(168 255 54 / 4%) 14.5% 15.5%,
        transparent 16% 72%,
        rgb(88 223 255 / 4%) 72.5% 73.5%,
        transparent 74%
      );
  }

  .site-airlock__door-frame::before,
  .site-airlock__door-frame::after {
    position: absolute;
    content: "";
  }

  .site-airlock__door-frame::before {
    inset: 9% 7%;

    border:
      1px solid
      rgb(168 255 54 / 11%);

    clip-path:
      polygon(
        0 0,
        88% 0,
        100% 18%,
        100% 82%,
        88% 100%,
        0 100%,
        8% 82%,
        8% 18%
      );
  }

  .site-airlock__door-frame::after {
    top: 50%;
    right: 8%;
    left: 8%;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--airlock-line),
        transparent
      );
  }

  /* =========================================================
     DOOR PANEL DETAIL
  ========================================================= */

  .site-airlock__panel {
    position: absolute;

    border: 1px solid rgb(168 255 54 / 13%);

    background:
      linear-gradient(
        135deg,
        rgb(168 255 54 / 3%),
        transparent 42%
      );
  }

  .site-airlock__panel--a {
    top: 8%;
    left: 8%;

    width: 44%;
    height: 26%;

    clip-path:
      polygon(
        0 0,
        84% 0,
        100% 24%,
        90% 100%,
        0 100%
      );
  }

  .site-airlock__panel--b {
