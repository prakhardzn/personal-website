---
import BaseLayout from "./BaseLayout.astro";
import "../styles/internal-page.css";

interface Props {
  title: string;
  description?: string;
  message?: string;
  pageClass?: string;
}

const {
  title,
  description = "Explore Prakhar's personal creative universe.",
  message = "Signal received. Reality is loading.",
  pageClass = "",
} = Astro.props;

const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title={title}
  description={description}
>
  <div
    class:list={[
      "internal-page-shell",
      pageClass,
    ]}
  >
    <!-- ==================================================
         TOP SYSTEM BAR
    =================================================== -->

    <header class="internal-system-bar">
      <button
        class="internal-icon-button"
        id="internal-back-button"
        type="button"
        aria-label="Return to the previous page"
      >
        <span aria-hidden="true">
          ←
        </span>
      </button>


      <p
        class="internal-system-message"
        data-typewriter
      >
        {message}
      </p>


      <div class="internal-system-actions">
        <a
          class="internal-icon-button"
          id="internal-home-link"
          href={homeUrl}
          aria-label="Return to the homepage"
        >
          <span aria-hidden="true">
            ⌂
          </span>
        </a>

        <button
          class="internal-icon-button"
          id="internal-settings-button"
          type="button"
          aria-label="Open settings"
        >
          <span aria-hidden="true">
            ⚙
          </span>
        </button>
      </div>
    </header>


    <!-- ==================================================
         PAGE CONTENT
    =================================================== -->

    <main class="internal-page-grid">
      <aside class="internal-page-sidebar">
        <slot name="sidebar" />
      </aside>

      <section class="internal-page-content">
        <slot name="content" />
      </section>
    </main>


    <!-- ==================================================
         SETTINGS DIALOG
    =================================================== -->

    <dialog
      class="settings-dialog"
      id="internal-settings-dialog"
      aria-labelledby="settings-dialog-title"
    >
      <div class="settings-dialog__window">
        <header class="settings-dialog__header">
          <h2 id="settings-dialog-title">
            Settings
          </h2>

          <button
            class="settings-dialog__close"
            id="internal-settings-close"
            type="button"
            aria-label="Close settings"
          >
            ×
          </button>
        </header>

        <div class="settings-dialog__content">
          <p class="settings-dialog__warning">
            COMMAND UNAVAILABLE
          </p>

          <p>
            Oops, can’t do anything.
          </p>

          <p>
            The control panel appears to be from another
            dimension.
          </p>
        </div>
      </div>
    </dialog>
  </div>
</BaseLayout>


<script>
  const homeLink =
    document.querySelector<HTMLAnchorElement>(
      "#internal-home-link"
    );

  const backButton =
    document.querySelector<HTMLButtonElement>(
      "#internal-back-button"
    );

  const settingsButton =
    document.querySelector<HTMLButtonElement>(
      "#internal-settings-button"
    );

  const settingsDialog =
    document.querySelector<HTMLDialogElement>(
      "#internal-settings-dialog"
    );

  const settingsCloseButton =
    document.querySelector<HTMLButtonElement>(
      "#internal-settings-close"
    );


  backButton?.addEventListener(
    "click",
    () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }

      window.location.assign(
        homeLink?.href ?? "/"
      );
    }
  );


  settingsButton?.addEventListener(
    "click",
    () => {
      if (
        settingsDialog &&
        !settingsDialog.open
      ) {
        settingsDialog.showModal();
      }
    }
  );


  settingsCloseButton?.addEventListener(
    "click",
    () => {
      settingsDialog?.close();
    }
  );


  settingsDialog?.addEventListener(
    "click",
    (
      event: MouseEvent
    ) => {
      if (
        event.target === settingsDialog
      ) {
        settingsDialog.close();
      }
    }
  );
</script>