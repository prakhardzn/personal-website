---
import BaseLayout from "./BaseLayout.astro";
import "../styles/internal-page.css";

interface Props {
  title: string;
  description?: string;
  message?: string;
  pageClass?: string;
}

const {
  title,
  description = "Explore Prakhar's personal creative universe.",
  message = "Signal received. Reality is loading.",
  pageClass = "",
} = Astro.props;

const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title={title}
  description={description}
>
  <div class="internal-page-shell">
    <!-- ==================================================
         TOP SYSTEM BAR
    =================================================== -->

    <header class="internal-system-bar">
      <button
        class="internal-icon-button"
        id="internal-back-button"
        type="button"
        aria-label="Return to the previous page"
      >
        <span aria-hidden="true">
          ←
        </span>
      </button>

      <p
        class="internal-system-message"
        data-typewriter
      >
        {message}
      </p>

      <div class="internal-system-actions">
        <a
          class="internal-icon-button"
          id="internal-home-link"
          href={homeUrl}
          aria-label="Return to the homepage"
        >
          <span aria-hidden="true">
            ⌂
          </span>
        </a>

        <button
          class="internal-icon-button"
          id="internal-settings-button"
          type="button"
          aria-label="Open settings"
        >
          <span aria-hidden="true">
            ⚙
          </span>
        </button>
      </div>
    </header>

    <!-- ==================================================
         PAGE CONTENT
    =================================================== -->

    <main
      class:list={[
        "internal-page-grid",
        pageClass,
      ]}
    >
      <aside class="internal-page-sidebar">
        <slot name="sidebar" />
      </aside>

      <section class="internal-page-content">
        <slot name="content" />
      </section>
    </main>

    <!-- ==================================================
         SETTINGS DIALOG
    =================================================== -->

    <dialog
      class="settings-dialog"
      id="internal-settings-dialog"
      aria-labelledby="settings-dialog-title"
    >
      <div class="settings-dialog__window">
        <header class="settings-dialog__header">
          <h2 id="settings-dialog-title">
            Settings
          </h2>

          <button
            class="settings-dialog__close"
            id="internal-settings-close"
            type="button"
            aria-label="Close settings"
          >
            ×
          </button>
        </header>

        <div class="settings-dialog__content">
          <p class="settings-dialog__warning">
            COMMAND UNAVAILABLE
          </p>

          <p>
            Oops, can’t do anything.
          </p>

          <p>
            The control panel appears to be from another
            dimension.
          </p>
        </div>
      </div>
    </dialog>
  </div>
</BaseLayout>

<script>
  const initialiseInternalPageControls = (): void => {
    const backButton =
      document.querySelector<HTMLButtonElement>(
        "#internal-back-button"
      );

    const settingsButton =
      document.querySelector<HTMLButtonElement>(
        "#internal-settings-button"
      );

    const settingsClose =
      document.querySelector<HTMLButtonElement>(
        "#internal-settings-close"
      );

    const settingsDialog =
      document.querySelector<HTMLDialogElement>(
        "#internal-settings-dialog"
      );

    /* ==================================================
       BACK BUTTON
    =================================================== */

    if (
      backButton &&
      backButton.dataset.bound !== "true"
    ) {
      backButton.dataset.bound = "true";

      backButton.addEventListener(
        "click",
        () => {
          const fallbackHomeUrl =
            import.meta.env.BASE_URL;

          const referrer =
            document.referrer;

          /*
            If the visitor arrived from another page on
            this same website, normal browser Back is
            appropriate.
          */

          if (referrer) {
            try {
              const previousUrl =
                new URL(referrer);

              if (
                previousUrl.origin ===
                window.location.origin
              ) {
                window.history.back();
                return;
              }
            } catch {
              /*
                Ignore malformed referrer and use the
                homepage fallback below.
              */
            }
          }

          /*
            Direct visit, refreshed page, external source,
            or no usable history:
            safely return to homepage.
          */

          window.location.assign(
            fallbackHomeUrl
          );
        }
      );
    }

    /* ==================================================
       SETTINGS BUTTON
    =================================================== */

    if (
      settingsButton &&
      settingsButton.dataset.bound !== "true"
    ) {
      settingsButton.dataset.bound = "true";

      settingsButton.addEventListener(
        "click",
        () => {
          if (!settingsDialog) {
            return;
          }

          if (!settingsDialog.open) {
            settingsDialog.showModal();
          }
        }
      );
    }

    /* ==================================================
       SETTINGS CLOSE
    =================================================== */

    if (
      settingsClose &&
      settingsClose.dataset.bound !== "true"
    ) {
      settingsClose.dataset.bound = "true";

      settingsClose.addEventListener(
        "click",
        () => {
          settingsDialog?.close();
        }
      );
    }

    /* ==================================================
       CLICK OUTSIDE DIALOG TO CLOSE
    =================================================== */

    if (
      settingsDialog &&
      settingsDialog.dataset.bound !== "true"
    ) {
      settingsDialog.dataset.bound = "true";

      settingsDialog.addEventListener(
        "click",
        (event: MouseEvent) => {
          if (
            event.target ===
            settingsDialog
          ) {
            settingsDialog.close();
          }
        }
      );
    }
  };

  initialiseInternalPageControls();

  document.addEventListener(
    "astro:page-load",
    initialiseInternalPageControls
  );
</script>