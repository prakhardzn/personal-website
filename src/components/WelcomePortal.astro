---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/homepage.css";
import "../styles/homepage-mobile.css";
import "../styles/welcome-portal.css";

const baseUrl = import.meta.env.BASE_URL;

const buildSiteUrl = (path: string): string =>
  `${baseUrl}${path.replace(/^\/+/, "")}`;

const homeUrl = buildSiteUrl("");
const aboutUrl = buildSiteUrl("about/");
const weeklyUrl = buildSiteUrl("weekly/");
const astrologyUrl = buildSiteUrl("astrology/");
const librariesUrl = buildSiteUrl("libraries/");

const planetAsset = (folder: string, file: string): string =>
  buildSiteUrl(`assets/planets/${folder}/${file}`);

const aboutLayers = [
  ["about-planet-glow.webp", "about-planet-layer--glow"],
  ["about-planet-base.webp", "about-planet-layer--base"],
  ["about-planet-texture.webp", "about-planet-layer--texture"],
  ["about-planet-shadow.webp", "about-planet-layer--shadow"],
  ["about-planet-blink-overlay.webp", "about-planet-layer--blink"],
  ["about-planet-debris.webp", "about-planet-layer--debris"],
] as const;

const astrologyLayers = [
  ["astrology-planet-glow.webp", "astrology-planet-layer--glow"],
  ["astrology-planet-base.webp", "astrology-planet-layer--base"],
  ["astrology-planet-cloud-shimmer.webp", "astrology-planet-layer--clouds"],
  ["astrology-planet-gold-twinkle.webp", "astrology-planet-layer--gold"],
  ["astrology-planet-central-star.webp", "astrology-planet-layer--central-star"],
  ["astrology-planet-shadow.webp", "astrology-planet-layer--shadow"],
  ["astrology-planet-orbit.webp", "astrology-planet-layer--orbit"],
  ["astrology-planet-moon.webp", "astrology-planet-layer--moon"],
  ["astrology-planet-detached.webp", "astrology-planet-layer--detached"],
] as const;

const libraryLayers = [
  ["library-planet-halo.webp", "library-planet-layer--halo"],
  ["library-planet-base.webp", "library-planet-layer--base"],
  ["library-planet-metal-shimmer.webp", "library-planet-layer--metal"],
  ["library-planet-portal-spill.webp", "library-planet-layer--portal-spill"],
  ["library-planet-portal-energy.webp", "library-planet-layer--portal-energy"],
  ["library-planet-portal-core.webp", "library-planet-layer--portal-core"],
  ["library-planet-shadow.webp", "library-planet-layer--shadow"],
] as const;

const particleNumbers = Array.from(
  { length: 12 },
  (_, index) => index + 1
);

const welcomeStars = Array.from({ length: 34 }, (_, index) => ({
  index: index + 1,
  left: (index * 29 + 7) % 97,
  top: (index * 43 + 11) % 91,
  delay: ((index * 17) % 19) / 10,
  duration: 3.8 + ((index * 13) % 22) / 10,
  size: index % 8 === 0 ? 2 : 1,
}));

const welcomeSparks = Array.from({ length: 10 }, (_, index) => index + 1);
---

<BaseLayout
  title="Portal 214"
  description="A personal archive, signal log and creative index transmitted through Portal 214."
>

  <!--
    PORTAL 214 // ARRIVAL TERMINAL

    The inline preflight runs before the overlay markup is parsed so repeat
    visits in the same browser session do not briefly flash the intro.

    Add ?intro=1 to the homepage URL while developing to force the welcome
    sequence to appear again without clearing sessionStorage.
  -->
  <script is:inline>
    (() => {
      try {
        const params = new URLSearchParams(window.location.search);
        const forceIntro = params.get("intro") === "1";
        const alreadyEntered =
          window.sessionStorage.getItem("portal214-entered") === "true";

        document.documentElement.dataset.portalIntro =
          forceIntro || !alreadyEntered ? "show" : "skip";
      } catch {
        document.documentElement.dataset.portalIntro = "show";
      }
    })();
  </script>

  <section
    class="portal-welcome"
    id="portal-welcome"
    role="dialog"
    aria-modal="true"
    aria-labelledby="portal-welcome-title"
    aria-describedby="portal-welcome-description"
    data-welcome-state="boot"
  >
    <div class="portal-welcome__space" aria-hidden="true">
      <div class="portal-welcome__nebula portal-welcome__nebula--one"></div>
      <div class="portal-welcome__nebula portal-welcome__nebula--two"></div>

      <div class="portal-welcome__stars">
        {
          welcomeStars.map((star) => (
            <i
              class="portal-welcome__star"
              style={`--star-left:${star.left}%;--star-top:${star.top}%;--star-delay:${star.delay}s;--star-duration:${star.duration}s;--star-size:${star.size}px;`}
            ></i>
          ))
        }
      </div>
    </div>

    <div class="portal-welcome__scan-grid" aria-hidden="true"></div>
    <div class="portal-welcome__vignette" aria-hidden="true"></div>
    <div class="portal-welcome__transition-flash" aria-hidden="true"></div>

    <div class="portal-welcome__terminal" id="portal-welcome-terminal">
      <header class="portal-welcome__header">
        <div class="portal-welcome__brand">
          <span class="portal-welcome__live-dot" aria-hidden="true"></span>
          <strong>P214 // INTERDIMENSIONAL ARRIVAL TERMINAL</strong>
        </div>

        <div class="portal-welcome__header-status">
          <span>GATE // <b id="portal-gate-status">BOOTING</b></span>
          <span class="portal-welcome__signal-bars" aria-label="Signal strength">
            <i></i><i></i><i></i><i></i><i></i>
          </span>
        </div>
      </header>

      <button
        class="portal-welcome__skip"
        id="portal-welcome-skip"
        type="button"
      >
        SKIP CHECKPOINT →
      </button>

      <div class="portal-welcome__boot-log" aria-live="polite" aria-atomic="true">
        <span class="portal-welcome__boot-line portal-welcome__boot-line--1">
          &gt; POWERING GATE...
        </span>
        <span class="portal-welcome__boot-line portal-welcome__boot-line--2">
          &gt; LOCATING DIMENSION...
        </span>
        <span class="portal-welcome__boot-line portal-welcome__boot-line--3">
          &gt; DIMENSION FOUND. PROBABLY.
        </span>
      </div>

      <main class="portal-welcome__main">
        <aside class="portal-diagnostic portal-diagnostic--left" aria-hidden="true">
          <span>GATE CONDITION</span>
          <dl>
            <div><dt>POWER</dt><dd>[✓]</dd></div>
            <div><dt>REALITY</dt><dd>[✓]</dd></div>
            <div><dt>SAFETY</dt><dd>[?]</dd></div>
          </dl>
          <p>DO NOT KICK MACHINE</p>
        </aside>

        <div class="portal-gate-stage" id="portal-gate-stage">
          <div class="portal-gate__shadow" aria-hidden="true"></div>

          <div class="portal-gate" id="portal-gate" aria-hidden="true">
            <div class="portal-gate__antenna portal-gate__antenna--left">
              <i></i>
            </div>
            <div class="portal-gate__antenna portal-gate__antenna--right">
              <i></i>
            </div>

            <div class="portal-gate__cable portal-gate__cable--left"></div>
            <div class="portal-gate__cable portal-gate__cable--right"></div>

            <div class="portal-gate__housing">
              <span class="portal-gate__bolt portal-gate__bolt--one"></span>
              <span class="portal-gate__bolt portal-gate__bolt--two"></span>
              <span class="portal-gate__bolt portal-gate__bolt--three"></span>
              <span class="portal-gate__bolt portal-gate__bolt--four"></span>
              <span class="portal-gate__bolt portal-gate__bolt--five"></span>
              <span class="portal-gate__bolt portal-gate__bolt--six"></span>

              <div class="portal-gate__ring portal-gate__ring--outer">
                <span></span><span></span><span></span><span></span>
              </div>

              <div class="portal-gate__ring portal-gate__ring--middle">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
              </div>

              <div class="portal-gate__ring portal-gate__ring--inner"></div>
              <div class="portal-gate__scanner"></div>

              <div class="portal-gate__void">
                <div class="portal-gate__energy"></div>
                <div class="portal-gate__iris">
                  <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
                <div class="portal-gate__eye">
                  <span>214</span>
                </div>
              </div>

              <div class="portal-gate__warning-light portal-gate__warning-light--left"></div>
              <div class="portal-gate__warning-light portal-gate__warning-light--right"></div>
            </div>

            <div class="portal-gate__leg portal-gate__leg--left"></div>
            <div class="portal-gate__leg portal-gate__leg--right"></div>

            <div class="portal-gate__sticker portal-gate__sticker--one">
              P-214
            </div>
            <div class="portal-gate__sticker portal-gate__sticker--two">
              NO WARRANTY
            </div>

            <div class="portal-gate__sparks">
              {
                welcomeSparks.map((spark) => (
                  <i style={`--spark-index:${spark};`}></i>
                ))
              }
            </div>
          </div>

          <div class="portal-gate__caption">
            <span>GATE // 214</span>
            <span>CONDITION // QUESTIONABLE</span>
          </div>
        </div>

        <aside class="portal-diagnostic portal-diagnostic--right" aria-hidden="true">
          <span>ENTITY READOUT</span>
          <dl>
            <div><dt>SPECIES</dt><dd id="portal-readout-species">???</dd></div>
            <div><dt>ORIGIN</dt><dd id="portal-readout-origin">UNRESOLVED</dd></div>
            <div><dt>THREAT</dt><dd id="portal-readout-threat">PENDING</dd></div>
          </dl>
          <p>PROPERTY OF SOMEONE</p>
        </aside>
      </main>

      <section class="portal-welcome__identity">
        <p class="portal-welcome__eyebrow" id="portal-welcome-description">
          <span class="portal-welcome__eyebrow-dot" aria-hidden="true"></span>
          <span id="portal-entity-status">UNREGISTERED ENTITY DETECTED</span>
        </p>

        <h1 id="portal-welcome-title">
          <span>PORTAL</span>
          <strong>214</strong>
        </h1>

        <div class="portal-welcome__result" id="portal-welcome-result" aria-live="polite">
          <span id="portal-result-primary">ENTRY CLEARANCE REQUIRED</span>
          <strong id="portal-result-secondary">PLEASE REMAIN STILL. ACTUALLY NEVER MIND.</strong>
        </div>

        <div class="portal-welcome__actions" id="portal-welcome-actions">
          <button
            class="portal-welcome__enter"
            id="portal-welcome-enter"
            type="button"
            disabled
          >
            <span>&gt; BEGIN QUESTIONABLE SCAN</span>
            <i aria-hidden="true">▮</i>
          </button>

          <button
            class="portal-welcome__refuse"
            id="portal-welcome-refuse"
            type="button"
            disabled
          >
            ABSOLUTELY NOT
          </button>
        </div>
      </section>

      <section class="portal-welcome__scan-results" id="portal-scan-results" aria-live="polite">
        <div>
          <span>SPECIES</span>
          <strong id="portal-scan-species">.............. ???</strong>
        </div>
        <div>
          <span>ORIGIN</span>
          <strong id="portal-scan-origin">.............. UNKNOWN</strong>
        </div>
        <div>
          <span>BRAIN ACTIVITY</span>
          <strong id="portal-scan-brain">........ DETECTING</strong>
        </div>
        <div>
          <span>THREAT LEVEL</span>
          <strong id="portal-scan-threat">......... PENDING</strong>
        </div>
        <div>
          <span>COOLNESS</span>
          <strong id="portal-scan-coolness">............ CALCULATING</strong>
        </div>
      </section>

      <footer class="portal-welcome__footer">
        <span>NODE // 214</span>
        <span id="portal-welcome-footer-message">
          PLEASE DO NOT TOUCH THE MACHINE. IT IS VERY SENSITIVE.
        </span>
        <span>SIGNAL // <b id="portal-signal-value">84%</b></span>
      </footer>
    </div>
  </section>

  <script>
    type PortalRuntimeWindow = Window & {
      __portalWelcomeController?: AbortController;
      __portalWelcomeTimers?: number[];
    };

    const portalRuntimeWindow = window as PortalRuntimeWindow;

    const initialisePortalWelcome = (): void => {
      const welcome = document.querySelector<HTMLElement>("#portal-welcome");

      if (!welcome) {
        return;
      }

      portalRuntimeWindow.__portalWelcomeController?.abort();
      portalRuntimeWindow.__portalWelcomeTimers?.forEach((timer) => {
        window.clearTimeout(timer);
      });

      const shouldShow =
        document.documentElement.dataset.portalIntro === "show";

      if (!shouldShow) {
        welcome.hidden = true;
        return;
      }

      const controller = new AbortController();
      const { signal } = controller;
      const timers: number[] = [];

      portalRuntimeWindow.__portalWelcomeController = controller;
      portalRuntimeWindow.__portalWelcomeTimers = timers;

      const terminal = document.querySelector<HTMLElement>("#portal-welcome-terminal");
      const gateStage = document.querySelector<HTMLElement>("#portal-gate-stage");
      const gateStatus = document.querySelector<HTMLElement>("#portal-gate-status");
      const enterButton = document.querySelector<HTMLButtonElement>("#portal-welcome-enter");
      const refuseButton = document.querySelector<HTMLButtonElement>("#portal-welcome-refuse");
      const skipButton = document.querySelector<HTMLButtonElement>("#portal-welcome-skip");
      const entityStatus = document.querySelector<HTMLElement>("#portal-entity-status");
      const resultPrimary = document.querySelector<HTMLElement>("#portal-result-primary");
      const resultSecondary = document.querySelector<HTMLElement>("#portal-result-secondary");
      const footerMessage = document.querySelector<HTMLElement>("#portal-welcome-footer-message");
      const signalValue = document.querySelector<HTMLElement>("#portal-signal-value");
      const scanSpecies = document.querySelector<HTMLElement>("#portal-scan-species");
      const scanOrigin = document.querySelector<HTMLElement>("#portal-scan-origin");
      const scanBrain = document.querySelector<HTMLElement>("#portal-scan-brain");
      const scanThreat = document.querySelector<HTMLElement>("#portal-scan-threat");
      const scanCoolness = document.querySelector<HTMLElement>("#portal-scan-coolness");
      const readoutSpecies = document.querySelector<HTMLElement>("#portal-readout-species");
      const readoutOrigin = document.querySelector<HTMLElement>("#portal-readout-origin");
      const readoutThreat = document.querySelector<HTMLElement>("#portal-readout-threat");

      if (
        !terminal ||
        !gateStage ||
        !gateStatus ||
        !enterButton ||
        !refuseButton ||
        !skipButton
      ) {
        return;
      }

      welcome.hidden = false;
      document.body.classList.add("portal-intro-active");

      const queue = (callback: () => void, delay: number): void => {
        const timer = window.setTimeout(callback, delay);
        timers.push(timer);
      };

      const rememberEntry = (): void => {
        try {
          window.sessionStorage.setItem("portal214-entered", "true");
        } catch {
          // sessionStorage can be unavailable in strict browser modes.
        }
      };

      const dismissWelcome = (instant = false): void => {
        rememberEntry();
        document.body.classList.remove("portal-intro-active");
        document.documentElement.dataset.portalIntro = "skip";

        if (instant) {
          welcome.hidden = true;
          return;
        }

        welcome.classList.add("is-dismissing");
        queue(() => {
          welcome.hidden = true;
          welcome.classList.remove("is-dismissing");
        }, 720);
      };

      const setSignal = (value: number): void => {
        if (signalValue) {
          signalValue.textContent = `${value}%`;
        }
      };

      const bootMachine = (): void => {
        welcome.dataset.welcomeState = "boot";
        welcome.classList.add("is-active");

        queue(() => {
          gateStatus.textContent = "SEARCHING";
          setSignal(31);
        }, 360);

        queue(() => {
          gateStatus.textContent = "SYNCING";
          setSignal(63);
        }, 840);

        queue(() => {
          gateStatus.textContent = "ONLINE";
          setSignal(84);
          welcome.dataset.welcomeState = "ready";
          enterButton.disabled = false;
          refuseButton.disabled = false;
          enterButton.focus({ preventScroll: true });
        }, 1450);
      };

      let refusalCount = 0;
      let scanStarted = false;

      const startScan = (): void => {
        if (scanStarted) {
          return;
        }

        scanStarted = true;
        welcome.dataset.welcomeState = "scanning";
        welcome.classList.add("is-scanning");

        enterButton.disabled = true;
        refuseButton.disabled = true;
        skipButton.disabled = true;

        gateStatus.textContent = "SCANNING";

        if (entityStatus) {
          entityStatus.textContent = "ENTITY SCAN IN PROGRESS";
        }

        if (resultPrimary) {
          resultPrimary.textContent = "PLEASE REMAIN MOSTLY HUMAN";
        }

        if (resultSecondary) {
          resultSecondary.textContent = "THE MACHINE IS DOING ITS BEST.";
        }

        if (footerMessage) {
          footerMessage.textContent = "SCANNING. THIS IS PROBABLY FINE.";
        }

        queue(() => {
          setSignal(91);
          if (scanSpecies) scanSpecies.textContent = ".............. PROBABLY HUMAN";
          if (readoutSpecies) readoutSpecies.textContent = "PROBABLY HUMAN";
        }, 520);

        queue(() => {
          if (scanOrigin) scanOrigin.textContent = ".............. LOCAL REALITY";
          if (readoutOrigin) readoutOrigin.textContent = "LOCAL REALITY";
        }, 1050);

        queue(() => {
          if (scanBrain) scanBrain.textContent = "........ DETECTED";
          if (resultSecondary) resultSecondary.textContent = "BRAIN ACTIVITY FOUND. SURPRISING.";
        }, 1550);

        queue(() => {
          if (scanThreat) scanThreat.textContent = "......... EMBARRASSINGLY LOW";
          if (readoutThreat) readoutThreat.textContent = "VERY LOW";
        }, 2050);

        queue(() => {
          if (scanCoolness) scanCoolness.textContent = "............ INCONCLUSIVE";
          if (resultPrimary) resultPrimary.textContent = "COOLNESS TEST FAILED";
          if (resultSecondary) resultSecondary.textContent = "NOT YOUR FAULT. SENSOR IS CHEAP.";
        }, 2500);

        queue(() => {
          welcome.dataset.welcomeState = "error";
          welcome.classList.add("is-error");
          gateStatus.textContent = "ERROR";
          setSignal(12);

          if (entityStatus) {
            entityStatus.textContent = "ERROR 214 // PERSONALITY DATABASE CORRUPTED";
          }

          if (resultPrimary) {
            resultPrimary.textContent = "ACCESS DENIED";
          }

          if (resultSecondary) {
            resultSecondary.textContent = "SECURITY SYSTEM NOT FOUND.";
          }

          if (footerMessage) {
            footerMessage.textContent = "PLEASE PRETEND YOU DID NOT SEE THAT.";
          }
        }, 3050);

        queue(() => {
          welcome.classList.remove("is-error");
          welcome.dataset.welcomeState = "override";
          gateStatus.textContent = "OVERRIDE";
          setSignal(67);

          if (entityStatus) {
            entityStatus.textContent = "MANUAL OVERRIDE ACCEPTED";
          }

          if (resultPrimary) {
            resultPrimary.textContent = "IDENTITY VERIFIED";
          }

          if (resultSecondary) {
            resultSecondary.textContent = "ACTUALLY NO. OVERRIDE ACCEPTED ANYWAY.";
          }
        }, 3680);

        queue(() => {
          welcome.dataset.welcomeState = "granted";
          welcome.classList.add("is-granted");
          gateStatus.textContent = "OPEN";
          setSignal(100);

          if (entityStatus) {
            entityStatus.textContent = "ARCHIVE ACCESS GRANTED";
          }

          if (resultPrimary) {
            resultPrimary.textContent = "WELCOME, STRANGER.";
          }

          if (resultSecondary) {
            resultSecondary.textContent = "PLEASE KEEP ARMS INSIDE THE DIMENSION.";
          }

          if (footerMessage) {
            footerMessage.textContent = "GATE 214 OPENING // DO NOT PANIC.";
          }
        }, 4250);

        queue(() => {
          rememberEntry();
          welcome.dataset.welcomeState = "opening";
          welcome.classList.add("is-opening");
          gateStatus.textContent = "TRANSIT";
        }, 4780);

        queue(() => {
          dismissWelcome(false);
        }, 6400);
      };

      const handleRefusal = (): void => {
        refusalCount += 1;

        if (refusalCount === 1) {
          welcome.classList.add("is-refused");

          if (entityStatus) {
            entityStatus.textContent = "EXIT REQUEST RECEIVED";
          }

          if (resultPrimary) {
            resultPrimary.textContent = "REQUEST DENIED";
          }

          if (resultSecondary) {
            resultSecondary.textContent = "YOU ALREADY LOADED THE WEBSITE.";
          }

          if (footerMessage) {
            footerMessage.textContent = "AWKWARD.";
          }

          refuseButton.textContent = "FINE. SCAN ME.";
          enterButton.querySelector("span")!.textContent = "> STILL BEGIN SCAN";
          return;
        }

        startScan();
      };

      const handlePointerMove = (event: PointerEvent): void => {
        if (
          scanStarted ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          return;
        }

        const bounds = gateStage.getBoundingClientRect();
        const localX = (event.clientX - bounds.left) / Math.max(1, bounds.width) - 0.5;
        const localY = (event.clientY - bounds.top) / Math.max(1, bounds.height) - 0.5;

        terminal.style.setProperty("--pointer-x", `${localX * 10}px`);
        terminal.style.setProperty("--pointer-y", `${localY * 8}px`);
        terminal.style.setProperty("--pointer-rotate-x", `${localY * -1.6}deg`);
        terminal.style.setProperty("--pointer-rotate-y", `${localX * 1.8}deg`);
      };

      enterButton.addEventListener("click", startScan, { signal });
      refuseButton.addEventListener("click", handleRefusal, { signal });
      skipButton.addEventListener("click", () => dismissWelcome(true), { signal });

      welcome.addEventListener("pointermove", handlePointerMove, {
        passive: true,
        signal,
      });

      window.addEventListener(
        "keydown",
        (event) => {
          if (welcome.hidden) {
            return;
          }

          if (event.key === "Enter" && !enterButton.disabled) {
            event.preventDefault();
            startScan();
          }

          if (event.key === "Escape" && !skipButton.disabled) {
            event.preventDefault();
            dismissWelcome(true);
          }
        },
        { signal }
      );

      bootMachine();
    };

    document.addEventListener("astro:page-load", initialisePortalWelcome);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialisePortalWelcome, {
        once: true,
      });
    } else {
      initialisePortalWelcome();
    }
  </script>

  <div class="site-shell" id="site-shell">
    <header class="system-bar">
      <div class="mobile-brand" aria-label="Portal 214">
        <span class="mobile-brand__signal" aria-hidden="true">◉</span>
        <span class="mobile-brand__name">PORTAL 214</span>
      </div>

      <button
        class="icon-button icon-button--back"
        type="button"
        disabled
        aria-label="Back button unavailable on the homepage"
      >
        <span aria-hidden="true">←</span>
        <span class="visually-hidden">Back</span>
      </button>

      <p class="system-message" data-typewriter>
        “Nothing is broken. It just works differently in this dimension.”
      </p>

      <div class="system-actions">
        <button
          class="icon-button icon-button--pause"
          id="pause-button"
          type="button"
          aria-label="Pause homepage animations"
          aria-pressed="false"
        >
          <span aria-hidden="true">Ⅱ</span>
          <span class="visually-hidden" id="pause-label">
            Pause animations
          </span>
        </button>

        <button
          class="icon-button icon-button--power"
          id="power-button"
          type="button"
          aria-label="Enter sleep mode"
          aria-pressed="false"
        >
          <span aria-hidden="true">⏻</span>
          <span class="visually-hidden" id="power-label">
            Enter sleep mode
          </span>
        </button>
      </div>
    </header>

    <div class="navigation-background-fade" aria-hidden="true"></div>

    <main class="planet-map">
      <h1 class="visually-hidden">Portal 214</h1>

      <!-- BACKGROUND SPACE TRAFFIC -->
