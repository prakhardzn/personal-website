<script>
  import { navigate } from "astro:transitions/client";

  /*
   * PLANET IMAGE SAFETY GUARD
   *
   * Layered planets use many transparent PNG files. If one optional PNG
   * is missing, Chromium normally paints a large broken-image rectangle
   * using the dimensions/transforms of that layer.
   *
   * Any failed planet image is hidden immediately. Valid images are left
   * completely untouched.
   */
  const initialisePlanetImageSafety = (): void => {
    const planetImages =
      document.querySelectorAll<HTMLImageElement>(
        ".planet-artwork img"
      );

    planetImages.forEach((image) => {
      const hideIfBroken = (): void => {
        if (image.complete && image.naturalWidth === 0) {
          image.style.setProperty("display", "none", "important");
          image.setAttribute("data-broken-planet-layer", "true");
        }
      };

      hideIfBroken();

      image.addEventListener(
        "error",
        () => {
          image.style.setProperty("display", "none", "important");
          image.setAttribute("data-broken-planet-layer", "true");
        },
        { once: true }
      );
    });
  };

  initialisePlanetImageSafety();

  document.addEventListener(
    "astro:page-load",
    initialisePlanetImageSafety
  );

  type PanelName =
    | "info"
    | "sitemap"
    | "credits"
    | "links";

  const panelTitles: Record<PanelName, string> = {
    info: "Info",
    sitemap: "Sitemap",
    credits: "Credits",
    links: "Links",
  };

  const wait = (duration: number): Promise<void> =>
    new Promise((resolve) => window.setTimeout(resolve, duration));

  const reducedMotionQuery = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  let timeInterval: number | undefined;
  let toastTimer: number | undefined;
  let panelAnimationSequence = 0;

  const formatCoordinate = (
    coordinate: number,
    positiveDirection: string,
    negativeDirection: string
  ): string =>
    `${Math.abs(coordinate).toFixed(4)}° ${
      coordinate >= 0 ? positiveDirection : negativeDirection
    }`;

  const updateVisitorTime = (): void => {
    const timeElement =
      document.querySelector<HTMLTimeElement>("#current-time");

    if (!timeElement) return;

    const now = new Date();

    timeElement.textContent = new Intl.DateTimeFormat(undefined, {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).format(now);

    timeElement.dateTime = now.toISOString();
  };

  const showVisitorLocation = (): void => {
    const coordinatesElement =
      document.querySelector<HTMLSpanElement>("#current-coordinates");
    const locationStatusElement =
      document.querySelector<HTMLParagraphElement>("#location-status");

    if (!coordinatesElement || !locationStatusElement) return;

    if (!("geolocation" in navigator)) {
      coordinatesElement.textContent = "UNAVAILABLE";
      locationStatusElement.textContent = "Geolocation is unavailable.";
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (position: GeolocationPosition) => {
        const latitude = formatCoordinate(
          position.coords.latitude,
          "N",
          "S"
        );
        const longitude = formatCoordinate(
          position.coords.longitude,
          "E",
          "W"
        );

        coordinatesElement.textContent = `${latitude}, ${longitude}`;
        locationStatusElement.textContent = "Location signal acquired.";
      },
      () => {
        coordinatesElement.textContent = "ACCESS UNAVAILABLE";
        locationStatusElement.textContent =
          "Location permission was unavailable.";
      },
      {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 300000,
      }
    );
  };

  const showSystemMessage = (message: string): void => {
    const systemToast =
      document.querySelector<HTMLDivElement>("#system-toast");

    if (!systemToast) return;

    if (toastTimer !== undefined) {
      window.clearTimeout(toastTimer);
    }

    systemToast.textContent = message;
    systemToast.hidden = false;

    toastTimer = window.setTimeout(() => {
      systemToast.hidden = true;
      systemToast.textContent = "";
      toastTimer = undefined;
    }, 3000);
  };

  const isPanelName = (
    value: string | undefined
  ): value is PanelName =>
    value === "info" ||
    value === "sitemap" ||
    value === "credits" ||
    value === "links";

  const restoreAnimatedLine = (line: HTMLElement): void => {
    line.textContent = line.dataset.panelOriginal ?? "";
    line.style.visibility = "visible";
    line.classList.remove("is-typing");
  };

  const cancelPanelAnimation = (): void => {
    panelAnimationSequence += 1;

    document
      .querySelectorAll<HTMLElement>("[data-panel-line]")
      .forEach(restoreAnimatedLine);
  };

  const preparePanelLines = (
    section: HTMLElement
  ): HTMLElement[] => {
    const lines = Array.from(
      section.querySelectorAll<HTMLElement>("[data-panel-line]")
    );

    lines.forEach((line) => {
      if (!line.dataset.panelOriginal) {
        line.dataset.panelOriginal =
          line.textContent?.replace(/\s+/g, " ").trim() ?? "";
      }

      line.textContent = "";
      line.style.visibility = "hidden";
      line.classList.remove("is-typing");
    });

    return lines;
  };

  const getTypingDelay = (character: string): number => {
    if (".!?".includes(character)) return 130;
    if (",:;".includes(character)) return 65;
    if (character === " ") return 10;
    return 28;
  };

  const typePanelLine = async (
    line: HTMLElement,
    sequence: number,
    informationPanel: HTMLDialogElement
  ): Promise<boolean> => {
    const originalText = line.dataset.panelOriginal ?? "";

    line.style.visibility = "visible";
    line.classList.add("is-typing");

    if (reducedMotionQuery.matches) {
      restoreAnimatedLine(line);
      return true;
    }

    for (let index = 0; index < originalText.length; index += 1) {
      if (
        sequence !== panelAnimationSequence ||
        !informationPanel.open
      ) {
        restoreAnimatedLine(line);
        return false;
      }

      line.textContent = originalText.slice(0, index + 1);
      await wait(getTypingDelay(originalText[index]));
    }

    line.classList.remove("is-typing");
    return true;
  };

  const animatePanelLines = async (
    sequence: number,
    lines: HTMLElement[],
    informationPanel: HTMLDialogElement
  ): Promise<void> => {
    await wait(120);

    if (
      sequence !== panelAnimationSequence ||
      !informationPanel.open
    ) {
      return;
    }

    for (const line of lines) {
      const finished = await typePanelLine(
        line,
        sequence,
        informationPanel
      );

      if (!finished) return;
      await wait(90);
    }
  };

  const initialisePlanetNavigation = (): void => {
    const shell = document.querySelector<HTMLElement>("#site-shell");

    if (!shell) return;

    const planetLinks =
      document.querySelectorAll<HTMLAnchorElement>(".planet-link");

    planetLinks.forEach((link) => {
      if (link.dataset.transitionBound === "true") return;
      link.dataset.transitionBound = "true";

      link.addEventListener("click", async (event: MouseEvent) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();

        if (shell.classList.contains("is-navigating")) return;

        shell.classList.add("is-navigating");
        link.classList.add("is-entering");

        if (reducedMotionQuery.matches) {
          navigate(link.href, {
            sourceElement: link,
            info: { curtainAlreadyClosed: true },
          });
          return;
        }

        await wait(300);
        document.documentElement.classList.add(
          "site-transition-closing"
        );

        await wait(220);
        navigate(link.href, {
          sourceElement: link,
          info: { curtainAlreadyClosed: true },
        });
      });
    });
  };

  const initialiseHomepage = (): void => {
    const shell = document.querySelector<HTMLElement>("#site-shell");

    if (!shell) return;

    updateVisitorTime();
    showVisitorLocation();
    initialisePlanetNavigation();

    if (timeInterval !== undefined) {
      window.clearInterval(timeInterval);
    }

    timeInterval = window.setInterval(updateVisitorTime, 30000);

    const pauseButton =
      document.querySelector<HTMLButtonElement>("#pause-button");
    const pauseLabel =
      document.querySelector<HTMLSpanElement>("#pause-label");
    const powerButton =
      document.querySelector<HTMLButtonElement>("#power-button");
    const powerLabel =
      document.querySelector<HTMLSpanElement>("#power-label");
    const informationPanel =
      document.querySelector<HTMLDialogElement>("#information-panel");
    const panelTitle =
      document.querySelector<HTMLHeadingElement>("#panel-title");
    const closeInformationButton =
      document.querySelector<HTMLButtonElement>(
        "#close-information-panel"
      );

    document
      .querySelectorAll<HTMLElement>("[data-panel-line]")
      .forEach((line) => {
        if (!line.dataset.panelOriginal) {
          line.dataset.panelOriginal =
            line.textContent?.replace(/\s+/g, " ").trim() ?? "";
        }
      });

    if (pauseButton && pauseButton.dataset.bound !== "true") {
      pauseButton.dataset.bound = "true";
      pauseButton.addEventListener("click", () => {
        const paused = document.body.classList.toggle(
          "animations-paused"
        );

        pauseButton.setAttribute("aria-pressed", String(paused));
        pauseButton.setAttribute(
          "aria-label",
          paused
            ? "Resume homepage animations"
            : "Pause homepage animations"
        );

        if (pauseLabel) {
          pauseLabel.textContent = paused
            ? "Resume animations"
            : "Pause animations";
        }

        showSystemMessage(
          paused
            ? "PLANETARY MOTION PAUSED"
            : "PLANETARY MOTION RESUMED"
        );
      });
    }

    if (powerButton && powerButton.dataset.bound !== "true") {
      powerButton.dataset.bound = "true";
      powerButton.addEventListener("click", () => {
        const sleeping = document.body.classList.toggle("sleep-mode");

        powerButton.setAttribute("aria-pressed", String(sleeping));
        powerButton.setAttribute(
          "aria-label",
          sleeping ? "Exit sleep mode" : "Enter sleep mode"
        );

        if (powerLabel) {
          powerLabel.textContent = sleeping
            ? "Exit sleep mode"
            : "Enter sleep mode";
        }

        showSystemMessage(
          sleeping
            ? "SYSTEM ENTERING SLEEP MODE"
            : "SYSTEM RESTORED"
        );
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-panel]")
      .forEach((button) => {
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";

        button.addEventListener("click", () => {
          const panelName = button.dataset.panel;

          if (
            !isPanelName(panelName) ||
            !informationPanel ||
            !panelTitle
          ) {
            return;
          }

          cancelPanelAnimation();
          panelTitle.textContent = panelTitles[panelName];

          const panelSections = Array.from(
            document.querySelectorAll<HTMLElement>(
              "[data-panel-content]"
            )
          );

          const activeSection = panelSections.find((section) => {
            const active = section.dataset.panelContent === panelName;
            section.hidden = !active;
            return active;
          });

          if (!activeSection) return;

          const activeLines = preparePanelLines(activeSection);

          if (!informationPanel.open) {
            informationPanel.showModal();
          }

          activeSection.classList.remove("is-panel-entering");
          void activeSection.offsetWidth;
          activeSection.classList.add("is-panel-entering");

          void animatePanelLines(
            panelAnimationSequence,
            activeLines,
            informationPanel
          );
        });
      });

    if (
      closeInformationButton &&
      closeInformationButton.dataset.bound !== "true"
    ) {
      closeInformationButton.dataset.bound = "true";
      closeInformationButton.addEventListener("click", () => {
        cancelPanelAnimation();
        informationPanel?.close();
      });
    }

    if (informationPanel && informationPanel.dataset.bound !== "true") {
      informationPanel.dataset.bound = "true";

      informationPanel.addEventListener("click", (event: MouseEvent) => {
        if (event.target === informationPanel) {
          cancelPanelAnimation();
          informationPanel.close();
        }
      });

      informationPanel.addEventListener("cancel", (event: Event) => {
        event.preventDefault();
        cancelPanelAnimation();
        informationPanel.close();
      });

      informationPanel.addEventListener("close", cancelPanelAnimation);
    }
  };

  initialiseHomepage();
  document.addEventListener("astro:page-load", initialiseHomepage);
</script>
