<aside
  class="navamsa-index"
  aria-labelledby="navamsa-index-title"
>
  <header class="navamsa-index__header">
    <p>
      DIVISIONAL INDEX
    </p>

    <h3 id="navamsa-index-title">
      Navamsa Placements
    </h3>

    <span>
      Each D9 position is derived from
      the exact sidereal longitude of
      the corresponding D1 position.
    </span>
  </header>

  <div
    class="navamsa-index__table-wrapper"
  >
    <table
      class="navamsa-index__table"
    >
      <thead>
        <tr>
          <th scope="col">
            BODY
          </th>

          <th scope="col">
            D9 SIGN
          </th>

          <th scope="col">
            HOUSE
          </th>

          <th scope="col">
            D9 DEGREE
          </th>

          <th scope="col">
            D1 SOURCE
          </th>
        </tr>
      </thead>

      <tbody
        data-d9-table-body
      ></tbody>
    </table>
  </div>

  <div
    class="navamsa-index__settings"
  >
    <div>
      <span>
        DIVISION
      </span>

      <strong>
        D9
      </strong>
    </div>

    <div>
      <span>
        SECTION
      </span>

      <strong>
        3°20′
      </strong>
    </div>

    <div>
      <span>
        HOUSES
      </span>

      <strong>
        WHOLE SIGN
      </strong>
    </div>

    <div>
      <span>
        SOURCE
      </span>

      <strong>
        D1 SIDEREAL
      </strong>
    </div>
  </div>

  <div
    class="navamsa-index__key"
  >
    <span>
      ASC = ASCENDANT
    </span>

    <span>
      R = RETROGRADE
    </span>

    <span>
      D1 = SOURCE POSITION
    </span>
  </div>
</aside>