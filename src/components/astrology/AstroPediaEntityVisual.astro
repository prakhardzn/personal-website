/* =========================================================
   NAKSHATRA SCHEMATIC
========================================================= */

const nakshatraSeed =
  index + 1;

const nakshatraPoints =
  Array.from(
    { length: 7 },
    (_, pointIndex) => {
      const angle =
        (
          pointIndex * 53 +
          nakshatraSeed * 17
        ) *
        (Math.PI / 180);

      const radius =
        42 +
        (
          (
            pointIndex * 29 +
            nakshatraSeed * 13
          ) %
          78
        );

      return {
        x:
          260 +
          Math.cos(angle) *
            radius,

        y:
          230 +
          Math.sin(angle) *
            radius,
      };
    }
  );

const nakshatraLines =
  nakshatraPoints
    .slice(1)
    .map(
      (
        point,
        pointIndex
      ) => ({
        x1:
          nakshatraPoints[
            pointIndex
          ].x,

        y1:
          nakshatraPoints[
            pointIndex
          ].y,

        x2:
          point.x,

        y2:
          point.y,
      })
    );

