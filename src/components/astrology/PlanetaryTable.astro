<aside
  class="planetary-index"
  aria-labelledby="planetary-index-title"
>
  <header class="planetary-index__header">
    <p>PLANETARY INDEX</p>

    <h3 id="planetary-index-title">
      Placements
    </h3>

    <span>
      Calculated sidereal planetary
      positions.
    </span>
  </header>

  <div class="planetary-index__table-wrapper">
    <table class="planetary-index__table">
      <thead>
        <tr>
          <th scope="col">BODY</th>
          <th scope="col">SIGN</th>
          <th scope="col">HOUSE</th>
          <th scope="col">DEGREE</th>
          <th scope="col">NAKSHATRA</th>
        </tr>
      </thead>

      <tbody
        data-planetary-table-body
      ></tbody>
    </table>
  </div>

  <div class="planetary-index__settings">
    <div>
      <span>ZODIAC</span>

      <strong data-result-zodiac>
        —
      </strong>
    </div>

    <div>
      <span>AYANAMSHA</span>

      <strong data-result-ayanamsha>
        —
      </strong>
    </div>

    <div>
      <span>NODES</span>

      <strong data-result-nodes>
        —
      </strong>
    </div>

    <div>
      <span>HOUSES</span>

      <strong data-result-houses>
        —
      </strong>
    </div>
  </div>

  <div class="planetary-index__key">
    <span>ASC = ASCENDANT</span>
    <span>R = RETROGRADE</span>
    <span>P = PADA</span>
  </div>
</aside>